---
import BaseLayout from '../layouts/BaseLayout.astro';
import GalleryCard from '../components/GalleryCard.astro';
import { getCollection } from 'astro:content';

const allGallery = await getCollection('gallery');
const sortedGallery = allGallery.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Gallery & Visual Encounters | Shlok Mehndiratta"
  description="A visual archive of lab artifacts, optical phenomena, geometry, and memorable physical encounters."
>
  <div class="space-y-10">
    <!-- Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded text-xs font-mono bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">
        <span>Visual Archive</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Gallery & Encounters
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
        A glimpse into the physical and experimental textures of my work: lab instrumentation, interference fringes, architectural geometry, and curiosities collected along the way.
      </p>
    </header>

    <!-- Gallery Grid -->
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {sortedGallery.map((item) => (
        <GalleryCard item={item} />
      ))}
    </section>

    <!-- Subtext -->
    <div class="pt-6 border-t border-black/[0.06] dark:border-white/[0.06] text-center text-xs font-mono text-zinc-400 dark:text-zinc-500">
      Visual snapshots are added as new experiments, conferences, and explorations unfold.
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveCard from '../components/ArchiveCard.astro';
import { getCollection } from 'astro:content';

const allArchive = await getCollection('archive');
const sortedArchive = allArchive.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Archive & Field Encounters | Shlok Mehndiratta"
  description="A visual archive of lab artifacts, optical interference fringes, oscilloscopes, and geometry by Shlok Mehndiratta."
>
  <div class="space-y-10">
    <!-- Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded text-xs font-mono bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">
        <span>The Physical & Visual Archive</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Archive
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
        A record of physical textures and experimental artifacts: laser interference fringes, analog oscilloscope orbits, microscope inspections, and quiet geometry from campus and travels.
      </p>
    </header>

    <!-- Archive Grid -->
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {sortedArchive.map((item) => (
        <ArchiveCard item={item} />
      ))}
    </section>

    <!-- Subtext -->
    <div class="pt-6 border-t border-black/[0.06] dark:border-white/[0.06] text-center text-xs font-mono text-zinc-400 dark:text-zinc-500">
      Visual records are updated as new experimental setups and research travels occur.
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveCard from '../components/ArchiveCard.astro';
import { getCollection } from 'astro:content';

const allArchive = await getCollection('archive');
const sortedArchive = allArchive.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Archive | Shlok Mehndiratta"
  description="Photographs and telemetry from lab flight arenas, robot hardware, and IISER Bhopal by Shlok Mehndiratta."
>
  <div class="space-y-12 sm:space-y-16">
    <!-- Header -->
    <header class="space-y-3 pb-6 border-b border-black/[0.08] dark:border-white/[0.08]">
      <div class="flex items-center gap-2 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="uppercase tracking-wider">Field & Laboratory Photography</span>
        <span>•</span>
        <span class="font-semibold text-zinc-800 dark:text-zinc-200">{sortedArchive.length} Images</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Archive
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
        Photographs from laboratory flight arenas, robotics hardware experiments, and campus at IISER Bhopal.
      </p>
    </header>

    <!-- Archive Grid -->
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {sortedArchive.map((item) => (
        <ArchiveCard item={item} />
      ))}
    </section>
  </div>
</BaseLayout>

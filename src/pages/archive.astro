---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchiveCard from '../components/ArchiveCard.astro';
import { getCollection } from 'astro:content';

const allArchive = await getCollection('archive');
const sortedArchive = allArchive.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Archive | Shlok Mehndiratta"
  description="Photographs and telemetry from lab flight arenas, robot hardware, and IISER Bhopal by Shlok Mehndiratta."
>
  <div class="space-y-10 sm:space-y-12">
    <!-- Header -->
    <header class="space-y-2">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Archive
      </h1>
      <p class="text-base text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
        Photographs and telemetry from lab flight arenas, robot hardware, and IISER Bhopal.
      </p>
    </header>

    <!-- Archive Grid -->
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      {sortedArchive.map((item) => (
        <ArchiveCard item={item} />
      ))}
    </section>
  </div>
</BaseLayout>

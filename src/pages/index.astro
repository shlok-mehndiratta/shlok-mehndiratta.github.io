      <!-- Section Header with Distinct Monograph Taxonomy -->
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
        <div class="space-y-1">
          <div class="flex items-center gap-2 mb-1">
            <span class="inline-flex items-center justify-center px-2 py-0.5 rounded font-mono text-[11px] font-bold bg-zinc-900 text-zinc-50 dark:bg-zinc-100 dark:text-zinc-950 shadow-[0_1px_3px_rgba(31,22,15,0.25),inset_0_1px_0_rgba(255,255,255,0.15)]">07</span>
            <span class="text-[11px] font-mono uppercase tracking-widest text-zinc-500 dark:text-zinc-400 font-semibold">Gallery</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Photo Gallery
          </h2>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 font-sans">
            Moments from academic workshops, campus at IISER Bhopal, and personal milestones.
          </p>
        </div>
        <a
          href="/archive"
          class="text-xs font-mono text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors font-medium shrink-0 flex items-center gap-1"
        >
          <span>Browse full gallery ({allArchive.length})</span>
          <span>&rarr;</span>
        </a>
      </div>

      <!-- Small, compact cards in a 4-column responsive grid -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
        {compactArchive.map((item) => (
          <a
            href="/archive"
            class="group apple-card block space-y-1 p-1.5 rounded-lg transition-all"
          >
            <div class="tactile-plate w-full aspect-[4/3] rounded-md overflow-hidden bg-black/[0.03] dark:bg-white/[0.04]">
              <img
                src={item.data.imageUrl}
                alt={item.data.title}
                loading="lazy"
                class="w-full h-full object-cover grayscale contrast-105 group-hover:grayscale-0 group-hover:scale-105 transition-all duration-300"
              />
            </div>
            <div class="px-0.5 space-y-0.5">
              <h3 class="text-[11px] font-semibold text-zinc-950 dark:text-zinc-50 truncate leading-tight">
                {item.data.title}
              </h3>
              <p class="text-[9px] font-mono text-zinc-500 dark:text-zinc-400 truncate">
                {new Intl.DateTimeFormat('en-US', { month: 'short', year: 'numeric' }).format(item.data.date)}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import NotebookCard from '../components/NotebookCard.astro';
import ArchiveCard from '../components/ArchiveCard.astro';
import { getCollection } from 'astro:content';

const allPubs = await getCollection('publications');
const featuredPub = allPubs.sort((a, b) => a.data.order - b.data.order)[0];

const allNotes = await getCollection('notebook', ({ data }) => !data.draft);
const recentNote = allNotes.sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
)[0];

const allArchive = await getCollection('archive');
const previewArchive = allArchive.sort((a, b) => a.data.order - b.data.order).slice(0, 4);

const homeSections = [
  { id: 'overview', label: 'Overview' },
  { id: 'research', label: 'Research' },
  { id: 'systems', label: 'Open Source' },
  { id: 'writing', label: 'Writing' },
  { id: 'archive', label: 'Field & Lab' },
];
---

<BaseLayout
  title="Shlok Mehndiratta | Robotics & Autonomous Systems @ IISER Bhopal"
  description="Personal website of Shlok Mehndiratta. EECS undergraduate researcher at IISER Bhopal working across robotics, control theory, state estimation, and learning for autonomous systems."
  sections={homeSections}
>
  <div class="space-y-16 sm:space-y-24">
    <!-- Hero Section (Editorial Technical Identity & Personal Portrait) -->
    <section id="overview" class="pt-2">
      <div class="flex flex-col-reverse md:flex-row md:items-start justify-between gap-8 sm:gap-12">
        <!-- Left: Narrative & Identity -->
        <div class="space-y-5 max-w-2xl">
          <div class="space-y-2">
            <div class="flex items-center gap-2 text-xs font-mono text-zinc-400 dark:text-zinc-500 uppercase tracking-widest">
              <span class="text-cyan-600 dark:text-cyan-400 font-bold">RESEARCHER</span>
              <span class="tala-divider">||</span>
              <span>IISER BHOPAL</span>
              <span class="tala-divider">|</span>
              <span>23.28°N 77.27°E</span>
            </div>

            <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
              Shlok Mehndiratta
            </h1>

            <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 font-medium leading-relaxed">
              Electrical Engineering & Computer Science senior at <span class="text-zinc-950 dark:text-zinc-100 font-semibold">IISER Bhopal</span> (CPI: 8.87 / 10). Investigating autonomous drone swarms, visual contact estimation, and real-time control.
            </p>
          </div>

          <p class="text-sm sm:text-base leading-relaxed text-zinc-600 dark:text-zinc-300 font-sans">
            My work grounds theoretical control and estimation algorithms on physical hardware testbeds—from vision-based aerial swarms in OptiTrack arenas (MOON Lab) to GPU physics simulation (NVIDIA Warp) for 16-DoF dexterous hands (RRC IIIT Hyderabad) and upstream contributions to <code class="text-xs font-mono px-1.5 py-0.5 rounded bg-zinc-200/60 dark:bg-zinc-800 text-zinc-800 dark:text-zinc-200">ros2_control</code>.
          </p>

          <!-- Action Triggers (Disciplined Athletic Form) -->
          <div class="flex flex-wrap items-center gap-3 pt-1">
            <a
              href="/experience"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-zinc-950 dark:bg-zinc-100 text-zinc-50 dark:text-zinc-950 text-xs sm:text-sm font-medium shadow-sm hover:bg-zinc-800 dark:hover:bg-white transition-all"
            >
              <span>Experience & Research</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>

            <a
              href="/projects"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-xl border border-black/[0.08] dark:border-white/[0.1] bg-transparent hover:bg-black/[0.03] dark:hover:bg-white/[0.03] text-zinc-800 dark:text-zinc-200 text-xs sm:text-sm font-medium transition-all"
            >
              <span>Projects & Builds</span>
            </a>

            <a
              href="/resume"
              class="inline-flex items-center gap-1.5 px-3 py-2 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300 hover:text-black dark:hover:text-white transition-colors font-mono"
            >
              <span>Curriculum Vitae</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </a>
          </div>

          <!-- Social & Academic Links -->
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 pt-2 text-xs font-mono text-zinc-500 dark:text-zinc-400 border-t border-black/[0.05] dark:border-white/[0.06]">
            <a href="https://github.com/shlok-mehndiratta" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">
              GitHub
            </a>
            <span>•</span>
            <a href="https://linkedin.com/in/shlok-mehndiratta" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">
              LinkedIn
            </a>
            <span>•</span>
            <a href="https://scholar.google.com" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">
              Google Scholar
            </a>
            <span>•</span>
            <a href="https://x.com/ShlokMehndiratt" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">
              X (Twitter)
            </a>
            <span>•</span>
            <a href="mailto:shlokm23@iiserb.ac.in" class="hover:text-black dark:hover:text-white transition-colors">
              shlokm23@iiserb.ac.in
            </a>
          </div>
        </div>

        <!-- Right: Personal Portrait Plate -->
        <div class="w-full sm:w-56 md:w-64 shrink-0 self-start">
          <div class="reticle-corner p-2 rounded-xl border border-black/[0.08] dark:border-white/[0.08] bg-zinc-50/60 dark:bg-zinc-900/40">
            <div class="flex items-center justify-between text-[9px] font-mono text-zinc-400 dark:text-zinc-500 pb-1.5 px-0.5 uppercase tracking-wider">
              <span class="text-cyan-600 dark:text-cyan-400 font-bold">PORTRAIT // APPARATUS</span>
              <span>23.28°N</span>
            </div>
            <div class="relative w-full aspect-[4/5] overflow-hidden rounded-lg bg-zinc-100 dark:bg-zinc-800">
              <img
                src="/shlok-portrait.jpg"
                onerror="this.onerror=null; this.src='/shlok-portrait.svg';"
                alt="Shlok Mehndiratta — EECS Researcher at IISER Bhopal"
                class="w-full h-full object-cover grayscale contrast-110 hover:grayscale-0 hover:contrast-100 transition-all duration-500"
              />
              <div class="absolute inset-0 border border-black/10 dark:border-white/10 pointer-events-none rounded-lg"></div>
            </div>
            <div class="pt-2 px-0.5 flex items-center justify-between text-[10px] font-mono text-zinc-400 dark:text-zinc-500">
              <span class="text-zinc-800 dark:text-zinc-200 font-medium truncate">Shlok Mehndiratta</span>
              <span class="shrink-0 text-zinc-500">IISER Bhopal</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 1: Research (Editorial Manuscript Docket) -->
    <section id="research" class="space-y-5">
      <div class="flex items-baseline justify-between border-b border-black/[0.06] dark:border-white/[0.06] pb-3">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Research
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">
            Autonomous drone swarms and vision-based control manuscripts
          </p>
        </div>
        <a href="/experience" class="text-xs font-medium text-zinc-500 hover:text-black dark:hover:text-white transition-colors font-mono">
          All Publications &rarr;
        </a>
      </div>

      <div>
        <PublicationCard pub={featuredPub} />
      </div>
    </section>

    <!-- Section 2: Open Source (Subsystem Telemetry Spec Docket) -->
    <section id="systems" class="space-y-5">
      <div class="flex items-baseline justify-between border-b border-black/[0.06] dark:border-white/[0.06] pb-3">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Open Source
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">
            Real-time safety and diagnostic test suites for ros2_control
          </p>
        </div>
        <a href="/experience#open-source" class="text-xs font-medium text-zinc-500 hover:text-black dark:hover:text-white transition-colors font-mono">
          Full Subsystem Spec &rarr;
        </a>
      </div>

      <div class="dossier-panel reticle-corner pt-6 pb-7 px-4 -mx-4 rounded-xl hover:bg-black/[0.015] dark:hover:bg-white/[0.015] transition-all space-y-3">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 border-b border-black/[0.05] dark:border-white/[0.05] pb-3">
          <div>
            <div class="flex items-center gap-1.5 text-xs font-mono text-zinc-400 dark:text-zinc-500 mb-1">
              <span class="text-cyan-600 dark:text-cyan-400 font-bold">[SUBSYSTEM.01]</span>
              <span class="tala-divider">||</span>
              <span>ROS 2 CONTROL FRAMEWORK</span>
              <span class="tala-divider">|</span>
              <span class="text-emerald-600 dark:text-emerald-400 font-semibold">● ACTIVE UPSTREAM</span>
            </div>
            <h3 class="text-base sm:text-lg font-semibold text-zinc-950 dark:text-zinc-50">
              ros2_control: Real-Time Safety & Diagnostics
            </h3>
          </div>
          <a
            href="https://github.com/ros-controls/ros2_control"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono text-zinc-500 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors shrink-0"
          >
            ros-controls/ros2_control &rarr;
          </a>
        </div>

        <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed font-sans">
          Migrated the controller manager lock to an RT-safe priority-inheritance mutex to eliminate priority inversion and latency spikes in high-frequency control loops; built dynamic command toggling and exception-handling test suites preventing cascaded hardware failures.
        </p>

        <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-black/[0.04] dark:border-white/[0.04] text-[10px] font-mono text-zinc-500">
          <span class="bg-zinc-100 dark:bg-zinc-800 px-2.5 py-0.5 rounded text-zinc-700 dark:text-zinc-300">C++20</span>
          <span class="bg-zinc-100 dark:bg-zinc-800 px-2.5 py-0.5 rounded text-zinc-700 dark:text-zinc-300">ROS 2</span>
          <span class="bg-zinc-100 dark:bg-zinc-800 px-2.5 py-0.5 rounded text-zinc-700 dark:text-zinc-300">POSIX RT Mutex</span>
          <span class="bg-zinc-100 dark:bg-zinc-800 px-2.5 py-0.5 rounded text-zinc-700 dark:text-zinc-300">Deterministic Control</span>
        </div>
      </div>
    </section>

    <!-- Section 3: Writing (Editorial Essay Ledger) -->
    {
      recentNote && (
        <section id="writing" class="space-y-5">
          <div class="flex items-baseline justify-between border-b border-black/[0.06] dark:border-white/[0.06] pb-3">
            <div>
              <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
                Writing
              </h2>
              <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">
                Systems discipline and state modeling from Harvard CS50 Web
              </p>
            </div>
            <a href="/notebook" class="text-xs font-medium text-zinc-500 hover:text-black dark:hover:text-white transition-colors font-mono">
              All Notes &rarr;
            </a>
          </div>

          <div>
            <NotebookCard entry={recentNote} />
          </div>
        </section>
      )
    }

    <!-- Section 4: Visual Encounters Preview (Laboratory Observation Plates) -->
    <section id="archive" class="space-y-5">
      <div class="flex items-baseline justify-between border-b border-black/[0.06] dark:border-white/[0.06] pb-3">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Field & Lab
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">
            Photographs from drone arenas, robot hardware, and campus
          </p>
        </div>
        <a href="/archive" class="text-xs font-medium text-zinc-500 hover:text-black dark:hover:text-white transition-colors font-mono">
          Browse All ({allArchive.length}) &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {previewArchive.map((item) => (
          <ArchiveCard item={item} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

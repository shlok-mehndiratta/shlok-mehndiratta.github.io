---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import NotebookCard from '../components/NotebookCard.astro';
import ArchiveCard from '../components/ArchiveCard.astro';
import { getCollection } from 'astro:content';

const allPubs = await getCollection('publications');
const featuredPub = allPubs.find((p) => p.data.featured) || allPubs[0];

const allNotebook = await getCollection('notebook', ({ data }) => !data.draft);
const recentNote = allNotebook.sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
)[0];

const allArchive = await getCollection('archive');
const previewArchive = allArchive.sort((a, b) => a.data.order - b.data.order).slice(0, 2);

const homeSections = [
  { id: 'overview', label: 'Overview' },
  { id: 'research', label: 'Research' },
  { id: 'systems', label: 'Systems & Infra' },
  { id: 'writing', label: 'Writing' },
  { id: 'archive', label: 'Archive' },
];
---

<BaseLayout
  title="Shlok Mehndiratta | Robotics & Autonomous Systems @ IISER Bhopal"
  description="Personal website of Shlok Mehndiratta. EECS undergraduate researcher at IISER Bhopal working across robotics, control theory, state estimation, and learning for autonomous systems."
  sections={homeSections}
>
  <div class="space-y-16 sm:space-y-24">
    <!-- Hero Section -->
    <section id="overview" class="pt-2">
      <div class="flex flex-col-reverse md:flex-row md:items-start justify-between gap-8 sm:gap-12">
        <!-- Left: Narrative & Identity -->
        <div class="space-y-5 max-w-2xl">
          <div class="space-y-1.5">
            <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
              Shlok Mehndiratta
            </h1>
            <p class="text-base sm:text-lg font-medium text-zinc-600 dark:text-zinc-400">
              Electrical Engineering & Computer Science at <span class="text-zinc-950 dark:text-zinc-100 font-semibold">IISER Bhopal</span>
            </p>
            <p class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
              CPI: 8.87 / 10 (3.55 / 4.0) • Autonomous Robotics & Control
            </p>
          </div>

          <p class="text-sm sm:text-base leading-relaxed text-zinc-600 dark:text-zinc-300">
            I work at the intersection of <strong class="text-zinc-950 dark:text-zinc-100 font-semibold">autonomous robotics</strong>, <strong class="text-zinc-950 dark:text-zinc-100 font-semibold">control theory</strong>, and <strong class="text-zinc-950 dark:text-zinc-100 font-semibold">learning for autonomous systems</strong>. My research investigates vision-based aerial navigation in GPS-denied environments, decentralized swarm coordination, and visual contact estimation for dexterous hands—grounding theoretical control and estimation algorithms on physical hardware testbeds.
          </p>

          <!-- Action Triggers -->
          <div class="flex flex-wrap items-center gap-3 pt-1">
            <a
              href="/experience"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-zinc-950 dark:bg-zinc-100 text-zinc-50 dark:text-zinc-950 text-xs sm:text-sm font-medium shadow-sm hover:bg-zinc-800 dark:hover:bg-white transition-all"
            >
              <span>Experience & Research</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
            </a>

            <a
              href="/projects"
              class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl border border-black/[0.08] dark:border-white/[0.1] bg-surface-light dark:bg-surface-dark text-zinc-800 dark:text-zinc-200 text-xs sm:text-sm font-medium shadow-sm hover:bg-zinc-50 dark:hover:bg-zinc-800/60 transition-all"
            >
              <span>Projects & Builds</span>
            </a>

            <a
              href="/resume"
              class="inline-flex items-center gap-1.5 px-3 py-2 text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 hover:text-black dark:hover:text-white transition-colors"
            >
              <span>Resume</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            </a>
          </div>

          <!-- Social Links -->
          <div class="flex flex-wrap items-center gap-3 pt-2 text-xs font-mono text-zinc-500 dark:text-zinc-400 border-t border-black/[0.05] dark:border-white/[0.06]">
            <a href="https://github.com/shlok-mehndiratta" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">
              GitHub
            </a>
            <span>•</span>
            <a href="https://linkedin.com/in/shlok-mehndiratta" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">
              LinkedIn
            </a>
            <span>•</span>
            <a href="https://x.com/ShlokMehndiratt" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">
              X (Twitter)
            </a>
            <span>•</span>
            <a href="mailto:shlokm23@iiserb.ac.in" class="hover:text-black dark:hover:text-white transition-colors">
              shlokm23@iiserb.ac.in
            </a>
          </div>
        </div>

        <!-- Right: Visual Plate -->
        <div class="w-full sm:w-56 md:w-64 shrink-0 self-start">
          <div class="apple-card overflow-hidden rounded-2xl p-2">
            <div class="relative w-full aspect-square overflow-hidden rounded-xl bg-zinc-100 dark:bg-zinc-800">
              <img
                src="https://images.unsplash.com/photo-1527977966376-1c8408f9f108?auto=format&fit=crop&w=800&q=80"
                alt="Crazyflie Autonomous Drone Arena at IISER Bhopal"
                class="w-full h-full object-cover grayscale contrast-125 transition-transform duration-500 hover:scale-105"
              />
            </div>
            <div class="pt-2 px-1 flex items-center justify-between text-[11px] font-mono text-zinc-400 dark:text-zinc-500">
              <span>MOON Lab Arena</span>
              <span>IISER Bhopal</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 1: Selected Research -->
    <section id="research" class="space-y-5">
      <div class="flex items-baseline justify-between border-b border-black/[0.06] dark:border-white/[0.06] pb-3">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Selected Research
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">
            Conference manuscripts in multi-agent swarms and perception-aware control
          </p>
        </div>
        <a href="/experience" class="text-xs font-medium text-zinc-500 hover:text-black dark:hover:text-white transition-colors">
          All Publications &rarr;
        </a>
      </div>

      <div>
        <PublicationCard pub={featuredPub} />
      </div>
    </section>

    <!-- Section 2: Systems & Open-Source Engineering -->
    <section id="systems" class="space-y-5">
      <div class="flex items-baseline justify-between border-b border-black/[0.06] dark:border-white/[0.06] pb-3">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Systems & Infrastructure
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">
            Core upstream contributions to robotics control software
          </p>
        </div>
        <a href="/experience#open-source" class="text-xs font-medium text-zinc-500 hover:text-black dark:hover:text-white transition-colors">
          View Contribution &rarr;
        </a>
      </div>

      <div class="apple-card apple-card-interactive p-6 sm:p-7 rounded-2xl space-y-3">
        <div class="flex items-center justify-between">
          <span class="text-xs font-mono font-medium text-zinc-500 dark:text-zinc-400">
            ros2_control framework
          </span>
          <a
            href="https://github.com/ros-controls/ros2_control"
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-mono text-zinc-400 hover:text-black dark:hover:text-white transition-colors"
          >
            Upstream Repo &rarr;
          </a>
        </div>

        <h3 class="text-base sm:text-lg font-semibold text-zinc-900 dark:text-zinc-100">
          ROS 2 Control: Real-Time Safety, Fault Isolation & Parameter Modernization
        </h3>

        <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
          Migrated the controller manager lock to an RT-safe priority-inheritance mutex to prevent timing delays in high-frequency control loops; built dynamic command toggling and exception-handling test suites preventing cascaded hardware failures.
        </p>

        <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-black/[0.04] dark:border-white/[0.04] text-xs font-mono text-zinc-500">
          <span class="bg-zinc-100 dark:bg-zinc-800/80 px-2.5 py-0.5 rounded-full text-zinc-700 dark:text-zinc-300">C++20</span>
          <span class="bg-zinc-100 dark:bg-zinc-800/80 px-2.5 py-0.5 rounded-full text-zinc-700 dark:text-zinc-300">ROS 2</span>
          <span class="bg-zinc-100 dark:bg-zinc-800/80 px-2.5 py-0.5 rounded-full text-zinc-700 dark:text-zinc-300">Real-Time Mutex</span>
          <span class="bg-zinc-100 dark:bg-zinc-800/80 px-2.5 py-0.5 rounded-full text-zinc-700 dark:text-zinc-300">Hardware Abstraction</span>
        </div>
      </div>
    </section>

    <!-- Section 3: Writing & Reflections -->
    {
      recentNote && (
        <section id="writing" class="space-y-5">
          <div class="flex items-baseline justify-between border-b border-black/[0.06] dark:border-white/[0.06] pb-3">
            <div>
              <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
                Writing
              </h2>
              <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">
                Reflections on systems discipline, state modeling, and engineering
              </p>
            </div>
            <a href="/notebook" class="text-xs font-medium text-zinc-500 hover:text-black dark:hover:text-white transition-colors">
              All Notes &rarr;
            </a>
          </div>

          <div>
            <NotebookCard entry={recentNote} />
          </div>
        </section>
      )
    }

    <!-- Section 4: Visual Encounters Preview -->
    <section id="archive" class="space-y-5">
      <div class="flex items-baseline justify-between border-b border-black/[0.06] dark:border-white/[0.06] pb-3">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Archive
          </h2>
          <p class="text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-0.5">
            Photographs and records from hardware testbeds and research environments
          </p>
        </div>
        <a href="/archive" class="text-xs font-medium text-zinc-500 hover:text-black dark:hover:text-white transition-colors">
          Browse All ({allArchive.length}) &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {previewArchive.map((item) => (
          <ArchiveCard item={item} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

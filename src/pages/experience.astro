---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { getCollection } from 'astro:content';

const allPubs = await getCollection('publications');
const sortedPubs = allPubs.sort((a, b) => a.data.order - b.data.order);

const researchExperience = [
  {
    role: 'Research Intern',
    organization: 'Robotics Research Center (RRC), IIIT Hyderabad',
    advisor: 'Dr. Spandan Roy',
    period: 'April 2026 – Present',
    projectTitle: 'Learning Visual Contact Estimation from Photorealistic Synthetic Data',
    description: 'Building a high-fidelity synthetic data engine to supervise 3D contact distribution prediction directly from single-view and multi-view camera imagery for dexterous manipulation.',
    highlights: [
      'Constructed GPU-accelerated physics pipeline (NVIDIA Warp) and photorealistic renderer (BlenderProc) generating multi-view RGB, segmentation, and 3D contact/SDF supervision.',
      'Trained vision-conditioned neural models (ResNet/UNet/PointNet) to predict 3D contact distributions from camera images for downstream grasp generation.',
      'Deploying models for real-robot policy transfer on 16-DoF LEAP Hand platforms; scaling dataset generation across multi-GPU compute clusters.',
    ],
    skills: ['NVIDIA Warp', 'BlenderProc', 'PyTorch', '16-DoF LEAP Hand', '3D Contact / SDF', 'Sim-to-Real'],
  },
  {
    role: 'Undergraduate Research Student',
    organization: 'MOON Lab, IISER Bhopal',
    advisor: 'Dr. P. B. Sujit',
    period: 'May 2026 – Present',
    projectTitle: 'Vision-Based Autonomous Navigation and Swarm Coordination',
    description: 'Implementing vision-based spherical coordinate planning for micro aerial vehicles (MAVs), moving target tracking, and dynamic obstacle avoidance. Grounding multi-agent control on physical Crazyflie quadrotors with sub-millimeter mocap state verification.',
    highlights: [
      'Implemented spherical coordinate-based vision planning with extensions for moving target tracking and dynamic obstacle avoidance for MAVs in ROS 2 simulation.',
      'Assembled flight hardware integrating micro flight controllers, radio transceivers, and real-time telemetry modules; configured OptiTrack optical mocap with ROS for millimeter-precision localization.',
      'Investigating decentralized swarm algorithms for cooperative area coverage and autonomous missions under intermittent communication constraints.',
    ],
    skills: ['ROS 2', 'OptiTrack Mocap', 'Crazyflie Swarm', 'Spherical Vision Planning', 'C++', 'Python'],
  },
  {
    role: 'Undergraduate Research Student',
    organization: 'MuSic Lab, IISER Bhopal',
    advisor: 'Dr. Arijit Sen',
    period: 'Sept 2025 – July 2026',
    projectTitle: 'Perception-Aware Altitude Optimization for Aerial-Ground Tracking',
    description: 'Formulated the altitude-coverage-resolution trade-off in shared-camera UAV-UGV tracking systems, developing closed-form altitude scheduling and constraint-aware control balancing camera field-of-view against ground resolution.',
    highlights: [
      'Derived closed-form altitude scheduling policy formalizing the coupling between camera field-of-view, ground resolution, and state estimation error covariance.',
      'Built belief-space MPC controller and event-triggered aerial planner achieving 25× compute reduction while maintaining estimation precision.',
      'Constructed complete ROS 2/Gazebo testbed with unified logging protocol across variable terrain curvature and sensor noise regimes.',
    ],
    skills: ['Belief-Space MPC', 'Extended Kalman Filter', 'ROS 2', 'Gazebo', 'Event-Triggered Planning'],
  },
  {
    role: 'Student Research Intern',
    organization: 'GeoAI4Cities Lab',
    advisor: 'Research Group',
    period: 'Dec 2024 – Jan 2025',
    projectTitle: 'Graph-Based ML Pipeline for 3D Point Cloud Segmentation',
    description: 'Developed structured graph-based representations for segmenting large-scale urban 3D LiDAR point clouds with high noise tolerance.',
    highlights: [
      'Modeled point clouds as spatial graphs with localized connectivity to balance topological expressiveness with computational tractability.',
      'Incorporated RANSAC-based geometric filtering and topological feature encoding to reduce sensitivity to LiDAR sensor noise.',
    ],
    skills: ['PyTorch Geometric', 'Open3D', 'RANSAC', 'Graph ML', 'Python'],
  },
];

const leadershipExperience = [
  {
    role: 'Student Placement Representative',
    organization: 'EECS Department, IISER Bhopal',
    period: 'Aug 2024 – Present',
    details: 'Departmental Career Liaison & Student Advocacy',
    highlights: [
      'Liaising with industry recruiters, technology companies, and R&D organizations to establish graduate placement and internship opportunities.',
      'Organizing departmental placement preparation sessions, technical mock interviews, and student recruitment drives.',
      'Advocating for student cohort interests and coordinating career development initiatives with institute administration.',
    ],
  },
  {
    role: 'Student Advisor & Former Vice Secretary',
    organization: 'Computing and Networking Council (CNC), IISER Bhopal',
    period: 'Aug 2024 – Present',
    details: 'Vice Secretary (Aug 2024 – Sept 2025) • Student Advisor (Oct 2025 – Present) • Technical Head for Aarohan 2025',
    highlights: [
      'Founded the EECS Club at IISER Bhopal; coordinated 10+ hands-on technical workshops on ROS 2, machine learning, and embedded systems.',
      'Directed 90-member multidisciplinary council across technical, logistics, and outreach operations.',
      'Managed infrastructure, digital platforms, and technical competitions for the institute flagship festival with 1,500+ participants.',
    ],
  },
  {
    role: 'Web Development Lead',
    organization: 'Google Developer Group (GDG On Campus), IISER Bhopal',
    period: 'Aug 2024 – Aug 2025',
    details: 'Campus Technical Platform Lead',
    highlights: [
      'Led end-to-end development of campus web platforms with responsive architectures.',
      'Mentored students in collaborative software engineering, version control standards, and code review pipelines.',
    ],
  },
];

const expSections = [
  { id: 'publications', label: 'Publications' },
  { id: 'research', label: 'Research Experience' },
  { id: 'open-source', label: 'Open Source' },
  { id: 'leadership', label: 'Leadership & Service' },
];
---

<BaseLayout
  title="Experience | Shlok Mehndiratta"
  description="Publications, research experience in robotics and control theory, open-source contributions to ROS 2 Control, and departmental leadership at IISER Bhopal."
  sections={expSections}
>
  <div class="space-y-16 sm:space-y-24">
    <!-- Clean Page Header -->
    <header class="space-y-3 pb-6 border-b border-black/[0.08] dark:border-white/[0.08]">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Experience
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
        Publications under review, academic research appointments in robotics, core upstream engineering for ROS 2 Control, and departmental leadership.
      </p>
    </header>

    <!-- Section 1: Publications & Preprints (On Top) -->
    <section id="publications" class="space-y-6">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold tracking-wider uppercase bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 border border-cyan-500/20">
              01 // SCHOLARLY ARCHIVE
            </span>
            <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">Peer-Reviewed & Preprints</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Publications & Preprints
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1 max-w-2xl leading-relaxed">
            Peer-reviewed manuscripts and active preprints driven by first-principles control, state estimation, and physical robotic autonomy.
          </p>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400 border border-black/[0.04] dark:border-white/[0.05] shrink-0 self-start sm:self-auto">
          {sortedPubs.length} Manuscripts • 1 Accepted, 1 Under Review
        </span>
      </div>

      <div class="space-y-6">
        {sortedPubs.map((pub) => (
          <PublicationCard pub={pub} />
        ))}
      </div>
    </section>

    <!-- Section 2: Research Experience (Minimal Chronological Spine) -->
    <section id="research" class="space-y-6 pt-10 sm:pt-14 border-t border-black/[0.08] dark:border-white/[0.08]">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold tracking-wider uppercase bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
              02 // LABORATORY APPOINTMENTS
            </span>
            <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">Academic & University Labs</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Research Experience
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1 max-w-2xl leading-relaxed">
            Chronological appointments across university laboratories, investigating dexterous manipulation, aerial swarms, and perception-coupled flight.
          </p>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400 border border-black/[0.04] dark:border-white/[0.05] shrink-0 self-start sm:self-auto">
          {researchExperience.length} Labs • 2024 — Present
        </span>
      </div>

      <!-- Minimal Chronological Spine Layout -->
      <div class="relative pl-5 sm:pl-8 space-y-8 sm:space-y-10">
        <!-- Continuous Timeline Track Spine -->
        <div class="absolute left-2 sm:left-3 top-4 bottom-4 w-[1.5px] bg-gradient-to-b from-cyan-500 via-zinc-200 to-zinc-200 dark:via-zinc-800 dark:to-zinc-800 rounded-full pointer-events-none"></div>

        {researchExperience.map((exp) => {
          const isActive = exp.period.includes('Present');
          return (
            <div class="relative group">
              <!-- Waypoint Milestone Node on the Spine -->
              <div class="absolute -left-5 sm:-left-8 top-7 -translate-x-1/2 flex items-center justify-center">
                {isActive ? (
                  <span class="relative flex h-3.5 w-3.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-60"></span>
                    <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-canvas-light dark:bg-canvas-dark border-2 border-cyan-500 items-center justify-center">
                      <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
                    </span>
                  </span>
                ) : (
                  <span class="w-3 h-3 rounded-full bg-canvas-light dark:bg-canvas-dark border-2 border-zinc-400 dark:border-zinc-600"></span>
                )}
              </div>

              <!-- Elevated Research Dossier Card -->
              <article class="apple-card group relative p-6 sm:p-8 rounded-2xl bg-white dark:bg-[#121214] border border-black/[0.06] dark:border-white/[0.08] shadow-apple-card dark:shadow-apple-card-dark transition-all hover:border-black/15 dark:hover:border-white/20 space-y-4">
                <!-- Header Row -->
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 border-b border-black/[0.05] dark:border-white/[0.05] pb-4">
                  <div>
                    <div class="flex items-center gap-2 mb-1">
                      {isActive && (
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 border border-cyan-500/20">
                          <span class="w-1 h-1 rounded-full bg-cyan-500 animate-pulse"></span>
                          <span>ACTIVE APPOINTMENT</span>
                        </span>
                      )}
                    </div>
                    <h3 class="text-lg sm:text-xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
                      {exp.organization}
                    </h3>
                    <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1">
                      Advisor: <strong class="text-zinc-900 dark:text-zinc-200 font-semibold">{exp.advisor}</strong>
                    </p>
                  </div>

                  <div class="flex flex-wrap items-center gap-2 sm:self-start">
                    <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium ${
                      isActive
                        ? 'bg-cyan-50 dark:bg-cyan-950/40 text-cyan-800 dark:text-cyan-300 border border-cyan-500/30'
                        : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-black/[0.05] dark:border-white/[0.05]'
                    }`}>
                      <span class={`w-1.5 h-1.5 rounded-full ${isActive ? 'bg-cyan-500' : 'bg-zinc-400 dark:bg-zinc-500'}`}></span>
                      <span>{exp.period}</span>
                    </span>
                    <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
                      {exp.role}
                    </span>
                  </div>
                </div>

                <!-- Body: Project Focus & Bullets -->
                <div class="space-y-3 pt-1">
                  <h4 class="text-base sm:text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 leading-snug">
                    {exp.projectTitle}
                  </h4>

                  <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed font-sans">
                    {exp.description}
                  </p>

                  {exp.highlights && (
                    <ul class="space-y-2 pt-1 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400">
                      {exp.highlights.map((h) => (
                        <li class="flex items-start gap-2.5">
                          <span class="text-cyan-600 dark:text-cyan-400 font-mono mt-0.5 shrink-0 font-bold">—</span>
                          <span class="leading-relaxed">{h}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>

                <!-- Skills & Platforms Pills -->
                <div class="flex flex-wrap gap-1.5 pt-4 border-t border-black/[0.05] dark:border-white/[0.05]">
                  {exp.skills.map((skill) => (
                    <span class="text-[11px] font-mono px-2.5 py-1 rounded-md bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300">
                      {skill}
                    </span>
                  ))}
                </div>
              </article>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Section 3: Open-Source Contributions -->
    <section id="open-source" class="space-y-6 pt-10 sm:pt-14 border-t border-black/[0.08] dark:border-white/[0.08]">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold tracking-wider uppercase bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-500/20">
              03 // SYSTEMS ENGINEERING
            </span>
            <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">Core Upstream Infrastructure</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Open-Source Contributions
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1 max-w-2xl leading-relaxed">
            Upstream systems engineering for global robotics infrastructure and real-time control frameworks.
          </p>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400 border border-black/[0.04] dark:border-white/[0.05] shrink-0 self-start sm:self-auto">
          ros2_control • Core Contributor
        </span>
      </div>

      <!-- Opaque ros2_control Framework Card -->
      <article class="apple-card group relative p-6 sm:p-8 rounded-2xl bg-white dark:bg-[#121214] border border-black/[0.06] dark:border-white/[0.08] shadow-apple-card dark:shadow-apple-card-dark transition-all hover:border-black/15 dark:hover:border-white/20 space-y-5">
        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-3 border-b border-black/[0.05] dark:border-white/[0.05] pb-4">
          <div>
            <div class="flex items-center gap-2 text-xs font-mono text-zinc-400 dark:text-zinc-500 mb-1.5">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Active Upstream Contributor</span>
              </span>
              <span>•</span>
              <span>Robot Control Infrastructure</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
              ros2_control: Robot Operating System 2 Control Framework
            </h3>
            <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 mt-0.5">
              Core Framework Contributor • Real-Time Determinism & Concurrency
            </p>
          </div>

          <a
            href="https://github.com/ros-controls/ros2_control"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg border border-black/[0.08] dark:border-white/[0.08] bg-zinc-50 dark:bg-zinc-800/60 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-xs font-mono text-zinc-700 dark:text-zinc-300 hover:text-cyan-600 dark:hover:text-cyan-400 transition-all shrink-0"
          >
            <span>ros-controls/ros2_control</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </div>

        <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-300 leading-relaxed font-sans">
          Active contributor to the standard robotics control framework in ROS 2, focusing on eliminating non-deterministic lock contention in high-frequency hardware loops, ensuring fault isolation across dynamic plugins, and modernizing parameter systems.
        </p>

        <!-- Engineering Highlight Blocks -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-1">
          <div class="p-4 sm:p-5 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-black/[0.05] dark:border-white/[0.06] space-y-2">
            <h4 class="text-xs sm:text-sm font-semibold text-zinc-900 dark:text-zinc-100 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
              Real-Time Concurrency
            </h4>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Migrated controller manager lock to an RT-safe priority-inheritance mutex to eliminate priority inversion and jitter in 1 kHz control loops; implemented dynamic command toggling for hardware communication failure testing.
            </p>
          </div>

          <div class="p-4 sm:p-5 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-black/[0.05] dark:border-white/[0.06] space-y-2">
            <h4 class="text-xs sm:text-sm font-semibold text-zinc-900 dark:text-zinc-100 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
              Cascade Failure Prevention
            </h4>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Designed exception-handling test suites ensuring individual hardware plugin failures do not cascade into system-wide crashes, pinpointing failed hardware interfaces immediately.
            </p>
          </div>

          <div class="p-4 sm:p-5 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-black/[0.05] dark:border-white/[0.06] space-y-2">
            <h4 class="text-xs sm:text-sm font-semibold text-zinc-900 dark:text-zinc-100 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
              API Modernization
            </h4>
            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
              Refactored deprecated parameter APIs across the ecosystem, removing technical debt and preventing downstream breakage across commercial and academic robot hardware drivers.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap gap-2 pt-3 border-t border-black/[0.04] dark:border-white/[0.04] text-[10px] font-mono text-zinc-500 dark:text-zinc-400">
          <span class="px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800">C++20</span>
          <span class="px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800">POSIX RT Mutex</span>
          <span class="px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800">Real-Time Concurrency</span>
          <span class="px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800">ROS 2 Control</span>
          <span class="px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800">Continuous Integration</span>
        </div>
      </article>
    </section>

    <!-- Section 4: Leadership & Academic Service -->
    <section id="leadership" class="space-y-6 pt-10 sm:pt-14 border-t border-black/[0.08] dark:border-white/[0.08]">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold tracking-wider uppercase bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20">
              04 // LEADERSHIP & GOVERNANCE
            </span>
            <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">Institutional Advocacy</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Leadership & Academic Service
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1 max-w-2xl leading-relaxed">
            Departmental career advocacy, student governance, and technical community building across IISER Bhopal.
          </p>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400 border border-black/[0.04] dark:border-white/[0.05] shrink-0 self-start sm:self-auto">
          {leadershipExperience.length} Positions • IISER Bhopal
        </span>
      </div>

      <!-- Minimal Chronological Spine Layout for Leadership -->
      <div class="relative pl-5 sm:pl-8 space-y-8 sm:space-y-10">
        <!-- Continuous Timeline Track Spine -->
        <div class="absolute left-2 sm:left-3 top-4 bottom-4 w-[1.5px] bg-gradient-to-b from-amber-500 via-zinc-200 to-zinc-200 dark:via-zinc-800 dark:to-zinc-800 rounded-full pointer-events-none"></div>

        {leadershipExperience.map((lead) => {
          const isActive = lead.period.includes('Present');
          return (
            <div class="relative group">
              <!-- Waypoint Milestone Node on the Spine -->
              <div class="absolute -left-5 sm:-left-8 top-7 -translate-x-1/2 flex items-center justify-center">
                {isActive ? (
                  <span class="relative flex h-3.5 w-3.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-60"></span>
                    <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-canvas-light dark:bg-canvas-dark border-2 border-amber-500 items-center justify-center">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>
                    </span>
                  </span>
                ) : (
                  <span class="w-3 h-3 rounded-full bg-canvas-light dark:bg-canvas-dark border-2 border-zinc-400 dark:border-zinc-600"></span>
                )}
              </div>

              <!-- Elevated Leadership Card -->
              <article class="apple-card group relative p-6 sm:p-7 rounded-2xl bg-white dark:bg-[#121214] border border-black/[0.06] dark:border-white/[0.08] shadow-apple-card dark:shadow-apple-card-dark transition-all hover:border-black/15 dark:hover:border-white/20 space-y-3.5">
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2 border-b border-black/[0.05] dark:border-white/[0.05] pb-3">
                  <div>
                    <div class="flex items-center gap-2 mb-1">
                      {isActive && (
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-amber-500/10 text-amber-700 dark:text-amber-400 border border-amber-500/20">
                          <span class="w-1 h-1 rounded-full bg-amber-500 animate-pulse"></span>
                          <span>ACTIVE ROLE</span>
                        </span>
                      )}
                    </div>
                    <h3 class="text-base sm:text-lg font-bold text-zinc-950 dark:text-zinc-50">
                      {lead.role}
                    </h3>
                    <p class="text-xs sm:text-sm font-medium text-amber-700 dark:text-amber-400 font-mono mt-0.5">
                      {lead.organization}
                    </p>
                  </div>
                  <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium shrink-0 self-start sm:self-auto ${
                    isActive
                      ? 'bg-amber-50 dark:bg-amber-950/40 text-amber-800 dark:text-amber-300 border border-amber-500/30'
                      : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-black/[0.05] dark:border-white/[0.05]'
                  }`}>
                    <span class={`w-1.5 h-1.5 rounded-full ${isActive ? 'bg-amber-500' : 'bg-zinc-400 dark:bg-zinc-500'}`}></span>
                    <span>{lead.period}</span>
                  </span>
                </div>

                <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
                  {lead.details}
                </p>

                <ul class="space-y-2 text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 pt-1">
                  {lead.highlights.map((h) => (
                    <li class="flex items-start gap-2.5">
                      <span class="text-amber-600 dark:text-amber-400 font-mono mt-0.5 shrink-0 font-bold">—</span>
                      <span class="leading-relaxed">{h}</span>
                    </li>
                  ))}
                </ul>
              </article>
            </div>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';

const educationData = {
  institution: 'Indian Institute of Science Education and Research Bhopal (IISER Bhopal)',
  degree: 'Bachelor of Science in Electrical Engineering & Computer Science (EECS)',
  period: 'August 2023 – Present',
  expectedGrad: 'May 2027',
  cpi: '8.87 / 10.0',
  usEquivalent: '3.55+ / 4.0',
  location: 'Bhopal, Madhya Pradesh, India',
  schooling: [
    { exam: 'CBSE Class XII (Senior Secondary)', score: '95.8%', year: '2023', place: 'Roorkee, India' },
    { exam: 'CBSE Class X (Secondary)', score: '96.8%', year: '2021', place: 'Roorkee, India' },
  ],
};

const researchExperience = [
  {
    role: 'Research Intern',
    organization: 'Robotics Research Center (RRC), IIIT Hyderabad',
    advisor: 'Dr. Spandan Roy',
    period: 'April 2026 – Present',
    projectTitle: 'Learning Visual Contact Estimation from Photorealistic Synthetic Data',
    description: 'Building a high-fidelity synthetic data engine to supervise 3D contact distribution prediction directly from single-view and multi-view camera imagery for dexterous manipulation.',
    contributions: [
      {
        title: 'GPU-Accelerated Physics Engine',
        desc: 'Engineered high-throughput simulation in NVIDIA Warp and BlenderProc to generate dense multi-view RGB, segmentation, and 3D contact/SDF ground truth.',
      },
      {
        title: 'Vision-Conditioned Estimation',
        desc: 'Trained neural representations (ResNet/PointNet) to predict continuous 3D surface contact manifolds directly from camera imagery for downstream grasp generation.',
      },
      {
        title: 'Sim-to-Real Hardware Transfer',
        desc: 'Deploying neural policies for physical robot transfer on 16-DoF LEAP Hand platforms across multi-GPU compute clusters.',
      },
    ],
    skills: ['NVIDIA Warp', 'BlenderProc', 'PyTorch', '16-DoF LEAP Hand', '3D Contact / SDF', 'Sim-to-Real'],
  },
  {
    role: 'Undergraduate Research Student',
    organization: 'MOON Lab, IISER Bhopal',
    advisor: 'Dr. P. B. Sujit',
    period: 'May 2026 – Present',
    projectTitle: 'Vision-Based Autonomous Navigation and Swarm Coordination',
    description: 'Formulating spherical coordinate vision planning and multi-agent coordination algorithms, validating autonomous flight policies across physical Crazyflie quadrotors and indoor motion capture arenas.',
    contributions: [
      {
        title: 'Spherical Vision Planning',
        desc: 'Formulated vision-space spherical trajectory generation for micro aerial vehicles (MAVs), handling active target tracking and dynamic obstacle avoidance in ROS 2.',
      },
      {
        title: 'Hardware Arena & State Estimation',
        desc: 'Assembled micro quadrotor flight hardware and configured OptiTrack optical motion capture integration with ROS 2 for millimeter-precision localization.',
      },
      {
        title: 'Decentralized Swarm Coordination',
        desc: 'Investigating persistent area coverage and dynamic partition balancing under intermittent, discrete inter-agent communication constraints.',
      },
    ],
    skills: ['ROS 2', 'OptiTrack Mocap', 'Crazyflie Swarm', 'Spherical Vision Planning', 'C++', 'Python'],
  },
  {
    role: 'Undergraduate Research Student',
    organization: 'MuSic Lab, IISER Bhopal',
    advisor: 'Dr. Arijit Sen',
    period: 'Sept 2025 – July 2026',
    projectTitle: 'Perception-Aware Altitude Optimization for Aerial-Ground Tracking',
    description: 'Formulated the altitude-coverage-resolution trade-off in shared-camera UAV-UGV tracking systems, developing closed-form altitude scheduling and constraint-aware control balancing camera field-of-view against ground resolution.',
    contributions: [
      {
        title: 'Perception-Coupled Altitude Scheduling',
        desc: 'Derived closed-form altitude scheduling balancing camera field-of-view against sensor noise covariance scaling (R ∝ z²) in shared-camera tracking.',
      },
      {
        title: 'Belief-Space MPC & Triggering',
        desc: 'Built a belief-space ground controller with an event-triggered aerial planner, cutting compute by 25× while preserving estimation bounds.',
      },
      {
        title: 'Full-System Gazebo Testbed',
        desc: 'Engineered unified ROS 2/Gazebo simulation testbed across variable terrain curvature and realistic sensor noise regimes.',
      },
    ],
    skills: ['Belief-Space MPC', 'Extended Kalman Filter', 'ROS 2', 'Gazebo', 'Event-Triggered Planning'],
  },
  {
    role: 'Student Research Intern',
    organization: 'GeoAI4Cities Lab',
    advisor: 'Research Group',
    period: 'Dec 2024 – Jan 2025',
    projectTitle: 'Graph-Based ML Pipeline for 3D Point Cloud Segmentation',
    description: 'Developed structured graph-based representations for segmenting large-scale urban 3D LiDAR point clouds with high noise tolerance.',
    contributions: [
      {
        title: 'Spatial Graph Modeling',
        desc: 'Constructed localized geometric graphs in PyTorch Geometric to represent large-scale urban LiDAR point clouds with high topological expressiveness.',
      },
      {
        title: 'Noise-Resilient Filtering',
        desc: 'Combined geometric RANSAC filtering with topological graph features to suppress sparse LiDAR sensor noise and improve segmentation accuracy.',
      },
    ],
    skills: ['PyTorch Geometric', 'Open3D', 'RANSAC', 'Graph ML', 'Python'],
  },
];

const leadershipExperience = [
  {
    role: 'Student Placement Representative',
    organization: 'EECS Department, IISER Bhopal',
    period: 'Aug 2024 – Present',
    details: 'Departmental Career Liaison & Student Advocacy',
    highlights: [
      'Liaising with industry recruiters, technology companies, and R&D organizations to establish graduate placement and internship opportunities.',
      'Organizing departmental placement preparation sessions, technical mock interviews, and student recruitment drives.',
      'Advocating for student cohort interests and coordinating career development initiatives with institute administration.',
    ],
  },
  {
    role: 'Student Advisor & Former Vice Secretary',
    organization: 'Computing and Networking Council (CNC), IISER Bhopal',
    period: 'Aug 2024 – Present',
    details: 'Vice Secretary (Aug 2024 – Sept 2025) • Student Advisor (Oct 2025 – Present) • Technical Head for Aarohan 2025',
    highlights: [
      'Founded the EECS Club at IISER Bhopal; coordinated 10+ hands-on technical workshops on ROS 2, machine learning, and embedded systems.',
      'Directed 90-member multidisciplinary council across technical, logistics, and outreach operations.',
      'Managed infrastructure, digital platforms, and technical competitions for the institute flagship festival with 1,500+ participants.',
    ],
  },
  {
    role: 'Web Development Lead',
    organization: 'Google Developer Group (GDG On Campus), IISER Bhopal',
    period: 'Aug 2024 – Aug 2025',
    details: 'Campus Technical Platform Lead',
    highlights: [
      'Led end-to-end development of campus web platforms with responsive architectures.',
      'Mentored students in collaborative software engineering, version control standards, and code review pipelines.',
    ],
  },
];

const expSections = [
  { id: 'education', label: 'Education' },
  { id: 'research', label: 'Research Experience' },
  { id: 'open-source', label: 'Open Source' },
  { id: 'leadership', label: 'Leadership & Service' },
];
---

<BaseLayout
  title="Experience | Shlok Mehndiratta"
  description="Academic education at IISER Bhopal, research appointments in robotics and control theory, open-source contributions to ROS 2 Control, and departmental leadership."
  sections={expSections}
>
  <div class="space-y-16 sm:space-y-24">
    <!-- Clean Page Header -->
    <header class="space-y-3 pb-6 border-b border-black/[0.08] dark:border-white/[0.08]">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Experience
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
        Academic education at IISER Bhopal, research appointments across university laboratories, core upstream engineering for ROS 2 Control, and departmental leadership.
      </p>
    </header>

    <!-- Section 1: Education & Academic Foundations -->
    <section id="education" class="space-y-6">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold tracking-wider uppercase bg-blue-500/10 text-blue-700 dark:text-blue-400 border border-blue-500/20">
              01 // ACADEMIC FOUNDATIONS
            </span>
            <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">Degree & Institutional Credentials</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Education
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1 max-w-2xl leading-relaxed">
            Undergraduate academic study in Electrical Engineering and Computer Science at IISER Bhopal.
          </p>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400 border border-black/[0.04] dark:border-white/[0.05] shrink-0 self-start sm:self-auto">
          {educationData.period} • Bhopal, India
        </span>
      </div>

      <!-- Opaque Elevated Education Dossier Card -->
      <article class="apple-card group relative p-6 sm:p-8 rounded-2xl bg-white dark:bg-[#121214] border border-black/[0.06] dark:border-white/[0.08] shadow-apple-card dark:shadow-apple-card-dark transition-all hover:border-black/15 dark:hover:border-white/20 space-y-6">
        <!-- Institution & Degree Header -->
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 border-b border-black/[0.05] dark:border-white/[0.05] pb-5">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Active Degree Candidate</span>
              </span>
            </div>
            <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
              {educationData.institution}
            </h3>
            <p class="text-sm sm:text-base font-medium text-zinc-700 dark:text-zinc-300">
              {educationData.degree}
            </p>
            <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
              {educationData.location} • Expected Graduation: {educationData.expectedGrad}
            </p>
          </div>

          <!-- Academic Standing Metric Pill / Badge -->
          <div class="flex sm:flex-col items-baseline sm:items-end justify-between sm:justify-start gap-1 p-3.5 sm:p-4 rounded-xl bg-zinc-50 dark:bg-zinc-900/60 border border-black/[0.05] dark:border-white/[0.06] shrink-0">
            <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Cumulative CPI</span>
            <div class="flex items-baseline gap-1">
              <span class="text-2xl font-bold font-mono tracking-tight text-zinc-950 dark:text-zinc-50">{educationData.cpi}</span>
            </div>
            <span class="text-[10px] font-mono text-zinc-400 dark:text-zinc-500">({educationData.usEquivalent} US Scale)</span>
          </div>
        </div>

        <!-- Secondary Pre-University Metrics & Notes -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          {educationData.schooling.map((school) => (
            <div class="p-3.5 rounded-xl bg-zinc-50/70 dark:bg-zinc-900/40 border border-black/[0.04] dark:border-white/[0.04] flex items-center justify-between">
              <div>
                <p class="text-xs font-semibold text-zinc-800 dark:text-zinc-200">{school.exam}</p>
                <p class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400">{school.place} • {school.year}</p>
              </div>
              <span class="text-xs font-mono font-bold text-zinc-900 dark:text-zinc-100 px-2 py-0.5 rounded bg-zinc-200/60 dark:bg-zinc-800">
                {school.score}
              </span>
            </div>
          ))}
        </div>

        <!-- Clean Coursework Referral (Lightweight, No Heavy Tables) -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pt-2 border-t border-black/[0.04] dark:border-white/[0.04] text-xs text-zinc-500 dark:text-zinc-400">
          <span>Foundational coursework in Linear Algebra, Multivariable Calculus, Control Systems, Signals & Systems, and Algorithms.</span>
          <a
            href="/resume#education"
            class="inline-flex items-center gap-1 font-mono text-cyan-600 dark:text-cyan-400 hover:text-cyan-700 dark:hover:text-cyan-300 transition-colors shrink-0 font-medium"
          >
            <span>View institute coursework matrix</span>
            <span>→</span>
          </a>
        </div>
      </article>
    </section>

    <!-- Section 2: Research Experience (Minimal Chronological Spine) -->
    <section id="research" class="space-y-6 pt-10 sm:pt-14 border-t border-black/[0.08] dark:border-white/[0.08]">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold tracking-wider uppercase bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
              02 // RESEARCH EXPERIENCE
            </span>
            <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">Academic & University Labs</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Research Experience
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1 max-w-2xl leading-relaxed">
            Chronological research appointments across university laboratories, investigating dexterous manipulation, aerial swarms, and perception-coupled flight.
          </p>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400 border border-black/[0.04] dark:border-white/[0.05] shrink-0 self-start sm:self-auto">
          {researchExperience.length} Labs • 2024 — Present
        </span>
      </div>

      <!-- Minimal Chronological Spine Layout -->
      <div class="relative pl-5 sm:pl-8 space-y-8 sm:space-y-10">
        <!-- Continuous Timeline Track Spine -->
        <div class="absolute left-2 sm:left-3 top-4 bottom-4 w-[1.5px] bg-gradient-to-b from-cyan-500 via-zinc-200 to-zinc-200 dark:via-zinc-800 dark:to-zinc-800 rounded-full pointer-events-none"></div>

        {researchExperience.map((exp) => {
          const isActive = exp.period.includes('Present');
          return (
            <div class="relative group">
              <!-- Waypoint Milestone Node on the Spine -->
              <div class="absolute -left-5 sm:-left-8 top-7 -translate-x-1/2 flex items-center justify-center">
                {isActive ? (
                  <span class="relative flex h-3.5 w-3.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-60"></span>
                    <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-canvas-light dark:bg-canvas-dark border-2 border-cyan-500 items-center justify-center">
                      <span class="w-1.5 h-1.5 rounded-full bg-cyan-500"></span>
                    </span>
                  </span>
                ) : (
                  <span class="w-3 h-3 rounded-full bg-canvas-light dark:bg-canvas-dark border-2 border-zinc-400 dark:border-zinc-600"></span>
                )}
              </div>

              <!-- Elevated Research Dossier Card -->
              <article class="apple-card group relative p-6 sm:p-8 rounded-2xl bg-white dark:bg-[#121214] border border-black/[0.06] dark:border-white/[0.08] shadow-apple-card dark:shadow-apple-card-dark transition-all hover:border-black/15 dark:hover:border-white/20 space-y-5">
                <!-- Header Row -->
                <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-3 border-b border-black/[0.05] dark:border-white/[0.05] pb-4">
                  <div>
                    <div class="flex items-center gap-2 mb-1">
                      {isActive && (
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 border border-cyan-500/20">
                          <span class="w-1 h-1 rounded-full bg-cyan-500 animate-pulse"></span>
                          <span>ACTIVE RESEARCH</span>
                        </span>
                      )}
                    </div>
                    <h3 class="text-lg sm:text-xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
                      {exp.organization}
                    </h3>
                    <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1">
                      Advisor: <strong class="text-zinc-900 dark:text-zinc-200 font-semibold">{exp.advisor}</strong>
                    </p>
                  </div>

                  <div class="flex flex-wrap items-center gap-2 sm:self-start">
                    <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono font-medium ${
                      isActive
                        ? 'bg-cyan-50 dark:bg-cyan-950/40 text-cyan-800 dark:text-cyan-300 border border-cyan-500/30'
                        : 'bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-black/[0.05] dark:border-white/[0.05]'
                    }`}>
                      <span class={`w-1.5 h-1.5 rounded-full ${isActive ? 'bg-cyan-500' : 'bg-zinc-400 dark:bg-zinc-500'}`}></span>
                      <span>{exp.period}</span>
                    </span>
                    <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
                      {exp.role}
                    </span>
                  </div>
                </div>

                <!-- Body: Project Focus & Narrative Overview -->
                <div class="space-y-3">
                  <h4 class="text-base sm:text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 leading-snug">
                    {exp.projectTitle}
                  </h4>

                  <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed font-sans">
                    {exp.description}
                  </p>

                  <!-- Structured Key Contributions Grid (Clean, Labeled, No Dash Bullets) -->
                  {exp.contributions && (
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3 pt-2">
                      {exp.contributions.map((c) => (
                        <div class="p-3.5 sm:p-4 rounded-xl bg-zinc-50/80 dark:bg-zinc-900/50 border border-black/[0.04] dark:border-white/[0.05] space-y-1.5 flex flex-col justify-between">
                          <div class="flex items-center gap-1.5 text-xs font-semibold text-zinc-900 dark:text-zinc-100">
                            <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 shrink-0"></span>
                            <span>{c.title}</span>
                          </div>
                          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-sans">
                            {c.desc}
                          </p>
                        </div>
                      ))}
                    </div>
                  )}
                </div>

                <!-- Skills & Platforms Pills -->
                <div class="flex flex-wrap gap-1.5 pt-4 border-t border-black/[0.05] dark:border-white/[0.05]">
                  {exp.skills.map((skill) => (
                    <span class="text-[11px] font-mono px-2.5 py-1 rounded-md bg-zinc-100 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300">
                      {skill}
                    </span>
                  ))}
                </div>
              </article>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Section 3: Open-Source Contributions -->
    <section id="open-source" class="space-y-6 pt-10 sm:pt-14 border-t border-black/[0.08] dark:border-white/[0.08]">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold tracking-wider uppercase bg-indigo-500/10 text-indigo-700 dark:text-indigo-400 border border-indigo-500/20">
              03 // SYSTEMS ENGINEERING
            </span>
            <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">Core Upstream Infrastructure</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Open-Source Contributions
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1 max-w-2xl leading-relaxed">
            Upstream systems engineering for global robotics infrastructure, real-time determinism, and concurrency control.
          </p>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400 border border-black/[0.04] dark:border-white/[0.05] shrink-0 self-start sm:self-auto">
          ros2_control • Core Contributor
        </span>
      </div>

      <!-- Opaque ros2_control Framework Card -->
      <article class="apple-card group relative p-6 sm:p-8 rounded-2xl bg-white dark:bg-[#121214] border border-black/[0.06] dark:border-white/[0.08] shadow-apple-card dark:shadow-apple-card-dark transition-all hover:border-black/15 dark:hover:border-white/20 space-y-5">
        <div class="flex flex-col lg:flex-row lg:items-baseline justify-between gap-4 border-b border-black/[0.05] dark:border-white/[0.05] pb-4">
          <div>
            <div class="flex items-center gap-2 text-xs font-mono text-zinc-400 dark:text-zinc-500 mb-1.5">
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>Active Upstream Contributor</span>
              </span>
              <span>•</span>
              <span>Robot Control Infrastructure</span>
            </div>
            <h3 class="text-lg sm:text-xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
              ros2_control: Robot Operating System 2 Control Framework
            </h3>
            <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 mt-0.5">
              Core Framework Contributor • Real-Time Determinism, Controller Chaining & Fault Injection
            </p>
          </div>

          <!-- Direct GitHub Action Links (PRs, Issues, Repository) -->
          <div class="flex flex-wrap items-center gap-2">
            <a
              href="https://github.com/search?q=involves%3Ashlok-mehndiratta+is%3Apr+repo%3Aros-controls%2Fros2_control&type=pullrequests"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-black/[0.08] dark:border-white/[0.08] bg-zinc-50 dark:bg-zinc-800/60 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-xs font-mono text-zinc-700 dark:text-zinc-300 hover:text-cyan-600 dark:hover:text-cyan-400 transition-all shrink-0"
              title="View Pull Requests authored or reviewed by Shlok Mehndiratta in ros2_control"
            >
              <svg class="w-3.5 h-3.5 text-purple-600 dark:text-purple-400" viewBox="0 0 16 16" fill="currentColor"><path d="M7.177 3.073L9.573.677A.25.25 0 0110 .854v4.792a.25.25 0 01-.427.177L7.177 3.427a.25.25 0 010-.354zM3.75 2.5a.75.75 0 100 1.5.75.75 0 000-1.5zm-2.25.75a2.25 2.25 0 113 2.122v5.256a2.251 2.251 0 11-1.5 0V5.372A2.25 2.25 0 011.5 3.25zM11 2.5h-1V4h1a1 1 0 011 1v5.628a2.251 2.251 0 101.5 0V5A2.5 2.5 0 0011 2.5zm1 10.25a.75.75 0 111.5 0 .75.75 0 01-1.5 0zM3.75 12a.75.75 0 100 1.5.75.75 0 000-1.5z"></path></svg>
              <span>Pull Requests (8 PRs)</span>
            </a>

            <a
              href="https://github.com/search?q=involves%3Ashlok-mehndiratta+is%3Aissue+repo%3Aros-controls%2Fros2_control&type=issues"
              target="_blank"
              rel="noopener noreferrer"

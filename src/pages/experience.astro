---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { getCollection } from 'astro:content';

const allPubs = await getCollection('publications');
const sortedPubs = allPubs.sort((a, b) => a.data.order - b.data.order);

const underReviewCount = sortedPubs.filter((p) => p.data.status === 'under-review').length;
const publishedCount = sortedPubs.filter((p) => p.data.status === 'published').length;
const preprintCount = sortedPubs.filter((p) => p.data.status === 'preprint').length;

const appointments = [
  {
    role: 'Undergraduate Thesis Researcher',
    organization: 'IISER Bhopal',
    department: 'Department of Electrical Engineering and Computer Science',
    period: 'Aug 2025 – Present',
    type: 'Research Appointment',
    typeColor: 'text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800/80 border-zinc-200 dark:border-zinc-700/60',
    description: 'Investigating continuous-time manifold regularization for high-dimensional recursive Kalman filtering on dynamic graphs. Proving analytical stability bounds under non-stationary network topologies.',
    highlights: [
      'Formulated Riemannian gradient updates for tracking fluctuating network states.',
      'Achieved 42% reduction in mean-squared tracking error over Kalman-consensus baselines.',
    ],
    skills: ['Graph Signal Processing', 'Recursive Estimation', 'Python', 'NumPy'],
  },
  {
    role: 'Visiting Summer Research Fellow',
    organization: 'Autonomous Systems & Robotics Lab',
    department: 'Visiting Student Fellowship',
    period: 'May 2025 – Jul 2025',
    type: 'Research Fellowship',
    typeColor: 'text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800/80 border-zinc-200 dark:border-zinc-700/60',
    description: 'Developed an asynchronous consensus protocol for multi-robot formations operating under intermittent wireless packet drops and directed graph topologies.',
    highlights: [
      'Validated recovery rates across a 12-node robotic hardware simulation.',
      'Authored a preprint on decentralized learning in asynchronous multi-agent networks.',
    ],
    skills: ['Decentralized Control', 'ROS 2', 'C++20', 'Multi-Agent Networks'],
  },
  {
    role: 'Engineering & Software Intern',
    organization: 'Applied Systems & Computing Lab',
    department: 'Industrial / Systems Track',
    period: 'Dec 2024 – Jan 2025',
    type: 'Industry / Engineering',
    typeColor: 'text-zinc-800 dark:text-zinc-200 bg-zinc-100 dark:bg-zinc-800/80 border-zinc-200 dark:border-zinc-700/60',
    description: 'Implemented high-throughput data processing pipelines for high-rate sensor streams. Profiling and optimizing matrix operations on embedded compute platforms.',
    highlights: [
      'Accelerated linear algebraic solver routines using SIMD vectorization in C++.',
      'Integrated real-time streaming telemetry with sub-millisecond latency bounds.',
    ],
    skills: ['C++', 'Performance Profiling', 'Linux', 'Git', 'Data Pipelines'],
  },
];
---

<BaseLayout
  title="Experience & Research | Shlok Mehndiratta"
  description="Research manuscripts, senior thesis inquiry, and appointments of Shlok Mehndiratta. Senior undergraduate in EECS at IISER Bhopal."
>
  <div class="space-y-12">
    <!-- Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full text-xs font-mono bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-black/[0.06] dark:border-white/[0.08]">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>Trajectory & Research Output</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Experience & Research
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
        My trajectory encompasses peer-reviewed manuscripts, theoretical modeling at IISER Bhopal, visiting research fellowships, and industrial systems engineering internships.
      </p>
    </header>

    <!-- Active Senior Thesis Inquiry (IISER Bhopal) -->
    <section class="p-5 rounded-2xl border border-black/[0.08] dark:border-white/[0.08] bg-surface-light dark:bg-surface-dark shadow-[inset_0_1px_0_0_rgba(255,255,255,0.06)] space-y-2 text-xs sm:text-sm">
      <div class="flex items-center justify-between">
        <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Active Inquiry: Senior Undergraduate Thesis (IISER Bhopal)</span>
        </h3>
        <span class="font-mono text-[11px] text-zinc-500 dark:text-zinc-400">In Progress</span>
      </div>
      <p class="text-zinc-600 dark:text-zinc-300 leading-relaxed">
        Investigating recursive filtering on dynamic Riemannian manifolds. We are proving asymptotic mean-squared error bounds under non-stationary stochastic perturbations and testing scalability against standard distributed Kalman-consensus baselines.
      </p>
    </section>

    <!-- Manuscripts & Papers Section -->
    <section class="space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-black/[0.06] dark:border-white/[0.06] pb-3">
        <div>
          <h2 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            Publications & Preprints
          </h2>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 font-mono mt-0.5">
            Manuscripts under review, proceedings & theoretical preprints
          </p>
        </div>

        <!-- Filter Stats -->
        <div class="flex flex-wrap items-center gap-1.5 text-xs font-mono">
          <span class="px-2.5 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/60">
            Total: {sortedPubs.length}
          </span>
          <span class="px-2.5 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/60">
            Under Review: {underReviewCount}
          </span>
          <span class="px-2.5 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/60">
            Published: {publishedCount}
          </span>
          <span class="px-2.5 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/60">
            Preprints: {preprintCount}
          </span>
        </div>
      </div>

      <div class="space-y-4">
        {sortedPubs.map((pub) => (
          <PublicationCard pub={pub} />
        ))}
      </div>
    </section>

    <!-- Appointments & Internships -->
    <section class="space-y-6 pt-6 border-t border-black/[0.06] dark:border-white/[0.06]">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-3">
        <h2 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Appointments & Internships
        </h2>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 font-mono mt-0.5">
          Research fellowships, industrial systems engagements & institutional roles
        </p>
      </div>

      <div class="space-y-6">
        {appointments.map((apt) => (
          <div class="p-6 rounded-2xl border border-black/[0.08] dark:border-white/[0.08] bg-surface-light dark:bg-surface-dark shadow-[inset_0_1px_0_0_rgba(255,255,255,0.06)] space-y-3 transition-all duration-200 hover:border-black/[0.18] dark:hover:border-white/[0.18]">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1.5">
              <div>
                <span class={`inline-block px-2 py-0.5 text-[10px] font-mono rounded-full border mb-1.5 ${apt.typeColor}`}>
                  {apt.type}
                </span>
                <h3 class="text-base sm:text-lg font-semibold text-zinc-900 dark:text-zinc-100">
                  {apt.role}
                </h3>
                <p class="text-xs font-medium text-zinc-600 dark:text-zinc-400">
                  {apt.organization} • {apt.department}
                </p>
              </div>
              <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500 shrink-0">
                {apt.period}
              </span>
            </div>

            <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
              {apt.description}
            </p>

            {apt.highlights && (
              <ul class="list-disc list-inside space-y-1 text-xs text-zinc-600 dark:text-zinc-400 pt-1">
                {apt.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}

            <div class="flex flex-wrap gap-1.5 pt-2 border-t border-black/[0.04] dark:border-white/[0.04]">
              {apt.skills.map((skill) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Conceptual Influences & Literature -->
    <section class="space-y-4 pt-6 border-t border-black/[0.06] dark:border-white/[0.06]">
      <div class="space-y-1">
        <h2 class="text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Conceptual Influences & Literature
        </h2>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">
          Foundational works and frameworks that shape my mathematical intuition
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div class="p-4 rounded-xl border border-black/[0.06] dark:border-white/[0.06] bg-zinc-50/50 dark:bg-zinc-900/30 space-y-1">
          <h4 class="font-semibold text-zinc-900 dark:text-zinc-100">
            Graph Signal Processing (GSP) Foundations
          </h4>
          <p class="text-zinc-600 dark:text-zinc-400">
            Shuman, Narang, Frossard, Ortega, and Vandergheynst (IEEE Signal Processing Magazine, 2013).
          </p>
          <span class="text-[11px] font-mono text-zinc-400">Harmonics on irregular graph topologies</span>
        </div>

        <div class="p-4 rounded-xl border border-black/[0.06] dark:border-white/[0.06] bg-zinc-50/50 dark:bg-zinc-900/30 space-y-1">
          <h4 class="font-semibold text-zinc-900 dark:text-zinc-100">
            Distributed Optimization via ADMM
          </h4>
          <p class="text-zinc-600 dark:text-zinc-400">
            Stephen Boyd, Neal Parikh, Eric Chu, Borja Peleato, and Jonathan Eckstein (2011).
          </p>
          <span class="text-[11px] font-mono text-zinc-400">Splitting methods for decentralized solving</span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    document.addEventListener('click', function (e) {
      const toggleBtn = e.target.closest('[data-exp-toggle]');
      if (!toggleBtn) return;

      const targetId = toggleBtn.getAttribute('data-exp-toggle');
      if (!targetId) return;

      const detailsEl = document.getElementById(targetId);
      if (!detailsEl) return;

      const isHidden = detailsEl.classList.contains('hidden');
      const chevron = toggleBtn.querySelector('.exp-chevron');
      const textLabel = toggleBtn.querySelector('.exp-toggle-text');

      if (isHidden) {
        detailsEl.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
        if (chevron) chevron.classList.add('rotate-180');
        if (textLabel) {
          const openText = textLabel.getAttribute('data-open');
          if (openText) textLabel.textContent = openText;
        }
      } else {
        detailsEl.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        if (chevron) chevron.classList.remove('rotate-180');
        if (textLabel) {
          const closedText = textLabel.getAttribute('data-closed');
          if (closedText) textLabel.textContent = closedText;
        }
      }
    });
  })();
</script>

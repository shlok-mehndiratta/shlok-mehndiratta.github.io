---
import BaseLayout from '../layouts/BaseLayout.astro';

const educationData = {
  institution: 'Indian Institute of Science Education and Research Bhopal (IISER Bhopal)',
  degree: 'Bachelor of Science in Electrical Engineering & Computer Science (EECS)',
  period: 'August 2023 – Present',
  expectedGrad: 'May 2027',
  cpi: '8.87 / 10.0',
  normalizedCpi: '3.55 / 4.0',
  department: 'Department of Electrical Engineering & Computer Science',
  location: 'Bhopal, Madhya Pradesh, India',
};

const schoolingData = {
  board: 'Central Board of Secondary Education (CBSE)',
  location: 'Roorkee, Uttarakhand, India',
  records: [
    { exam: 'Class XII (Senior Secondary)', score: '95.8%', year: '2023' },
    { exam: 'Class X (Secondary School)', score: '96.8%', year: '2021' },
  ],
};

const researchExperience = [
  {
    id: 'rrc-iiit-hyderabad',
    role: 'Research Intern',
    organization: 'Robotics Research Center (RRC), IIIT Hyderabad',
    advisor: 'Dr. Spandan Roy',
    period: 'April 2026 – Present',
    projectTitle: 'Synthetic Data & Grasp Estimation for Dexterous Robot Hands',
    description: 'Working on synthetic simulation and vision-based grasp estimation for the 16-DoF LEAP Hand. Because physical robot hand experiments are slow to collect, we generate synthetic training data with camera images and contact maps to train grasping policies.',
    contributions: [
      {
        title: 'Synthetic Data Generation',
        desc: 'Built an automated pipeline generating synthetic multi-view RGB-D images and contact heatmaps for multi-object scenes, saved into structured HDF5 files.',
      },
      {
        title: 'Physics & Sensor Simulation',
        desc: 'Tested stable hand grasps in simulation, rendering scenes with path-traced lighting and sensor noise to closely match real camera feeds.',
      },
      {
        title: 'Pipeline Batching & Caching',
        desc: 'Improved rendering throughput across GPUs by organizing batch scenes and caching 3D asset files in memory to avoid repeated loading.',
      },
      {
        title: 'Grasp Affordance Learning',
        desc: 'Trained neural models on simulated data to predict hand approach poses and contact points for grasping objects in cluttered scenes.',
      },
    ],
    skills: ['Python', 'PyTorch', 'Robot Manipulation', '16-DoF LEAP Hand', 'Simulation', 'HDF5'],
  },
  {
    id: 'moon-lab',
    role: 'Undergraduate Research Student',
    organization: 'MOON Lab, IISER Bhopal',
    advisor: 'Dr. P. B. Sujit',
    period: 'May 2026 – Present',
    projectTitle: 'Autonomous Drone Navigation & Multi-Agent Swarms',
    description: 'Working on autonomous navigation and coordination for small drone teams, testing algorithms in simulation and on physical Crazyflie quadrotors in a motion capture arena.',
    contributions: [
      {
        title: 'Camera-Aware Flight Planning',
        desc: 'Developed trajectory planning algorithms that keep targets in the drone camera’s view while avoiding obstacles along the flight path.',
      },
      {
        title: 'Drone Assembly & Arena Integration',
        desc: 'Assembled Crazyflie quadrotors and integrated an OptiTrack motion capture system with ROS 2 for indoor position feedback during flight experiments.',
      },
      {
        title: 'Swarm Coordination',
        desc: 'Investigating decentralized algorithms for drone teams to divide and cover search areas efficiently under limited communication.',
      },
    ],
    skills: ['ROS 2', 'Crazyflie Swarms', 'OptiTrack Mocap', 'Trajectory Planning', 'C++', 'Python'],
  },
  {
    id: 'music-lab',
    role: 'Undergraduate Research Student',
    organization: 'MuSic Lab, IISER Bhopal',
    advisor: 'Dr. Arijit Sen',
    period: 'Sept 2025 – July 2026',
    projectTitle: 'COAST: Perception-Aware Aerial-Ground Tracking',
    description: 'In GPS-denied environments where a drone’s camera acts as the eyes for a ground robot, flying higher gives a wider view of the track but makes camera measurements noisier. We analyzed this trade-off and derived an optimal flight altitude policy to keep the ground robot tracking smoothly.',
    contributions: [
      {
        title: 'Optimal Altitude Analysis',
        desc: 'Modeled how camera noise increases with altitude, and showed that the best flight altitude is the lowest height that keeps the track search area in view.',
      },
      {
        title: 'Ground Control & Event-Triggered Planning',
        desc: 'Implemented Model Predictive Control on the ground robot and an event-triggered planner on the drone that recalculates paths only when needed, cutting computation by 25×.',
      },
      {
        title: 'ROS 2 & Gazebo Simulation',
        desc: 'Built the simulation environment with lane detection, marker tracking, and Kalman filtering, verifying the altitude policy across tracks with different curvatures.',
      },
    ],
    paperLink: 'https://github.com/shlok-mehndiratta/COAST-Code',
    paperLinkLabel: 'COAST Open-Source Code (GitHub) ↗',
    skills: ['ROS 2', 'Gazebo', 'Model Predictive Control', 'Kalman Filter', 'Computer Vision', 'Python'],
  },
  {
    id: 'geoai4cities',
    role: 'Student Research Intern',
    organization: 'GeoAI4Cities Lab',
    advisor: 'Dr. Vaibhav Kumar',
    period: 'Dec 2024 – Jan 2025',
    projectTitle: '3D Point Cloud Segmentation with Graph Neural Networks',
    description: 'Built a machine learning pipeline using graph neural networks to classify 3D LiDAR point cloud scans of urban areas into categories like buildings, roads, and trees.',
    contributions: [
      {
        title: 'Neighborhood Graph Modeling',
        desc: 'Represented 3D point clouds as graphs connecting neighboring points to capture local geometric shapes.',
      },
      {
        title: 'Noise Filtering & Classification',
        desc: 'Used RANSAC filtering to clean up stray sensor noise and trained graph neural networks in PyTorch Geometric to accurately segment urban structures.',
      },
    ],
    skills: ['PyTorch Geometric', 'Open3D', 'RANSAC', 'Python', '3D Point Clouds'],
  },
];

const leadershipExperience = [
  {
    id: 'lead-placement',
    role: 'Student Placement Representative',
    organization: 'EECS Department, IISER Bhopal',
    period: 'Aug 2026 – Present',
    details: '',
    shortDesc: 'Connecting technology companies and research organizations with graduating EECS students for campus placements and internships.',
    highlights: [
      'Coordinating recruitment drives, technical tests, and interview schedules with the institute placement cell.',
      'Organizing peer preparation sessions, including technical mock interviews, coding problem walkthroughs, and resume reviews.',
    ],
  },
  {
    id: 'lead-cnc',
    role: 'Vice Secretary',
    organization: 'Computing and Networking Council (CNC), IISER Bhopal',
    period: 'Aug 2024 – Sept 2025',
    details: 'Vice Secretary (Aug 2024 – Sept 2025) • Student Advisor (Oct 2025 – Present)',
    shortDesc: 'Led a 90-member council team managing computing facilities, coordinating 10+ technical workshops, and driving campus tech initiatives.',
    highlights: [
      'Led a 90-member council team and coordinated 10+ technical workshops, hands-on tutorials, and talks on robotics and software tools.',
      'Managed outreach, content planning, and student engagement initiatives across campus.',
      'Founded the EECS Club at IISER Bhopal to support student-led hardware and robotics projects.',
    ],
  },
  {
    id: 'lead-aarohan',
    role: 'Technical Head',
    organization: 'Aarohan (Annual Techno-Cultural Fest), IISER Bhopal',
    period: 'Nov 2024 – Mar 2025',
    details: '',
    shortDesc: 'Directed the technical team building event platforms and managed technical operations and sponsorship outreach for flagship competitions.',
    highlights: [
      'Directed the technical team in building and managing event-related web platforms, portals, and registration systems for 1,500+ participants.',
      'Oversaw technical logistics, equipment, and live systems to ensure smooth execution of large-scale cultural and technical events.',
      'Actively led corporate outreach and sponsorship initiatives for technical competitions, hackathons, and guest speaker sessions.',
    ],
  },
  {
    id: 'lead-gdg',
    role: 'Web-Dev Lead',
    organization: 'Google Developer Group (GDG On Campus), IISER Bhopal',
    period: 'Aug 2024 – Aug 2025',
    details: '',
    shortDesc: 'Led the development of campus tech projects and web platforms while mentoring students in collaborative software development.',
    highlights: [
      'Led the development and maintenance of campus tech projects and event web platforms.',
      'Mentored students in collaborative software practices, Git version control, and open-source contributions.',
    ],
  },
];

const expSections = [
  { id: 'education', label: 'Education' },
  { id: 'research', label: 'Research' },
  { id: 'open-source', label: 'Open Source' },
  { id: 'leadership', label: 'Leadership' },
];

const experienceSchema = {
  '@type': 'ItemList',
  name: 'Research & Academic Experience of Shlok Mehndiratta',
  itemListElement: researchExperience.map((exp, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'Role',
      roleName: exp.role,
      description: exp.description,
      sponsor: {
        '@type': 'Organization',
        name: exp.organization,
      },
    },
  })),
};
---

<BaseLayout
  title="Experience | Shlok Mehndiratta"
  description="Academic education at IISER Bhopal, research in robotics and control theory, open-source contributions to ROS 2 Control, and departmental leadership."
  sections={expSections}
  schema={experienceSchema}
>
  <div class="space-y-10 sm:space-y-12">
    <!-- Clean Page Header -->
    <header class="pb-4 border-b border-black/[0.08] dark:border-white/[0.08]">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Experience
      </h1>
    </header>

    <!-- Section 1: Education -->
    <section id="education" class="space-y-4">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-3 flex items-baseline justify-between gap-3">
        <h2 class="text-lg sm:text-xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
          Education
        </h2>
        <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
          {educationData.period}
        </span>
      </div>

      <!-- Undergraduate Degree Card (IISER Bhopal) -->
      <article class="apple-card group relative p-5 sm:p-6 md:p-7 rounded-2xl bg-surface-light dark:bg-surface-dark border border-black/[0.06] dark:border-white/[0.08] shadow-apple-card dark:shadow-apple-card-dark transition-all hover:border-black/15 dark:hover:border-white/20 space-y-4">
        <!-- Institution & Degree Header -->
        <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4 border-b border-black/[0.05] dark:border-white/[0.05] pb-3.5">
          <div class="space-y-1 min-w-0">
            <h3 class="text-base sm:text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50 leading-snug">
              {educationData.institution}
            </h3>
            <div class="flex flex-wrap sm:flex-nowrap items-baseline gap-x-2 gap-y-0.5">
              <span class="text-xs sm:text-sm font-semibold text-zinc-800 dark:text-zinc-200">
                {educationData.degree}
              </span>
              <span class="text-[11px] sm:text-xs font-mono text-zinc-500 dark:text-zinc-400 shrink-0">
                (Expected: {educationData.expectedGrad})
              </span>
            </div>
            <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
              {educationData.department} • {educationData.location}
            </p>
          </div>

          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-mono font-medium bg-black/[0.04] dark:bg-white/[0.06] text-zinc-800 dark:text-zinc-200 border border-black/[0.06] dark:border-white/[0.08] shrink-0 self-start">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            <span>{educationData.period}</span>
          </span>
        </div>

        <!-- Minimal, Clean, Distinguishable CPI Metric + Direct Coursework Link in single row -->
        <div class="tactile-plate flex flex-wrap items-center justify-between gap-3 p-2.5 sm:p-3 rounded-xl bg-surfaceSubtle-light/35 dark:bg-white/[0.03] text-xs font-mono">
          <div class="flex items-baseline gap-2">
            <span class="text-zinc-500 dark:text-zinc-400 font-medium">Cumulative CPI:</span>
            <span class="font-bold text-zinc-950 dark:text-zinc-50 text-xs sm:text-sm tracking-tight">{educationData.cpi}</span>
            <span class="text-zinc-500 dark:text-zinc-400 font-medium">({educationData.normalizedCpi})</span>
          </div>
          <a
            href="/projects#coursework"
            class="tactile-btn inline-flex items-center gap-1 font-mono text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-zinc-50 font-medium text-xs px-2.5 py-1 rounded-lg"
          >
            <span>[View coursework details &rarr;]</span>
          </a>
        </div>
      </article>

      <!-- Standalone Pre-University Schooling Card -->
      <article class="apple-card group relative p-4 sm:p-5 md:p-6 md:px-7 rounded-2xl bg-surface-light dark:bg-surface-dark border border-black/[0.06] dark:border-white/[0.08] shadow-apple-card dark:shadow-apple-card-dark transition-all hover:border-black/15 dark:hover:border-white/20">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <div class="flex items-center gap-2">
              <h3 class="text-sm sm:text-base font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
                {schoolingData.board}
              </h3>
              <span class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400">
                • {schoolingData.location}
              </span>
            </div>
            <p class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">
              Pre-University Schooling
            </p>
          </div>

          <div class="flex flex-wrap items-center gap-2">
            {schoolingData.records.map((rec) => (
              <div class="tactile-plate px-2.5 py-1 rounded-lg bg-surfaceSubtle-light/35 dark:bg-white/[0.03] flex items-center gap-2 text-xs font-mono">
                <span class="text-zinc-700 dark:text-zinc-300 font-medium">{rec.exam} ({rec.year}):</span>
                <span class="font-bold text-zinc-950 dark:text-zinc-50">{rec.score}</span>
              </div>
            ))}
          </div>
        </div>
      </article>
    </section>

    <!-- Section 2: Research Experience -->
    <section id="research" class="space-y-4 pt-8 sm:pt-10 border-t border-black/[0.08] dark:border-white/[0.08]">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-3 flex items-baseline justify-between gap-3">
        <h2 class="text-lg sm:text-xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
          Research Experience
        </h2>
        <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
          2024 – Present
        </span>
      </div>

      <!-- Minimal Chronological Spine Layout -->
      <div class="relative space-y-6 sm:space-y-8 min-[1140px]:-ml-28 min-[1140px]:w-[calc(100%+7rem)]">
        <!-- Continuous Timeline Track Spine -->
        <div class="absolute left-2 sm:left-28 md:left-32 top-5 bottom-5 w-[1.5px] bg-black/10 dark:bg-white/10 rounded-full pointer-events-none"></div>

        {researchExperience.map((exp) => {
          const isActive = exp.period.includes('Present');
          const [startDate, endDate] = exp.period.split(/[–—]/).map((s) => s.trim());
          return (
            <div class="relative group flex flex-col sm:flex-row sm:items-start">
              <!-- Left Side: Chronological Date Anchor (2 Lines: Start Date on 1st, End Date on 2nd) -->
              <div class="hidden sm:flex flex-col items-end w-28 md:w-32 pr-4 pt-6 shrink-0 text-right select-none font-mono">
                <span class={`text-xs font-semibold tracking-tight ${
                  isActive ? 'text-zinc-950 dark:text-zinc-50' : 'text-zinc-700 dark:text-zinc-300'
                }`}>
                  {startDate}
                </span>
                <div class="flex items-center gap-1.5 mt-0.5">
                  {isActive && <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>}
                  <span class={`text-[11px] font-medium ${
                    isActive ? 'text-emerald-700 dark:text-emerald-400 font-semibold' : 'text-zinc-500 dark:text-zinc-400'
                  }`}>
                    – {endDate}
                  </span>
                </div>
              </div>

              <!-- Waypoint Milestone Node on the Spine -->
              <div class="absolute left-2 sm:left-28 md:left-32 top-7 -translate-x-1/2 flex items-center justify-center z-10">
                {isActive ? (
                  <span class="relative flex h-3.5 w-3.5">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-30"></span>
                    <span class="relative inline-flex rounded-full h-3.5 w-3.5 bg-canvas-light dark:bg-canvas-dark border-2 border-emerald-500 items-center justify-center">
                      <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                    </span>
                  </span>
                ) : (
                  <span class="w-2.5 h-2.5 rounded-full bg-canvas-light dark:bg-canvas-dark border-2 border-zinc-400 dark:border-zinc-500"></span>
                )}
              </div>

              <!-- Mobile Date Badge (< sm:) -->
              <div class="sm:hidden pl-6 pb-2 flex items-center gap-2">
                <span class={`inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[11px] font-mono font-medium ${
                  isActive
                    ? 'bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 border border-emerald-500/20'
                    : 'bg-black/[0.04] dark:bg-white/[0.06] text-zinc-700 dark:text-zinc-300'
                }`}>
                  {isActive && <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>}
                  <span>{startDate} – {endDate}</span>
                </span>
              </div>

              <!-- Main Content Card (Expands smoothly) -->
              <div class="flex-1 min-w-0 pl-6 sm:pl-7">
                <article class="apple-card group relative p-5 sm:p-6 rounded-2xl bg-surface-light dark:bg-surface-dark border border-black/[0.06] dark:border-white/[0.08] shadow-apple-card dark:shadow-apple-card-dark transition-all hover:border-black/15 dark:hover:border-white/20 space-y-3.5">
                  <!-- Header Row: Organization & Role -->
                  <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-2.5 border-b border-black/[0.05] dark:border-white/[0.05] pb-3">
                    <div>
                      <h3 class="text-base sm:text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50 leading-snug">
                        {exp.organization}
                      </h3>
                      <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">
                        Advisor: <span class="font-serif italic font-medium text-zinc-800 dark:text-zinc-200">{exp.advisor}</span>
                      </p>
                    </div>

                    <div class="flex items-center gap-2 self-start">
                      <span class="text-xs font-mono font-medium text-zinc-700 dark:text-zinc-300 px-2 py-0.5 rounded bg-black/[0.03] dark:bg-white/[0.05] border border-black/[0.05] dark:border-white/[0.06]">
                        {exp.role}
                      </span>
                    </div>
                  </div>

                  <!-- Core Project Overview (Always Visible) -->
                  <div class="space-y-1.5">
                    <h4 class="text-sm sm:text-base font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 leading-snug">
                      {exp.projectTitle}
                    </h4>
                    <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed font-sans">
                      {exp.description}
                    </p>
                  </div>

                  <!-- Collapsible Technical Investigations Drawer -->
                  <div id={`details-${exp.id}`} class="exp-drawer hidden pt-3 border-t border-black/[0.05] dark:border-white/[0.05] space-y-2.5">
                    <span class="text-[10px] font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500 font-semibold block">
                      Technical Investigations & Contributions
                    </span>
                    <div class="space-y-2">
                      {exp.contributions.map((c) => (
                        <div class="text-xs sm:text-[13px] text-zinc-700 dark:text-zinc-300 leading-relaxed font-sans pl-3 border-l-2 border-zinc-300 dark:border-zinc-700 space-y-1.5">
                          <div>
                            <strong class="font-semibold text-zinc-950 dark:text-zinc-100">{c.title}:</strong>{' '}
                            <span class="text-zinc-600 dark:text-zinc-400">{c.desc}</span>
                          </div>
                          {c.bullets && c.bullets.length > 0 && (
                            <ul class="space-y-1 pl-3.5 list-disc text-xs text-zinc-600 dark:text-zinc-400 font-sans">
                              {c.bullets.map((b) => (
                                <li class="leading-relaxed">
                                  <span>{b}</span>
                                </li>
                              ))}
                            </ul>
                          )}
                        </div>
                      ))}
                    </div>

                    {exp.paperLink && (
                      <div class="pt-2.5 border-t border-black/[0.05] dark:border-white/[0.05] flex items-center gap-3 text-xs font-mono">
                        <a
                          href={exp.paperLink}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 text-zinc-800 dark:text-zinc-200 hover:text-zinc-950 dark:hover:text-zinc-50 font-medium underline underline-offset-4 decoration-zinc-400 dark:decoration-zinc-600 transition-colors"
                        >
                          <span>{exp.paperLinkLabel || 'Paper, Code & Data ↗'}</span>
                        </a>
                      </div>
                    )}
                  </div>

                  <!-- Card Bottom Bar: Skills Chips (Left) & Collapsible Toggle (Right) -->
                  <div class="pt-3 border-t border-black/[0.05] dark:border-white/[0.05] flex flex-wrap items-center justify-between gap-2.5">
                    <div class="flex flex-wrap gap-1.5">
                      {exp.skills.map((skill) => (
                        <span class="tech-chip text-[10px] sm:text-[11px] font-mono px-2 py-0.5 rounded-md">
                          {skill}
                        </span>
                      ))}
                    </div>

                    <button
                      type="button"
                      data-exp-toggle={`details-${exp.id}`}
                      class="exp-toggle-btn tactile-btn inline-flex items-center gap-1.5 text-xs font-mono text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-zinc-50 px-2.5 py-1 rounded-lg font-medium shrink-0 ml-auto cursor-pointer"
                      aria-expanded="false"
                    >
                      <span class="exp-toggle-text" data-closed="Technical Details" data-open="Hide Details">Technical Details</span>
                      <svg class="w-3.5 h-3.5 transform transition-transform duration-200 exp-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </button>
                  </div>
                </article>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Section 3: Open-Source Contributions -->
    <section id="open-source" class="space-y-4 pt-8 sm:pt-10 border-t border-black/[0.08] dark:border-white/[0.08]">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-3 flex items-baseline justify-between gap-3">
        <h2 class="text-lg sm:text-xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
          Open Source
        </h2>
        <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
          ros2_control • Contributor
        </span>
      </div>

      <!-- Collapsible ros2_control Framework Card -->
      <article class="apple-card group relative p-5 sm:p-6 rounded-2xl bg-surface-light dark:bg-surface-dark border border-black/[0.06] dark:border-white/[0.08] shadow-apple-card dark:shadow-apple-card-dark transition-all hover:border-black/15 dark:hover:border-white/20 space-y-3.5">
        <div class="flex flex-col lg:flex-row lg:items-baseline justify-between gap-3 border-b border-black/[0.05] dark:border-white/[0.05] pb-3">
          <div>
            <h3 class="text-base sm:text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
              ros2_control: Robot Operating System 2 Control Framework
            </h3>
            <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400 mt-0.5">
              Real-Time Determinism, Controller Chaining & Fault Injection
            </p>
          </div>

          <!-- Direct GitHub Action Links (PRs, Issues, Repository) -->
          <div class="flex flex-wrap items-center gap-2">
            <a
              href="https://github.com/search?q=involves%3Ashlok-mehndiratta+is%3Apr+repo%3Aros-controls%2Fros2_control&type=pullrequests"
              target="_blank"
              rel="noopener noreferrer"

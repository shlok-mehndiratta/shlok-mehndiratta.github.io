const projectSections = [
  { id: 'projects', label: 'Projects' },
  { id: 'coursework', label: 'Coursework' },
  { id: 'certifications', label: 'Certifications' },
];

const projectsSchema = {
  '@type': 'ItemList',
  name: 'Engineering Projects by Shlok Mehndiratta',
  description: 'Robotics, control systems, and computer vision projects developed by Shlok Mehndiratta.',
  itemListElement: engineeringProjects.map((p, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'SoftwareSourceCode',
      name: p.title,
      description: p.shortSummary,
      programmingLanguage: p.tech,
      codeRepository: p.github,
      author: {
        '@type': 'Person',
        '@id': 'https://shlokmehndiratta.me/#person',
        name: 'Shlok Mehndiratta',
      },
    },
  })),
};
---

<BaseLayout
  title="Projects | Shlok Mehndiratta"
  description="Technical projects, academic coursework at IISER Bhopal, and specialized certifications by Shlok Mehndiratta."
  sections={projectSections}
  schema={projectsSchema}
>
  <!-- Content Container (Balanced and Centered) -->
  <div class="space-y-12 sm:space-y-16">
    <!-- Clean Personalized Page Header -->
    <header class="pb-4 border-b border-black/[0.08] dark:border-white/[0.08]">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Projects & Coursework
      </h1>
      <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1 max-w-2xl leading-relaxed font-sans">
        A collection of projects I have built and courses I have taken during my degree at IISER Bhopal. I enjoy working at the intersection of robotics, control, computer vision, and software, taking mathematical ideas and turning them into working systems.
      </p>
    </header>

    <!-- Stream 1: Technical Projects -->
    <section id="projects" class="space-y-5">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-3">
        <div>
          <h2 class="text-lg sm:text-xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Featured Projects
          </h2>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">
            Systems I have designed and built across robotics, vision, and software.
          </p>
        </div>

        <!-- Minimal Monochrome Category Filter -->
        <div class="flex flex-wrap items-center gap-1.5" id="project-filters">
          <button
            type="button"
            data-filter="all"
            class="filter-btn active px-2.5 py-1 rounded-lg text-xs font-mono font-medium"
          >
            All (6)
          </button>
          <button
            type="button"
            data-filter="robotics-embedded"
            class="filter-btn px-2.5 py-1 rounded-lg text-xs font-mono font-medium"
          >
            Robotics & Hardware (2)
          </button>
          <button
            type="button"
            data-filter="vision-ml"
            class="filter-btn px-2.5 py-1 rounded-lg text-xs font-mono font-medium"
          >
            Vision & ML (2)
          </button>
          <button
            type="button"
            data-filter="software-systems"
            class="filter-btn px-2.5 py-1 rounded-lg text-xs font-mono font-medium"
          >
            Software & Systems (2)
          </button>
        </div>
      </div>

      <!-- Architectural Technical Ledger Stream (Open, Unboxed, Monograph Style) -->
      <div class="divide-y divide-black/[0.08] dark:divide-white/[0.08] border-t border-black/[0.08] dark:border-white/[0.08]" id="projects-stream">
        {engineeringProjects.map((proj, idx) => {
          const indexNum = String(idx + 1).padStart(2, '0');
          return (
            <article
              data-project-item
              data-category={proj.filterCategory}
              class="project-entry py-8 sm:py-10 first:pt-6 last:pb-4 group transition-colors"
            >
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 sm:gap-8 items-start">
                <!-- Mobile-first Title & Index Header (< lg) -->
                <div class="lg:hidden space-y-2">
                  <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-2.5">
                      <span class="proj-index-number font-mono text-xl sm:text-2xl font-semibold text-zinc-800 dark:text-zinc-100 tracking-tight select-none">
                        {indexNum}
                      </span>
                      <span class="tech-chip text-[10px] font-mono uppercase tracking-wider font-semibold px-2 py-0.5 rounded">
                        {proj.category}
                      </span>
                    </div>
                    <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">{proj.period}</span>
                  </div>
                  <h3 class="text-base font-bold tracking-tight text-zinc-950 dark:text-zinc-50 leading-snug">
                    {proj.title}
                  </h3>
                  <div class="text-xs font-mono text-zinc-600 dark:text-zinc-400">{proj.location}</div>
                </div>

                <!-- Left Rail: Monospace Index & Context (Desktop >= lg) -->
                <div class="hidden lg:block lg:col-span-4 space-y-3">
                  <div class="flex items-baseline gap-3">
                    <span class="proj-index-number font-mono text-2xl sm:text-3xl font-semibold text-zinc-800 dark:text-zinc-100 tracking-tight select-none">
                      {indexNum}
                    </span>
                    <span class="tech-chip text-[10px] sm:text-[11px] font-mono uppercase tracking-wider font-semibold px-2 py-0.5 rounded">
                      {proj.category}
                    </span>
                  </div>

                  <div class="text-xs font-mono space-y-0.5">
                    <div class="text-zinc-800 dark:text-zinc-200 font-medium">{proj.location}</div>
                    <div class="text-zinc-500 dark:text-zinc-400">{proj.period}</div>
                  </div>

                  <!-- Inline Tech Stack Tags -->
                  <div class="pt-1 flex flex-wrap gap-1.5">
                    {proj.tech.map((t) => (
                      <span class="tech-chip text-[10px] font-mono px-2 py-0.5 rounded">
                        {t}
                      </span>
                    ))}
                  </div>

                  <!-- External Links -->
                  <div class="pt-1">
                    {proj.notebookLink ? (
                      <a
                        href={proj.notebookLink}
                        class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-900 dark:text-zinc-100 font-medium underline decoration-zinc-400 hover:decoration-zinc-950 dark:hover:decoration-zinc-50 transition-colors"
                      >
                        <span>Read notebook essay</span>
                        <span>&rarr;</span>
                      </a>
                    ) : proj.github ? (
                      <a
                        href={proj.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors"
                      >
                        <span>View on GitHub</span>
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                      </a>
                    ) : null}
                  </div>
                </div>

                <!-- Right Rail: Project Narrative & Overview -->
                <div class="lg:col-span-8 space-y-3.5">
                  <!-- Title (Desktop >= lg) -->
                  <h3 class="hidden lg:block text-base sm:text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50 leading-snug">
                    {proj.title}
                  </h3>

                  <!-- Plain English Summary (Always Visible Overview) -->
                  <p class="text-xs sm:text-sm text-zinc-700 dark:text-zinc-300 leading-relaxed font-sans">
                    {proj.shortSummary}
                  </p>

                  <!-- Inline Tech Stack Tags & Links for Mobile (< lg) -->
                  <div class="lg:hidden space-y-2 pt-0.5">
                    <div class="flex flex-wrap gap-1.5">
                      {proj.tech.map((t) => (
                        <span class="tech-chip text-[10px] font-mono px-2 py-0.5 rounded">
                          {t}
                        </span>
                      ))}
                    </div>
                    {proj.notebookLink ? (
                      <div>
                        <a
                          href={proj.notebookLink}
                          class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-900 dark:text-zinc-100 font-medium underline decoration-zinc-400 hover:decoration-zinc-950 dark:hover:decoration-zinc-50 transition-colors"
                        >
                          <span>Read notebook essay</span>
                          <span>&rarr;</span>
                        </a>
                      </div>
                    ) : proj.github ? (
                      <div>
                        <a
                          href={proj.github}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors"
                        >
                          <span>View on GitHub</span>
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                        </a>
                      </div>
                    ) : null}
                  </div>

                  <!-- Collapsible Details Dropdown -->
                  <details class="group/proj-drawer pt-1">
                    <summary class="tactile-btn list-none [&::-webkit-details-marker]:hidden inline-flex items-center gap-2 px-3 py-1.5 rounded-lg text-xs font-mono font-medium cursor-pointer select-none">
                      <span class="group-open/proj-drawer:hidden flex items-center gap-1.5">
                        <span>View details & architecture</span>
                      </span>
                      <span class="hidden group-open/proj-drawer:inline-flex items-center gap-1.5">
                        <span>Hide details</span>
                      </span>
                      <svg
                        class="w-3.5 h-3.5 text-zinc-400 group-hover/proj-drawer:text-zinc-700 dark:group-hover/proj-drawer:text-zinc-200 transition-transform duration-200 group-open/proj-drawer:rotate-180"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </summary>

                    <!-- Detailed Drawer: Revealed on Click -->
                    <div class="pt-3.5 space-y-3.5 border-t border-black/[0.05] dark:border-white/[0.05] mt-3">
                      <!-- Direct Implementation Highlights -->
                      <div class="space-y-2">
                        <div class="text-[10px] font-mono uppercase tracking-wider text-zinc-400 dark:text-zinc-500 font-semibold select-none">
                          What I built & tested
                        </div>
                        <ul class="space-y-2 text-xs sm:text-[13px] text-zinc-700 dark:text-zinc-300 font-sans leading-relaxed">
                          {proj.highlights.map((h) => (
                            <li class="flex items-start gap-2.5">
                              <span class="text-zinc-400 dark:text-zinc-500 font-mono text-xs shrink-0 select-none mt-0.5">•</span>
                              <span>{h}</span>
                            </li>
                          ))}
                        </ul>
                      </div>

                      <!-- Key Takeaway / Insight Callout -->
                      {proj.outcome && (
                        <div class="pt-2.5 border-t border-black/[0.06] dark:border-white/[0.06] text-xs text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed">
                          <span class="font-semibold text-zinc-900 dark:text-zinc-100 font-mono text-[11px] uppercase tracking-wide mr-1.5 select-none">
                            Key takeaway:
                          </span>
                          <span>{proj.outcome}</span>
                        </div>
                      )}
                    </div>
                  </details>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>

    <!-- Stream 2: Academic Coursework Matrix (Expansive Split-Rail Stream) -->
    <section id="coursework" class="space-y-6 pt-8 sm:pt-10 border-t border-black/[0.08] dark:border-white/[0.08] scroll-mt-24 sm:scroll-mt-28">
      <!-- Section Header -->
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-3 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-lg sm:text-xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
              Academic Coursework
            </h2>
            <span class="text-[10px] font-mono font-medium px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 inline-flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              47 Courses Total
            </span>
          </div>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">
            Current ongoing courses and completed curriculum tracks from my Electrical Engineering & Computer Science degree at IISER Bhopal.
          </p>
        </div>
        <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
          IISER Bhopal EECS
        </span>
      </div>

      <!-- Expansive 12-Column Split Rail (Matching Featured Projects Architecture) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start">
        <!-- Left Rail (lg:col-span-4): Disciplines Index -->
        <div class="lg:col-span-4 space-y-2.5">
          <div class="text-xs font-mono uppercase tracking-wider text-zinc-700 dark:text-zinc-400 font-bold select-none pb-1">

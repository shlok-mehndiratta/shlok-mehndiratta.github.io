          <nav class="flex flex-col space-y-2" id="coursework-nav" aria-label="Coursework disciplines">
            {courseworkDisciplines.map((cat, idx) => (
              <button
                type="button"
                data-discipline-target={idx}
                class={`course-nav-btn group text-left px-3.5 py-2.5 rounded-xl transition-all flex items-center justify-between border cursor-pointer ${
                  idx === 0
                    ? 'active bg-zinc-950 text-white dark:bg-zinc-100 dark:text-zinc-950 border-zinc-950 dark:border-zinc-100 shadow-[0_2px_8px_rgba(31,22,15,0.25),inset_0_1px_0_rgba(255,255,255,0.15)] font-semibold'
                    : 'text-zinc-900 dark:text-zinc-200 bg-surface-light dark:bg-surface-dark border-border-subtle shadow-[0_1px_3px_rgba(35,22,12,0.05),inset_0_1px_0_rgba(255,255,255,0.7)] hover:bg-white dark:hover:bg-white/[0.06] hover:border-border-hover hover:-translate-y-0.5'

  { code: 'ECO101', name: 'Principles of Economics I' },
  { code: 'ECO102', name: 'Principles of Economics II' },
  { code: 'ECO201', name: 'Econometrics I' },
  { code: 'HSS105', name: 'Advanced Academic Communication Skills' },
  { code: 'IPR500', name: 'Law Relating to Intellectual Property and Patents' },
  { code: 'PT101', name: 'Physical Training' },
];

const certifications = [
  {
    title: 'Quantum Computing Program',
    issuer: 'C-DAC & IIT Roorkee (Supported by MeitY)',
    credentialId: 'CDACH/QML/275',
    period: 'June 2025',
    description: 'Completed a 4-week program on Quantum Computing, jointly conducted by C-DAC and IIT Roorkee with support from MeitY. Covered fundamentals of qubits, quantum gates, entanglement, and teleportation, along with hands-on practice in quantum simulators, quantum algorithms (Deutsch–Jozsa, Simon’s, Grover’s, HHL), and an introduction to Quantum Machine Learning (QML).',
    skills: ['Quantum Computing', 'Qubit Gates & Circuits', 'Grover & HHL Algorithms', 'Quantum Simulators', 'QML Introduction', 'Python'],
    linkText: 'Credential CDACH/QML/275',
  },
  {
    title: "CS50's Web Programming with Python and JavaScript",
    issuer: 'Harvard University (edX)',
    credentialId: 'Verified Certificate',
    period: '2024 – 2025',
    description: 'A hands-on software engineering program from Harvard. Covered building complete web applications from scratch, including Django backends, relational SQL databases, interactive JavaScript frontends, user authentication, automated testing, and web security.',
    skills: ['Django', 'Python', 'JavaScript', 'SQL & Django ORM', 'REST APIs', 'CI/CD & Testing', 'Web Security'],
    link: '/notebook/cs50-web-systems-journey',
    linkText: 'Read my notebook reflection →',
  },
  {
    title: 'Infosys Springboard Virtual Internship 6.0',
    issuer: 'Infosys Springboard',
    credentialId: 'Virtual Internship 6.0',
    period: '2024',
    description: 'Completed a virtual internship focused on developing practical AI applications. Built the Car Lease and Loan Contract Review Assistant, combining large language models for clause extraction with a FastAPI backend and a Flutter mobile app.',
    skills: ['Large Language Models (LLMs)', 'FastAPI', 'Flutter', 'Docker', 'Python', 'REST APIs'],
    linkText: 'Verified Track Completion',
  },

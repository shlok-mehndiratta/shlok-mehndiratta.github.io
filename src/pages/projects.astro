const otherCourses = [
  { code: 'CHE103', name: 'Engineering Design and Drawing' },
  { code: 'CHM101', name: 'General Chemistry' },
  { code: 'CHM112', name: 'Basic Organic Chemistry I' },
  { code: 'CHM114', name: 'Chemistry Laboratory I' },

  { code: 'PHY106', name: 'Quantum Physics' },
  { code: 'PHY206', name: 'Physics Through Computational Thinking' },
  { code: 'EES101', name: 'Earth Materials and Processes' },
  { code: 'EES102', name: 'Introduction to Environmental Sciences' },
  { code: 'CHE201', name: 'Engineering Mechanics (Solid and Fluid)' },
  { code: 'CHE204', name: 'Chemical Process Calculations' },
  { code: 'CHE205', name: 'Chemical Engineering Thermodynamics' },

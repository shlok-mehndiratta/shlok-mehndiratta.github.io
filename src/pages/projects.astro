---
import BaseLayout from '../layouts/BaseLayout.astro';

const engineeringProjects = [
  {
    id: 'mpc-ekf-tracking',
    title: 'Mobile Robot Tracking with MPC and Kalman Filter',
    filterCategory: 'robotics-embedded',
    category: 'Robotics & Control',
    location: 'IISER Bhopal',
    period: '2025 – 2026',
    shortSummary: 'I built a navigation system for a mobile robot in ROS 2 and Gazebo. It tracks the robot’s position with a Kalman filter and uses predictive control so it steers smoothly around sharp turns without slipping.',
    highlights: [
      'Simulated a two-wheeled mobile robot in Gazebo and connected all sensors and controllers using ROS 2 nodes.',
      'Fused noisy camera data and IMU measurements with an Extended Kalman Filter so the robot can estimate its exact position without GPS.',
      'Implemented Model Predictive Control (MPC) to plan steering and speed commands ahead of time, accounting for motor limits so the wheels don’t skid.',
      'Tested the system against traditional controllers like Stanley and Pure Pursuit to make sure the robot stays stable on tight corners.',
    ],
    outcome: 'Kept the robot steady on sharp turns by making sure the controller respects the physical limits of the motors.',
    tech: ['ROS 2', 'Gazebo', 'Kalman Filter', 'Model Predictive Control', 'C++', 'Python'],
    github: 'https://github.com/shlok-mehndiratta',
  },
  {
    id: 'digital-design-assembly',
    title: 'Digital Circuits & Bare-Metal Assembly Workshop',
    filterCategory: 'robotics-embedded',
    category: 'Embedded & Hardware',
    location: 'IIT Hyderabad (with Dr. G V V Sharma)',
    period: 'Oct – Nov 2025',
    shortSummary: 'I designed core digital circuits and programmed an Arduino using low-level assembly code and direct register access, skipping external libraries entirely.',
    highlights: [
      'Wrote AVR assembly code from scratch and wrote directly to hardware registers to control clock timers, inputs, and output pins.',
      'Designed digital building blocks including decade counters, 4-to-7 line decoders, and logic gates.',
      'Wired physical circuits on a breadboard to drive seven-segment displays with precise hardware timing.',
    ],
    outcome: 'Gained a deep, hands-on understanding of how microcontrollers execute code at the register and machine level.',
    tech: ['AVR Assembly', 'Direct Registers', 'Arduino', 'Digital Circuits', 'Breadboard Prototyping'],
    github: 'https://github.com/shlok-mehndiratta',
  },
  {
    id: 'graph-pointcloud-segmentation',
    title: '3D Point Cloud Segmentation with Graph Neural Networks',
    filterCategory: 'vision-ml',
    category: 'Computer Vision & ML',
    location: 'GeoAI4Cities Lab (Advisor: Dr. Vaibhav Kumar)',
    period: 'Dec 2024 – Jan 2025',
    shortSummary: 'I developed a machine learning pipeline that uses graph neural networks to label large 3D urban LiDAR scans, helping computers tell buildings, roads, and trees apart.',
    highlights: [
      'Represented 3D point clouds as graphs where each point connects to its nearest geometric neighbors to capture surrounding shapes.',
      'Applied RANSAC geometric filtering to clean up sensor reflections and stray noise before running predictions.',
      'Trained a graph neural network in PyTorch Geometric, outperforming standard point-by-point classifiers in complex city scenes.',
    ],
    outcome: 'Showed that learning from local geometric neighbors produces much cleaner 3D boundaries than treating points in isolation.',
    tech: ['PyTorch Geometric', 'Open3D', 'RANSAC', 'Python', '3D Vision'],
    github: 'https://github.com/shlok-mehndiratta',
  },
  {
    id: 'oil-spill-detection',
    title: 'Detecting Maritime Oil Spills with Satellite Imagery',
    filterCategory: 'vision-ml',
    category: 'Remote Sensing & Vision',
    location: 'Smart India Hackathon • Dept. of Earth Sciences',
    period: '2024',
    shortSummary: 'Built an automated system for maritime authorities that spots suspicious ship movements and verifies potential oil leaks using European Space Agency radar satellites.',
    highlights: [
      'Analyzed live vessel tracking data (AIS) to flag ships behaving abnormally, such as making sudden unplanned stops or loops in open water.',
      'Fetched matching Sentinel-1 radar (SAR) satellite imagery to inspect the ocean surface around those ships, working day or night and through clouds.',
      'Used computer vision to tell real oil slicks apart from natural look-alikes like seaweed patches or calm waters.',
    ],
    outcome: 'Delivered a prototype that helps maritime authorities verify potential pollution events in a few hours rather than days.',
    tech: ['Python', 'Computer Vision', 'Sentinel-1 SAR', 'AIS Data', 'OpenCV', 'TensorFlow'],
    github: 'https://github.com/shlok-mehndiratta',
  },
  {
    id: 'cs50-web-suite',
    title: 'Full-Stack Web Systems Suite',
    filterCategory: 'software-systems',
    category: 'Software Systems',
    location: 'Harvard University CS50 Web',
    period: 'Jan 2024 – Jun 2025',
    shortSummary: 'I built five full-stack web applications to master how databases, asynchronous APIs, authentication, and state management work together in production.',
    highlights: [
      'Built a single-page email client in JavaScript that loads, archives, and replies to emails dynamically without refreshing the page.',
      'Developed an online auction marketplace with real-time bidding, user watchlists, and listing management using Django and SQL.',
      'Created a social network with user following and paginated feeds, an editable encyclopedia using Markdown, and a search engine interface.',
    ],
    outcome: 'Built a rock-solid foundation in backend architecture, relational database modeling, and frontend APIs. I also wrote a detailed reflection notebook essay about the journey.',
    tech: ['Django', 'JavaScript', 'PostgreSQL', 'REST APIs', 'Python', 'HTML/CSS'],
    notebookLink: '/notebook/cs50-web-systems-journey',
  },
  {
    id: 'contract-review-assistant',
    title: 'AI Assistant for Car Lease & Loan Contracts',
    filterCategory: 'software-systems',
    category: 'AI & Web Applications',
    location: 'Infosys Springboard Virtual Internship 6.0',
    period: '2024',
    shortSummary: 'I created a mobile-friendly AI assistant that helps everyday buyers make sense of complicated car financing agreements, spot hidden fees, and negotiate better deals.',
    highlights: [
      'Used large language models to read lengthy loan and lease agreements and automatically highlight interest rates, mileage caps, and early exit penalties.',
      'Integrated public car pricing databases so buyers can check whether the dealer is offering a fair market price.',
      'Built a fast backend with FastAPI and Docker, paired with a clean, responsive Flutter mobile app for easy document uploads.',
    ],
    outcome: 'Turned confusing multi-page auto finance contracts into clear, plain-English summaries so buyers can make smart financial decisions.',
    tech: ['FastAPI', 'Flutter', 'Docker', 'Python', 'LLMs', 'REST APIs'],
    github: 'https://github.com/shlok-mehndiratta',
  },
];

const courseworkDisciplines = [

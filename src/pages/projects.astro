                </div>
                <span class="font-mono text-[10px] text-zinc-700 dark:text-zinc-300 font-semibold bg-black/[0.05] dark:bg-white/[0.07] px-2 py-0.5 rounded ml-2 shrink-0">
                  {cat.courses.length}
                </span>
              </button>
            ))}

            <!-- Foundations & Breadth -->
            <button
              type="button"
              data-discipline-target={courseworkDisciplines.length}
              class="course-nav-btn group text-left px-3.5 py-2.5 rounded-xl transition-all flex items-center justify-between border text-zinc-900 dark:text-zinc-200 bg-surface-light dark:bg-surface-dark border-border-subtle shadow-[0_1px_3px_rgba(35,22,12,0.05),inset_0_1px_0_rgba(255,255,255,0.7)] hover:bg-white dark:hover:bg-white/[0.06] hover:border-border-hover hover:-translate-y-0.5 cursor-pointer"
            >
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="font-mono text-xs font-extrabold text-zinc-950 dark:text-zinc-100 select-none">
                  0{courseworkDisciplines.length + 1}
                </span>
                <span class="text-xs sm:text-[13px] font-semibold truncate">
                  Natural Sciences & Breadth
                </span>
              </div>
              <span class="font-mono text-[10px] text-zinc-700 dark:text-zinc-300 font-semibold bg-black/[0.05] dark:bg-white/[0.07] px-2 py-0.5 rounded ml-2 shrink-0">
                {otherCourses.length}
              </span>
            </button>
          </nav>
        </div>

        <!-- Right Rail (lg:col-span-8 - Expands Fully to the Right Edge!) -->
        <div class="lg:col-span-8 w-full min-w-0">
          <div id="coursework-panels">
            {courseworkDisciplines.map((cat, idx) => (
              <div
                data-discipline-panel={idx}
                class={`discipline-panel space-y-4 ${idx === 0 ? '' : 'hidden'}`}
              >
                <!-- Panel Header -->
                <div class="border-b border-black/[0.05] dark:border-white/[0.06] pb-2.5 flex items-baseline justify-between gap-3">
                  <div>
                    <h3 class="text-base sm:text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50 flex items-center gap-2">
                      <span>{cat.discipline}</span>
                      {cat.isOngoing && (
                        <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20 font-medium">
                          Active Semester
                        </span>
                      )}
                    </h3>
                    <p class="text-xs text-zinc-500 dark:text-zinc-400 font-sans mt-0.5">
                      {cat.description}
                    </p>
                  </div>
                  <span class="font-mono text-[11px] text-zinc-400 dark:text-zinc-500 shrink-0">
                    {cat.courses.length} Courses
                  </span>
                </div>

                <!-- Expansive 2-Column Course Cards Grid (Fills 100% of Right Space!) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-3.5">
                  {cat.courses.map((course) => (
                    <div class="apple-card p-3.5 sm:p-4 rounded-xl bg-surface-light dark:bg-surface-dark border border-black/[0.06] dark:border-white/[0.08] shadow-apple-card dark:shadow-apple-card-dark flex flex-col justify-between space-y-2.5 hover:border-black/15 dark:hover:border-white/15 transition-all">
                      <div class="space-y-1.5">
                        <div class="flex items-start justify-between gap-2">
                          <h4 class="text-xs sm:text-[13px] font-semibold text-zinc-900 dark:text-zinc-100 tracking-tight leading-snug">
                            {course.name}
                          </h4>
                          <div class="flex items-center gap-1.5 shrink-0">
                            {course.status && (
                              <span class="inline-flex items-center gap-1 text-[9px] font-mono uppercase tracking-wider text-emerald-700 dark:text-emerald-400 bg-emerald-500/10 dark:bg-emerald-500/15 border border-emerald-500/20 px-1.5 py-0.5 rounded font-semibold">
                                <span class="w-1 h-1 rounded-full bg-emerald-500 animate-pulse"></span>
                                {course.status}
                              </span>
                            )}
                            <span class="font-mono text-[10px] text-zinc-600 dark:text-zinc-400 bg-black/[0.03] dark:bg-white/[0.05] border border-black/[0.05] dark:border-white/[0.06] px-1.5 py-0.5 rounded font-medium">
                              {course.code}
                            </span>
                          </div>
                        </div>
                        {course.instructor && (
                          <div class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400 flex items-center gap-1">
                            <span class="text-zinc-400 dark:text-zinc-500">Instructor:</span>
                            <span class="text-zinc-700 dark:text-zinc-300 font-medium">{course.instructor}</span>
                          </div>
                        )}
                        <p class="text-[11px] text-zinc-500 dark:text-zinc-400 font-sans leading-relaxed">
                          {course.relevance}
                        </p>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            ))}

            <!-- Panel 05: Foundations & Breadth (Expansive 3-Column Grid) -->
            <div
              data-discipline-panel={courseworkDisciplines.length}
              class="discipline-panel space-y-4 hidden"
            >
              <div class="border-b border-black/[0.05] dark:border-white/[0.06] pb-2.5 flex items-baseline justify-between gap-3">
                <div>
                  <h3 class="text-base sm:text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
                    Foundations & Academic Breadth
                  </h3>
                  <p class="text-xs text-zinc-500 dark:text-zinc-400 font-sans mt-0.5">
                    Foundational natural sciences, chemical engineering, economics, and humanities courses.
                  </p>
                </div>
                <span class="font-mono text-[11px] text-zinc-400 dark:text-zinc-500 shrink-0">
                  {otherCourses.length} Courses
                </span>
              </div>

              <!-- Full-width 3-Column Chip Matrix -->
              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-2">
                {otherCourses.map((c) => (
                  <div class="flex items-center justify-between py-2 px-2.5 rounded-lg bg-surface-light dark:bg-surface-dark border border-black/[0.05] dark:border-white/[0.06] hover:border-black/15 dark:hover:border-white/15 transition-all text-xs">
                    <span class="text-zinc-800 dark:text-zinc-200 font-medium truncate mr-2 text-[11px] sm:text-xs">
                      {c.name}
                    </span>
                    <span class="font-mono text-[10px] text-zinc-500 dark:text-zinc-400 shrink-0">
                      {c.code}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stream 3: Certifications & Training -->
    <section id="certifications" class="space-y-5 pt-8 sm:pt-10 border-t border-black/[0.08] dark:border-white/[0.08]">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-3 flex items-baseline justify-between">
        <div>
          <h2 class="text-lg sm:text-xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Certifications & Training
          </h2>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">
            Practical workshops and certified programs I have completed alongside my degree.
          </p>
        </div>
        <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
          {certifications.length} Programs
        </span>
      </div>

      <!-- Single Column: One Card Per Horizontal Line -->
      <div class="grid grid-cols-1 gap-4 sm:gap-5">
        {certifications.map((cert) => (
          <article class="apple-card group relative p-5 sm:p-6 rounded-2xl bg-surface-light dark:bg-surface-dark border border-black/[0.06] dark:border-white/[0.08] shadow-apple-card dark:shadow-apple-card-dark hover:border-black/15 dark:hover:border-white/15 transition-all space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1.5 border-b border-black/[0.05] dark:border-white/[0.05] pb-2 text-xs font-mono">
              <span class="text-zinc-800 dark:text-zinc-200 font-semibold">{cert.issuer}</span>
              <span class="text-zinc-400 dark:text-zinc-500 text-[11px]">{cert.period}</span>
            </div>

            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
              <h3 class="text-base font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
                {cert.title}
              </h3>
              <span class="text-[10px] font-mono text-zinc-500 dark:text-zinc-400 font-semibold tracking-wider uppercase shrink-0">
                {cert.credentialId}
              </span>
            </div>

            <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed font-sans">
              {cert.description}
            </p>

            <div class="pt-3 border-t border-black/[0.04] dark:border-white/[0.04] flex flex-wrap items-center justify-between gap-2.5">
              <div class="flex flex-wrap gap-1.5">
                {cert.skills.map((s) => (
                  <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-black/[0.03] dark:bg-white/[0.05] border border-black/[0.05] dark:border-white/[0.06] text-zinc-600 dark:text-zinc-400">
                    {s}
                  </span>
                ))}
              </div>

              {cert.link ? (
                <a
                  href={cert.link}
                  class="inline-flex items-center gap-1 text-xs font-mono text-zinc-900 dark:text-zinc-100 underline decoration-zinc-400 hover:decoration-zinc-950 dark:hover:decoration-zinc-50 transition-colors font-medium"
                >
                  <span>{cert.linkText}</span>
                </a>
              ) : (
                <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">
                  {cert.linkText}
                </span>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  (function () {
    // 1. Interactive Category Filter Tabs (Stable Catalogue Indexing)
    const filterContainer = document.getElementById('project-filters');
    if (filterContainer) {
      filterContainer.addEventListener('click', function (e) {
        const btn = e.target.closest('.filter-btn');
        if (!btn) return;

        const targetFilter = btn.getAttribute('data-filter');
        const allBtns = filterContainer.querySelectorAll('.filter-btn');

        allBtns.forEach(function (b) {
          b.classList.remove('active');
        });
        btn.classList.add('active');

        const items = document.querySelectorAll('[data-project-item]');
        items.forEach(function (item) {
          const cat = item.getAttribute('data-category');
          if (targetFilter === 'all' || cat === targetFilter) {
            item.style.display = '';
          } else {
            item.style.display = 'none';
          }
        });
      });
    }

    // 2. Upper-Viewport Scroll for Academic Coursework when redirected or hash targeted
    const handleCourseworkScroll = function () {
      if (window.location.hash === '#coursework') {
        const el = document.getElementById('coursework');
        if (el) {
          setTimeout(function () {
            // Position header gracefully in the upper portion of the viewport below navbar
            const navOffset = 90;
            const targetY = el.getBoundingClientRect().top + window.pageYOffset - navOffset;
            window.scrollTo({ top: targetY, behavior: 'smooth' });
          }, 120);
        }
      }
    };

    if (document.readyState === 'loading') {
      window.addEventListener('DOMContentLoaded', handleCourseworkScroll);
    } else {
      handleCourseworkScroll();
    }
    window.addEventListener('hashchange', handleCourseworkScroll);

    // 3. Coursework Split-Rail Discipline Switcher
    const navButtons = document.querySelectorAll('.course-nav-btn');
    const panels = document.querySelectorAll('.discipline-panel');

    navButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        const targetIdx = btn.getAttribute('data-discipline-target');

        // Update active nav button
        navButtons.forEach(function (b) {
          b.classList.remove(
            'active',
            'bg-zinc-950',
            'text-white',
            'dark:bg-zinc-100',
            'dark:text-zinc-950',
            'border-zinc-950',
            'dark:border-zinc-100',
            'shadow-sm',
            'font-semibold'
          );
          b.classList.add(
            'text-zinc-900',
            'dark:text-zinc-200',
            'bg-surface-light',
            'dark:bg-surface-dark',
            'border-black/10',
            'dark:border-white/[0.08]'
          );
        });

        btn.classList.add(
          'active',
          'bg-zinc-950',
          'text-white',
          'dark:bg-zinc-100',
          'dark:text-zinc-950',
          'border-zinc-950',
          'dark:border-zinc-100',
          'shadow-sm',
          'font-semibold'
        );
        btn.classList.remove(
          'text-zinc-900',
          'dark:text-zinc-200',
          'bg-surface-light',
          'dark:bg-surface-dark',
          'border-black/10',
          'dark:border-white/[0.08]'
        );

        // Show matching panel
        panels.forEach(function (panel) {
          if (panel.getAttribute('data-discipline-panel') === targetIdx) {
            panel.classList.remove('hidden');
          } else {
            panel.classList.add('hidden');
          }
        });
      });
    });
  })();
</script>

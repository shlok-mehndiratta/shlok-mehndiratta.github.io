    description: 'Processor microarchitecture, digital logic design, embedded circuits, and hands-on laboratory setups.',
    courses: [
      {
        code: 'ECS409',
        name: 'Computer Organisation',
        instructor: 'Sukarn Agarwal',
        status: 'Ongoing',
        relevance: 'Processor microarchitecture, instruction pipelining, cache memory hierarchies, hazard handling, and memory management.',
      },
      {
        code: 'ECS326',
        name: 'Digital Circuits and Systems',
        relevance: 'Combinational logic, synchronous sequential circuits, state machine synthesis, and FPGA timing analysis.',
      },
      {
        code: 'ECS321',
        name: 'Electronic Devices',
        relevance: 'Semiconductor physics, p-n junctions, BJT/MOSFET operation, and physical device characteristics.',
      },
      {
        code: 'ECS325',
        name: 'Analog Circuits',
        relevance: 'Operational amplifiers, active filters, feedback amplifiers, and signal conditioning for sensors.',
      },
      {
        code: 'ECS203',
        name: 'Basic Electronics',
        relevance: 'Diode circuits, transistor DC biasing, small-signal models, and basic amplifier topologies.',
      },
      {
        code: 'ECS327',
        name: 'EECS Laboratory I',
        relevance: 'Hands-on experimentation with microcontrollers, sensor interfacing, signal acquisition, and instrumentation.',
      },
      {
        code: 'ECS330',
        name: 'EECS Laboratory II',
        relevance: 'Advanced laboratory experiments in digital signal processing, hardware communication, and closed-loop control.',
      },
    ],
  },
  {
    discipline: 'Mathematical & Network Foundations',
    description: 'Complex network science, numerical optimization, linear algebra, multivariable calculus, and probability.',
    courses: [
      {
        code: 'ECS414',
        name: 'Network Science: Theory and Applications',
        instructor: 'Kundan Kandhway',

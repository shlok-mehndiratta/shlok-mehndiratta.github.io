---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { getCollection } from 'astro:content';

const allPubs = await getCollection('publications');
const sortedPubs = allPubs.sort((a, b) => a.data.order - b.data.order);

const underReviewCount = sortedPubs.filter((p) => p.data.status === 'under-review').length;
const publishedCount = sortedPubs.filter((p) => p.data.status === 'published').length;
const preprintCount = sortedPubs.filter((p) => p.data.status === 'preprint').length;
---

<BaseLayout
  title="Research & Inquiries | Shlok Mehndiratta"
  description="Research inquiries, ongoing BS thesis, publications, and manuscripts by Shlok Mehndiratta."
>
  <div class="space-y-12">
    <!-- Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded text-xs font-mono bg-sky-500/10 text-sky-600 dark:text-sky-400 border border-sky-500/20">
        <span>Scientific Inquiry</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Research & Inquiries
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
        I am interested in statistical signal processing, estimation over graphs, and optimization in decentralized networks. My work seeks to answer how networked agents can reliably learn and estimate states from sparse, imperfect observations.
      </p>
    </header>

    <!-- Research Vision & Open Questions -->
    <section class="p-6 rounded-2xl border border-black/[0.08] dark:border-white/[0.08] bg-surface-light dark:bg-surface-dark space-y-4">
      <div class="flex items-center gap-2 text-xs font-mono text-sky-600 dark:text-sky-400 uppercase tracking-wider font-semibold">
        <span>Core Research Themes</span>
      </div>
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm text-zinc-600 dark:text-zinc-300">
        <div class="space-y-1.5">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <span>1. Dynamic Graph State Estimation</span>
          </h3>
          <p class="leading-relaxed">
            Most classical graph signal processing assumes a fixed, static adjacency matrix. In real physical swarms or sensor grids, topologies fluctuate constantly. I explore continuous-time manifold priors to maintain tracking stability despite topology switching.
          </p>
        </div>

        <div class="space-y-1.5">
          <h3 class="font-semibold text-zinc-900 dark:text-zinc-100 flex items-center gap-2">
            <span>2. Non-Convex Proximal Recovery</span>
          </h3>
          <p class="leading-relaxed">
            While convex $\ell_1$ relaxations guarantee polynomial time convergence, they introduce systemic shrinkage bias in high-noise regimes. I study non-convex proximal surrogates with analytical recovery guarantees.
          </p>
        </div>
      </div>
    </section>

    <!-- Ongoing Undergraduate Thesis Focus -->
    <section class="p-5 rounded-2xl border border-amber-500/20 bg-amber-500/5 dark:bg-amber-500/10 space-y-2 text-xs sm:text-sm">
      <div class="flex items-center justify-between">
        <h3 class="font-semibold text-amber-900 dark:text-amber-200 flex items-center gap-2">
          <span>🔬 Active Inquiry: Senior Undergraduate Thesis (IISER Bhopal)</span>
        </h3>
        <span class="font-mono text-[11px] text-amber-700 dark:text-amber-300">In Progress</span>
      </div>
      <p class="text-zinc-700 dark:text-zinc-300 leading-relaxed">
        Investigating recursive filtering on dynamic Riemannian manifolds. We are proving asymptotic mean-squared error bounds under non-stationary stochastic perturbations and testing scalability against standard distributed Kalman-consensus baselines.
      </p>
    </section>

    <!-- Manuscripts & Papers Section -->
    <section class="space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-black/[0.06] dark:border-white/[0.06] pb-3">
        <div>
          <h2 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
            Manuscripts & Papers
          </h2>
          <p class="text-xs text-zinc-500 dark:text-zinc-400 font-mono mt-0.5">
            Preprints, peer-reviewed conference proceedings & submissions
          </p>
        </div>

        <!-- Filter Stats -->
        <div class="flex flex-wrap items-center gap-1.5 text-xs font-mono">
          <span class="px-2.5 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/60">
            Total: {sortedPubs.length}
          </span>
          <span class="px-2.5 py-0.5 rounded-full bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
            Under Review: {underReviewCount}
          </span>
          <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
            Published: {publishedCount}
          </span>
          <span class="px-2.5 py-0.5 rounded-full bg-purple-500/10 text-purple-600 dark:text-purple-400 border border-purple-500/20">
            Preprints: {preprintCount}
          </span>
        </div>
      </div>

      <div class="space-y-4">
        {sortedPubs.map((pub) => (
          <PublicationCard pub={pub} />
        ))}
      </div>
    </section>

    <!-- Influential Literature / Foundations -->
    <section class="space-y-4 pt-6 border-t border-black/[0.06] dark:border-white/[0.06]">
      <div class="space-y-1">
        <h2 class="text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
          Conceptual Influences & Literature
        </h2>
        <p class="text-xs text-zinc-500 dark:text-zinc-400 font-mono">
          Foundational works and frameworks that heavily shape my research approach
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div class="p-4 rounded-xl border border-black/[0.06] dark:border-white/[0.06] bg-zinc-50/50 dark:bg-zinc-900/30 space-y-1">
          <h4 class="font-semibold text-zinc-900 dark:text-zinc-100">
            Graph Signal Processing (GSP) Foundations
          </h4>
          <p class="text-zinc-600 dark:text-zinc-400">
            Shuman, Narang, Frossard, Ortega, and Vandergheynst (IEEE Signal Processing Magazine, 2013).
          </p>
          <span class="text-[11px] font-mono text-zinc-400">Harmonics on irregular graph topologies</span>
        </div>

        <div class="p-4 rounded-xl border border-black/[0.06] dark:border-white/[0.06] bg-zinc-50/50 dark:bg-zinc-900/30 space-y-1">
          <h4 class="font-semibold text-zinc-900 dark:text-zinc-100">
            Distributed Optimization via ADMM
          </h4>
          <p class="text-zinc-600 dark:text-zinc-400">
            Stephen Boyd, Neal Parikh, Eric Chu, Borja Peleato, and Jonathan Eckstein (2011).
          </p>
          <span class="text-[11px] font-mono text-zinc-400">Splitting methods for decentralized solving</span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import SignatureMark from '../components/SignatureMark.astro';

const resumeSections = [
  { id: 'education', label: 'Education' },
  { id: 'research-experience', label: 'Research' },
  { id: 'publications', label: 'Publications' },
  { id: 'open-source', label: 'Open Source' },
  { id: 'skills', label: 'Skills' },
  { id: 'co-curricular', label: 'Leadership' },
];
---

<BaseLayout
  title="Resume | Shlok Mehndiratta"
  description="Curriculum Vitae and Resume of Shlok Mehndiratta. Undergraduate researcher in EECS at IISER Bhopal."
  sections={resumeSections}
>
  <div class="space-y-10 max-w-3xl mx-auto">
    <!-- Header with Action Buttons -->

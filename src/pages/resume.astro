      <!-- Verified Sign-Off Section -->
      <section class="pt-6 border-t border-black/[0.08] dark:border-white/[0.08] flex items-center justify-between">
        <div>
          <p class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
            I hereby declare all stated information to be authentic and verifiable.

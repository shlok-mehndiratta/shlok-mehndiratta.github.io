          <span>Download Again</span>
        </a>

        <a
          href="/Shlok_Mehndiratta_Resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full sm:w-auto tactile-btn inline-flex items-center justify-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-mono text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-zinc-100 transition-all"
        >
          <span>Open in Browser ↗</span>

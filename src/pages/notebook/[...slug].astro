---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('notebook', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const typeLabels = {
  'deep-dive': 'Deep Dive',
  'heuristic': 'Heuristic',
  'paper-note': 'Paper Note',
  'bookshelf': 'Bookshelf Note',
};

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(entry.data.publishedDate);
---

<BaseLayout
  title={`${entry.data.title} | Shlok's Notebook`}
  description={entry.data.summary}
>
  <article class="max-w-2xl mx-auto space-y-8">
    <!-- Back Navigation -->
    <a
      href="/notebook"
      class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      <span>Back to notebook</span>
    </a>

    <!-- Header -->
    <header class="space-y-4 pb-6 border-b border-black/[0.08] dark:border-white/[0.08]">
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300">
          {typeLabels[entry.data.type]}
        </span>
        <span>•</span>
        <span>{entry.data.readTime}</span>
        <span>•</span>
        <time datetime={entry.data.publishedDate.toISOString()}>{formattedDate}</time>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 leading-tight">
        {entry.data.title}
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed font-serif italic">
        {entry.data.summary}
      </p>

      {
        entry.data.tags && entry.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 pt-2">
            {entry.data.tags.map((tag) => (
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
                #{tag}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <!-- Content rendered with KaTeX & Shiki -->
    <div class="prose-custom">
      <Content />
    </div>

    <!-- Article Footer -->
    <div class="pt-8 border-t border-black/[0.08] dark:border-white/[0.08] flex items-center justify-between text-xs font-mono text-zinc-500">
      <span>Curated in Shlok's Notebook</span>
      <a href="/notebook" class="text-zinc-600 dark:text-zinc-400 hover:text-black dark:hover:text-white transition-colors">
        ← Return to notebook
      </a>
    </div>
  </article>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SignatureMark from '../../components/SignatureMark.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('notebook', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const typeLabels: Record<string, string> = {
  'workshop': 'Workshop & Teaching',
  'lab-story': 'Hardware & Lab Story',
  'deep-dive': 'Engineering & Systems',
  'experience': 'Campus & Field Life',
  'reading': 'Reading & Reflection',
  'thought': 'Perspective & Note',
  'essay': 'Engineering & Systems',
  'book-summary': 'Reading & Reflection',
  'paper-note': 'Paper Reflection',
  'bookshelf': 'Bookshelf Note',
};

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(entry.data.publishedDate);

const articleSchema = {
  '@type': 'TechArticle',
  '@id': `https://shlokmehndiratta.me/notebook/${entry.slug}#article`,
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: entry.data.publishedDate.toISOString(),
  inLanguage: 'en-US',
  author: {
    '@type': 'Person',
    '@id': 'https://shlokmehndiratta.me/#person',
    name: 'Shlok Mehndiratta',
    url: 'https://shlokmehndiratta.me',
  },
  publisher: {
    '@type': 'Person',
    '@id': 'https://shlokmehndiratta.me/#person',
    name: 'Shlok Mehndiratta',
  },
  image: entry.data.image ? new URL(entry.data.image, Astro.site || 'https://shlokmehndiratta.me').toString() : undefined,
  keywords: entry.data.tags.join(', '),
  articleSection: typeLabels[entry.data.type] || 'Reflections',
};
---

<BaseLayout
  title={`${entry.data.title} | Shlok's Notebook`}
  description={entry.data.summary}
  image={entry.data.image}
  type="article"
  publishedTime={entry.data.publishedDate.toISOString()}
  tags={entry.data.tags}
  schema={articleSchema}
>
  <article class="max-w-2xl mx-auto space-y-8">
    <!-- Back Navigation -->
    <a
      href="/notebook"
      class="inline-flex items-center gap-1.5 text-xs font-mono text-zinc-500 hover:text-zinc-900 dark:hover:text-zinc-100 transition-colors"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
      <span>Back to notebook</span>
    </a>

    <!-- Header -->
    <header class="space-y-4 pb-6 border-b border-black/[0.08] dark:border-white/[0.08]">
      <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-zinc-500 dark:text-zinc-400">
        <span class="px-2 py-0.5 rounded bg-black/[0.03] dark:bg-white/[0.05] border border-black/[0.05] dark:border-white/[0.06] text-zinc-700 dark:text-zinc-300">
          {typeLabels[entry.data.type]}
        </span>
        <span>•</span>
        <span>{entry.data.readTime}</span>
        <span>•</span>
        <time datetime={entry.data.publishedDate.toISOString()}>{formattedDate}</time>
      </div>

      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50 leading-tight">
        {entry.data.title}
      </h1>

      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed font-serif italic">
        {entry.data.summary}
      </p>

      {
        entry.data.tags && entry.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-1.5 pt-2">
            {entry.data.tags.map((tag) => (
              <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-black/[0.03] dark:bg-white/[0.05] border border-black/[0.05] dark:border-white/[0.06] text-zinc-600 dark:text-zinc-400">
                #{tag}
              </span>
            ))}
          </div>
        )
      }
    </header>

    <!-- Content rendered with KaTeX & Shiki -->
    <div class="prose-custom">
      <Content />
    </div>

    <!-- Editorial Sign-off with Handcrafted Signature -->
    <div class="pt-8 border-t border-black/[0.08] dark:border-white/[0.08] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <SignatureMark class="h-8 w-auto text-zinc-800 dark:text-zinc-200" />
        <div class="text-[11px] font-mono text-zinc-500 dark:text-zinc-400">
          <span>Shlok Mehndiratta</span>
          <span class="mx-1.5">•</span>
          <span>IISER Bhopal</span>
        </div>
      </div>
      <a href="/notebook" class="text-xs font-mono text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors self-start sm:self-auto">
        ← Return to notebook
      </a>
    </div>
  </article>
</BaseLayout>

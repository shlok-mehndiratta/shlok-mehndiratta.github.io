---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotebookCard from '../../components/NotebookCard.astro';
import { getCollection } from 'astro:content';

const allEntries = await getCollection('notebook', ({ data }) => !data.draft);
const sortedEntries = allEntries.sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);
---

<BaseLayout
  title="Notebook | Shlok Mehndiratta"
  description="Technical essays, lab heuristics, and paper reading reflections by Shlok Mehndiratta."
>
  <div class="space-y-10 sm:space-y-12">
    <!-- Header -->
    <header class="space-y-2">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Notebook
      </h1>
      <p class="text-base text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
        Technical essays, lab heuristics, and paper reading reflections.
      </p>
    </header>

    <!-- Notebook Grid -->
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {sortedEntries.map((entry) => (
        <NotebookCard entry={entry} />
      ))}
    </section>
  </div>
</BaseLayout>

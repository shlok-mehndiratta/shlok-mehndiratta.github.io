---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NotebookCard from '../../components/NotebookCard.astro';
import { getCollection } from 'astro:content';

const allEntries = await getCollection('notebook', ({ data }) => !data.draft);
const sortedEntries = allEntries.sort(
  (a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime()
);

const deepDiveCount = sortedEntries.filter((p) => p.data.type === 'deep-dive').length;
const heuristicCount = sortedEntries.filter((p) => p.data.type === 'heuristic').length;
const bookshelfCount = sortedEntries.filter((p) => p.data.type === 'bookshelf').length;
---

<BaseLayout
  title="Notebook | Shlok Mehndiratta"
  description="Technical deep-dives, heuristics from research and internships, paper breakdowns, and bookshelf notes by Shlok Mehndiratta."
>
  <div class="space-y-10">
    <!-- Header -->
    <header class="space-y-3">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded text-xs font-mono bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-black/[0.06] dark:border-white/[0.08]">
        <span>The Intellectual Journal</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Notebook
      </h1>
      <p class="text-sm sm:text-base text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
        An open workshop of ideas: intuitive derivations of complex mathematical concepts, engineering heuristics gathered from internships, paper summaries, and bookshelf reflections.
      </p>
    </header>

    <!-- Categories Legend -->
    <div class="p-4 rounded-xl border border-black/[0.06] dark:border-white/[0.06] bg-surface-light dark:bg-surface-dark shadow-[inset_0_1px_0_0_rgba(255,255,255,0.06)] text-xs">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-zinc-600 dark:text-zinc-400">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/60">
            Deep Dive ({deepDiveCount})
          </span>
          <span>Math & theory explorations</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/60">
            Heuristic ({heuristicCount})
          </span>
          <span>Research & debugging lessons</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-zinc-100 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300 border border-zinc-200 dark:border-zinc-700/60">
            Bookshelf ({bookshelfCount})
          </span>
          <span>Books & foundational papers</span>
        </div>
      </div>
    </div>

    <!-- Notebook Grid -->
    <section class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {sortedEntries.map((entry) => (
        <NotebookCard entry={entry} />
      ))}
    </section>
  </div>
</BaseLayout>

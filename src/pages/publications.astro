---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { getCollection } from 'astro:content';

const allPubs = await getCollection('publications');
const sortedPubs = allPubs.sort((a, b) => a.data.order - b.data.order);

const hardwareTestbeds = [
  {
    title: 'OptiTrack Optical Mocap & Drone Arena',
    lab: 'MOON Lab, IISER Bhopal',
    description: 'High-precision indoor optical motion capture arena integrated with ROS 2 for millimeter-accuracy ground-truth localization, real-time telemetry, and multi-agent Crazyflie 2.1 swarm coordination.',
    capabilities: ['Sub-millimeter Tracking', 'Crazyflie 2.1 Quadrotors', 'Real-time Telemetry Modules', 'ROS 2 Indoor Mocap Pipeline'],
  },
  {
    title: '16-DoF LEAP Hand & GPU Physics Cluster',
    lab: 'Robotics Research Center (RRC), IIIT Hyderabad',
    description: 'Hardware testbed for dexterous robotic manipulation paired with NVIDIA Warp GPU physics and BlenderProc photorealistic rendering, predicting 3D contact distributions for real-robot policy transfer.',
    capabilities: ['16-DoF LEAP Hand', 'NVIDIA Warp GPU Physics', 'BlenderProc Photorealism', 'Sim-to-Real Transfer'],
  },
  {
    title: 'Perception-Coupled Aerial-Ground Gazebo Testbed',
    lab: 'MuSic Lab, IISER Bhopal',
    description: 'Coupled perception and navigation environment evaluating camera footprint-altitude scaling ($R \\propto z^2$), belief-space ground control, and event-triggered aerial trajectory optimization.',
    capabilities: ['Belief-Space MPC', 'Event-Triggered Replanning', 'Shared-Camera Estimation', 'ROS 2 / Gazebo Architecture'],
  },
];

const pubSections = [
  { id: 'manuscripts', label: 'Manuscripts' },
  { id: 'testbeds', label: 'Hardware Testbeds' },
];
---

<BaseLayout
  title="Publications | Shlok Mehndiratta"
  description="Peer-reviewed publications, conference manuscripts under review, preprints, and physical hardware testbeds in robotics, control, and autonomous systems."
  sections={pubSections}
>
  <div class="space-y-16 sm:space-y-24">
    <!-- Clean Page Header -->
    <header class="space-y-3 pb-6 border-b border-black/[0.08] dark:border-white/[0.08]">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Publications
      </h1>
      <p class="text-base sm:text-lg text-zinc-600 dark:text-zinc-400 max-w-2xl leading-relaxed">
        Original peer-reviewed manuscripts and preprints focused on principled control formulations, state estimation, and physical autonomous systems.
      </p>
    </header>

    <!-- Section 1: Manuscripts & Preprints -->
    <section id="manuscripts" class="space-y-6">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold tracking-wider uppercase bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 border border-cyan-500/20">
              01 // SCHOLARLY ARCHIVE
            </span>
            <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">Peer-Reviewed & Preprints</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Manuscripts & Preprints
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1 max-w-2xl leading-relaxed">
            Peer-reviewed manuscripts and active preprints driven by first-principles control, state estimation, and physical robotic autonomy.
          </p>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400 border border-black/[0.04] dark:border-white/[0.05] shrink-0 self-start sm:self-auto">
          {sortedPubs.length} Manuscripts • 1 Accepted, 1 Under Review
        </span>
      </div>

      <div class="space-y-6">
        {sortedPubs.map((pub) => (
          <PublicationCard pub={pub} />
        ))}
      </div>
    </section>

    <!-- Section 2: Experimental Hardware Testbeds -->
    <section id="testbeds" class="space-y-6 pt-10 sm:pt-14 border-t border-black/[0.08] dark:border-white/[0.08]">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="px-2 py-0.5 rounded text-[10px] font-mono font-semibold tracking-wider uppercase bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/20">
              02 // PHYSICAL EXPERIMENTATION
            </span>
            <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">Validation Platforms & Arenas</span>
          </div>
          <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
            Hardware & Research Testbeds
          </h2>
          <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-1 max-w-2xl leading-relaxed">
            Theoretical derivations validated on physical robotics hardware, optical motion capture arenas, and high-fidelity GPU physics clusters.
          </p>
        </div>
        <span class="text-xs font-mono px-3 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800/80 text-zinc-600 dark:text-zinc-400 border border-black/[0.04] dark:border-white/[0.05] shrink-0 self-start sm:self-auto">
          3 Research Arenas
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {hardwareTestbeds.map((testbed) => (
          <article class="apple-card group relative p-6 rounded-2xl bg-white dark:bg-[#121214] border border-black/[0.06] dark:border-white/[0.08] shadow-apple-card dark:shadow-apple-card-dark transition-all hover:border-black/15 dark:hover:border-white/20 flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <span class="text-[10px] font-mono text-cyan-700 dark:text-cyan-400 font-semibold tracking-wide uppercase">
                {testbed.lab}
              </span>
              <h3 class="text-base sm:text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50 leading-snug">
                {testbed.title}
              </h3>
              <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed pt-1">
                {testbed.description}
              </p>
            </div>

            <div class="pt-4 border-t border-black/[0.05] dark:border-white/[0.05] flex flex-wrap gap-1.5">
              {testbed.capabilities.map((cap) => (
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
                  {cap}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

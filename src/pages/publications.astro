---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationCard from '../components/PublicationCard.astro';
import { getCollection } from 'astro:content';

const allPubs = await getCollection('publications');
const sortedPubs = allPubs.sort((a, b) => a.data.order - b.data.order);

const publicationsSchema = {
  '@type': 'ItemList',
  itemListElement: sortedPubs.map((pub, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'ScholarlyArticle',
      headline: pub.data.title,
      name: pub.data.title,
      description: pub.data.takeaway || pub.data.abstract,
      abstract: pub.data.abstract,
      datePublished: `${pub.data.year}`,
      author: pub.data.authors.map((author: string) => ({
        '@type': 'Person',
        name: author,
        ...(author === 'Shlok Mehndiratta' ? { '@id': 'https://shlokmehndiratta.me/#person' } : {}),
      })),
      publication: {
        '@type': 'PublicationEvent',
        name: pub.data.venue,
      },
      keywords: pub.data.tags.join(', '),
      url: pub.data.codeUrl || 'https://shlokmehndiratta.me/publications',
    },
  })),
};
---

<BaseLayout
  title="Publications | Shlok Mehndiratta"
  description="Peer-reviewed publications and conference papers in robotics, control theory, and autonomous systems by Shlok Mehndiratta."
  schema={publicationsSchema}
>
  <div class="space-y-8 sm:space-y-10">
    <!-- Clean Page Header -->
    <header class="pb-4 border-b border-black/[0.08] dark:border-white/[0.08]">
      <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
        Publications
      </h1>
    </header>

    <!-- Conference Papers Section -->
    <section class="space-y-5">
      <div class="border-b border-black/[0.06] dark:border-white/[0.06] pb-3 flex items-baseline justify-between gap-3">
        <h2 class="text-lg sm:text-xl font-bold tracking-tight text-zinc-950 dark:text-zinc-50">
          Conference Papers
        </h2>
        <span class="text-xs font-mono text-zinc-500 dark:text-zinc-400">
          {sortedPubs.length} Papers • 1 Accepted, 1 Under Review
        </span>
      </div>

      <div class="space-y-5">
        {sortedPubs.map((pub) => (
          <PublicationCard pub={pub} />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

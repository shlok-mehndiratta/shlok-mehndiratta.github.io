---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import KeyboardShortcutsModal from '../components/KeyboardShortcutsModal.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Shlok Mehndiratta | EECS @ IISER Bhopal',
  description = 'Personal website, research portfolio, and digital archive of Shlok Mehndiratta. Senior undergraduate in EECS at IISER Bhopal.',
  image = '/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://shlokmehndiratta.me');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Shlok Mehndiratta" />
    <meta name="keywords" content="Shlok Mehndiratta, IISER Bhopal, EECS, Signal Processing, Graph Neural Networks, State Estimation, Convex Optimization, Research" />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- JSON-LD Structured Data for Google Scholar & Web Indexing -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Shlok Mehndiratta",
        "url": "https://shlokmehndiratta.me",
        "jobTitle": "Undergraduate Researcher in EECS",
        "worksFor": {
          "@type": "EducationalOrganization",
          "name": "Indian Institute of Science Education and Research (IISER) Bhopal"
        },
        "alumniOf": {
          "@type": "EducationalOrganization",
          "name": "IISER Bhopal"
        },
        "email": "mailto:shlok@iiserb.ac.in",
        "sameAs": [
          "https://github.com/shlokmehndiratta",
          "https://scholar.google.com",
          "https://linkedin.com/in/shlokmehndiratta"
        ]
      }
    </script>

    <!-- Anti-FOUC Theme Initialization Script -->
    <script is:inline>
      const getInitialTheme = () => {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme) {
          return savedTheme;
        }
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      };

      const theme = getInitialTheme();
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="bg-canvas-light dark:bg-canvas-dark text-zinc-900 dark:text-zinc-100 flex flex-col min-h-screen selection:bg-black/10 selection:text-black dark:selection:bg-white/15 dark:selection:text-white antialiased relative">
    <!-- Left Marginal Station Telemetry (Wide screens only) -->
    <aside class="hidden 2xl:flex fixed left-6 top-1/2 -translate-y-1/2 flex-col items-center gap-6 text-[10px] font-mono text-zinc-400/50 dark:text-zinc-600/60 select-none tracking-widest pointer-events-none z-10" aria-hidden="true">
      <span class="[writing-mode:vertical-rl] rotate-180">IISER BHOPAL • EECS</span>
      <span class="w-[1px] h-10 bg-black/[0.08] dark:bg-white/[0.08]"></span>
      <span class="[writing-mode:vertical-rl] rotate-180">23.2599° N, 77.4126° E</span>
    </aside>

    <!-- Right Marginal Telemetry (Wide screens only) -->
    <aside class="hidden 2xl:flex fixed right-6 top-1/2 -translate-y-1/2 flex-col items-center gap-6 text-[10px] font-mono text-zinc-400/50 dark:text-zinc-600/60 select-none tracking-widest pointer-events-none z-10" aria-hidden="true">
      <span class="[writing-mode:vertical-rl] rotate-180">MONOCHROME CRAFT</span>
      <span class="w-[1px] h-10 bg-black/[0.08] dark:bg-white/[0.08]"></span>
      <span class="[writing-mode:vertical-rl] rotate-180">AUTUMN '26 TERMINAL</span>
    </aside>

    <Header />

    <!-- Main Architectural Frame -->
    <div class="relative flex-grow w-full max-w-5xl mx-auto px-4 sm:px-8 border-x border-black/[0.04] dark:border-white/[0.04]">
      <!-- Precision Corner Registration Crosshairs -->
      <div class="absolute -top-3 -left-1.5 font-mono text-[11px] text-zinc-300/80 dark:text-zinc-700/80 select-none hidden sm:block" aria-hidden="true">+</div>
      <div class="absolute -top-3 -right-1.5 font-mono text-[11px] text-zinc-300/80 dark:text-zinc-700/80 select-none hidden sm:block" aria-hidden="true">+</div>

      <main class="w-full pt-20 sm:pt-28 pb-12 sm:pb-16">
        <slot />
      </main>
    </div>

    <Footer />
    <KeyboardShortcutsModal />
  </body>
</html>

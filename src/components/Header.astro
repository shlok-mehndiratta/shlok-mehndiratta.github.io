---
import ThemeToggle from './ThemeToggle.astro';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';

const navItems = [
  { name: 'Experience', href: '/experience' },
  { name: 'Publications', href: '/publications' },
  { name: 'Projects', href: '/projects' },
  { name: 'Notebook', href: '/notebook' },
  { name: 'Archive', href: '/archive' },
  { name: 'Resume', href: '/resume' },
];
---

<header class="fixed top-3 sm:top-5 inset-x-0 z-50 w-full px-4 sm:px-6 pointer-events-none">
  <div class="max-w-4xl mx-auto flex items-center justify-between pointer-events-auto rounded-full border border-black/[0.06] dark:border-white/[0.08] bg-white/80 dark:bg-[#121214]/80 backdrop-blur-xl shadow-apple-card dark:shadow-apple-card-dark px-3.5 sm:px-4 py-2 sm:py-2.5 transition-all duration-200">
    <!-- Brand / Home Link -->
    <a
      href="/"
      class="group flex items-center space-x-2 text-xs sm:text-sm font-medium tracking-tight text-zinc-900 dark:text-zinc-100 hover:text-black dark:hover:text-white transition-colors pl-1"
    >
      <span class="font-semibold tracking-tight">Shlok Mehndiratta</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-1 text-xs font-medium text-zinc-600 dark:text-zinc-400">
      {
        navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 rounded-full transition-all duration-150 ${
                isActive
                  ? 'text-zinc-950 dark:text-zinc-50 bg-zinc-200/70 dark:bg-zinc-800/80 font-semibold'
                  : 'hover:text-zinc-950 dark:hover:text-zinc-100 hover:bg-zinc-100/70 dark:hover:bg-zinc-800/40'
              }`}
            >
              {item.name}
            </a>
          );
        })
      }
    </nav>

    <!-- Right Controls: Command palette trigger + Theme Toggle -->
    <div class="flex items-center space-x-1.5 sm:space-x-2">
      <button
        id="cmd-k-trigger"
        type="button"
        class="hidden sm:inline-flex items-center gap-1 px-2 py-1 text-[11px] font-mono text-zinc-500 dark:text-zinc-400 bg-zinc-100/80 dark:bg-zinc-800/60 border border-zinc-200 dark:border-zinc-700/60 rounded-full hover:border-zinc-300 dark:hover:border-zinc-500 hover:text-black dark:hover:text-white transition-colors"
        title="Open keyboard shortcuts"
      >
        <span>⌘K</span>
      </button>

      <ThemeToggle />

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle mobile menu"
        class="md:hidden p-1.5 text-zinc-600 dark:text-zinc-400 hover:text-zinc-900 dark:hover:text-zinc-100 rounded-full hover:bg-zinc-100 dark:hover:bg-zinc-800"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Floating Card -->
  <div id="mobile-menu" class="hidden md:hidden pointer-events-auto max-w-sm mx-auto mt-2 rounded-2xl border border-black/[0.08] dark:border-white/[0.08] bg-surface-light/95 dark:bg-[#0f1217]/95 backdrop-blur-xl p-2 shadow-2xl shadow-specular space-y-1">
    {
      navItems.map((item) => (
        <a
          href={item.href}
          class="block px-3 py-2 text-xs font-medium rounded-xl text-zinc-700 dark:text-zinc-300 hover:text-black dark:hover:text-white hover:bg-zinc-100 dark:hover:bg-zinc-800"
        >
          {item.name}
        </a>
      ))
    }
  </div>
</header>

<script is:inline>
  const setupMobileMenu = () => {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
  };
  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>

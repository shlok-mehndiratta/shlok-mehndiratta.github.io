---
import ThemeToggle from './ThemeToggle.astro';
import ArchitecturalMonogram from './ArchitecturalMonogram.astro';

const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, '') || '/';

const navItems = [
  { name: 'Experience', href: '/experience' },
  { name: 'Publications', href: '/publications' },
  { name: 'Projects', href: '/projects' },
  { name: 'Notebook', href: '/notebook' },
  { name: 'Archive', href: '/archive' },
  { name: 'Resume', href: '/resume' },
];
---

<header class="fixed top-3 sm:top-5 inset-x-0 z-50 w-full px-3.5 sm:px-6 pointer-events-none">
  <div class="max-w-5xl mx-auto flex items-center justify-between pointer-events-auto rounded-full border border-[rgba(50,34,20,0.12)] dark:border-white/[0.14] bg-[#f5ede1]/80 dark:bg-[#141418]/65 backdrop-blur-2xl backdrop-saturate-150 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.90),0_4px_20px_-2px_rgba(35,22,12,0.10)] dark:shadow-[inset_0_1px_0_0_rgba(255,255,255,0.18),0_12px_36px_-4px_rgba(0,0,0,0.75)] px-3 sm:px-4 py-2 sm:py-2.5 transition-all duration-200">
    <!-- Brand / Home Link -->
    <a
      href="/"
      class="group flex items-center space-x-2 sm:space-x-2.5 text-xs sm:text-sm font-medium tracking-tight text-zinc-900 dark:text-zinc-100 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors pl-1 shrink-0"
    >
      <ArchitecturalMonogram size={22} class="text-zinc-700 dark:text-zinc-300 group-hover:text-zinc-950 dark:group-hover:text-zinc-50 transition-colors shrink-0" />
      <span class="font-semibold tracking-tight">Shlok Mehndiratta</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-1 text-xs font-medium text-zinc-600 dark:text-zinc-400">
      {
        navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={`px-3 py-1.5 rounded-full transition-all duration-150 ${
                isActive
                  ? 'text-zinc-950 dark:text-zinc-50 bg-black/[0.08] dark:bg-white/[0.12] font-semibold shadow-[inset_0_1px_0_rgba(255,255,255,0.4)] dark:shadow-[inset_0_1px_0_rgba(255,255,255,0.1)]'
                  : 'hover:text-zinc-950 dark:hover:text-zinc-100 hover:bg-black/[0.035] dark:hover:bg-white/[0.06]'
              }`}
            >
              {item.name}
            </a>
          );
        })
      }
    </nav>

    <!-- Right Controls: Command palette trigger + Theme Toggle + Mobile Menu Button -->
    <div class="flex items-center space-x-1.5 sm:space-x-2 shrink-0">
      <button
        id="cmd-k-trigger"
        type="button"
        class="hidden sm:inline-flex items-center gap-1 px-2.5 py-0.5 text-[11px] font-mono text-zinc-600 dark:text-zinc-400 bg-surface-light dark:bg-white/[0.05] border border-border-subtle rounded-full shadow-[0_1px_2px_rgba(35,22,12,0.05),inset_0_1px_0_rgba(255,255,255,0.7)] hover:border-border-hover hover:text-zinc-950 dark:hover:text-zinc-50 transition-all cursor-pointer"
        title="Open keyboard shortcuts"
      >
        <span>⌘K</span>
      </button>

      <ThemeToggle />

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle mobile navigation"
        aria-expanded="false"
        class="md:hidden p-2 text-zinc-700 dark:text-zinc-300 hover:text-zinc-950 dark:hover:text-zinc-50 rounded-full hover:bg-black/[0.05] dark:hover:bg-white/[0.08] transition-colors cursor-pointer"
      >
        <svg id="hamburger-icon" class="w-4 h-4 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="close-icon" class="w-4 h-4 hidden transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown Floating Card with High Contrast -->
  <div
    id="mobile-menu"
    class="hidden md:hidden pointer-events-auto max-w-sm mx-auto mt-2 rounded-2xl border border-[rgba(50,34,20,0.16)] dark:border-white/[0.14] bg-surface-light dark:bg-surface-dark p-3 shadow-[0_20px_50px_-8px_rgba(35,22,12,0.30),inset_0_1px_0_rgba(255,255,255,0.95)] dark:shadow-[0_20px_50px_rgba(0,0,0,0.9),inset_0_1px_0_rgba(255,255,255,0.18)] space-y-1 z-50"
  >
    {
      navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class={`mobile-nav-link flex items-center justify-between px-3.5 py-2.5 text-xs font-mono rounded-xl transition-all ${
              isActive
                ? 'bg-zinc-950 text-zinc-50 dark:bg-zinc-100 dark:text-zinc-950 font-semibold shadow-[0_1px_4px_rgba(31,22,15,0.25)]'
                : 'text-zinc-800 dark:text-zinc-200 hover:text-zinc-950 dark:hover:text-zinc-50 hover:bg-black/[0.04] dark:hover:bg-white/[0.06]'
            }`}
          >
            <span>{item.name}</span>
            {isActive ? (
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            ) : (
              <span class="text-zinc-400 dark:text-zinc-500 text-[10px]">&rarr;</span>
            )}
          </a>
        );
      })
    }

    <!-- Quick Actions Mobile Row -->
    <div class="pt-2.5 mt-1 border-t border-black/[0.08] dark:border-white/[0.08] grid grid-cols-2 gap-2 text-[11px] font-mono">
      <a
        href="/docs/Shlok_Mehndiratta_Resume.pdf"
        download="Shlok_Mehndiratta_Resume.pdf"
        class="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-black/[0.05] dark:bg-white/[0.06] text-zinc-800 dark:text-zinc-200 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors"
      >
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
        <span>CV (PDF)</span>
      </a>
      <a
        href="#quick-contact-form"
        id="mobile-contact-link"
        class="inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-black/[0.05] dark:bg-white/[0.06] text-zinc-800 dark:text-zinc-200 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors"
      >
        <span>Contact</span>
        <span>&darr;</span>
      </a>
    </div>
  </div>
</header>

<!-- Mobile Backdrop Blur Overlay -->
<div id="mobile-backdrop" class="hidden md:hidden fixed inset-0 bg-black/35 dark:bg-black/70 backdrop-blur-xs z-40 transition-opacity"></div>

<script>
  import { sound } from '../utils/sound';

  const setupHeader = () => {
    // 1. Subtle tactile tap on all navigation links in the header
    document.querySelectorAll('header a, #mobile-menu a').forEach((link) => {
      const el = link as HTMLElement;
      if (!el.dataset.soundBound) {
        el.dataset.soundBound = 'true';
        el.addEventListener('click', (e) => {
          sound.tap(e as MouseEvent);
        });
      }
    });

    // 2. Mobile Menu Handling
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const backdrop = document.getElementById('mobile-backdrop');
    const burgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    if (!btn || !menu) return;

    const toggleMenu = (show?: boolean) => {
      const isHidden = typeof show === 'boolean' ? !show : !menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.add('hidden');
        if (backdrop) backdrop.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        if (burgerIcon) burgerIcon.classList.remove('hidden');
        if (closeIcon) closeIcon.classList.add('hidden');
        document.body.style.overflow = '';
      } else {
        menu.classList.remove('hidden');
        if (backdrop) backdrop.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        if (burgerIcon) burgerIcon.classList.add('hidden');
        if (closeIcon) closeIcon.classList.remove('hidden');
      }
    };

    if (!btn.dataset.soundBound) {
      btn.dataset.soundBound = 'true';
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        sound.tap(e as MouseEvent);
        toggleMenu();
      });
    }

    if (backdrop && !backdrop.dataset.soundBound) {
      backdrop.dataset.soundBound = 'true';
      backdrop.addEventListener('click', () => toggleMenu(false));
    }

    // Auto-close on click outside
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target as Node) && !btn.contains(e.target as Node)) {
        toggleMenu(false);
      }
    });

    if (new URLSearchParams(window.location.search).get('menu') === 'open') {
      toggleMenu(true);
    }
  };

  setupHeader();
  document.addEventListener('astro:after-swap', setupHeader);
</script>

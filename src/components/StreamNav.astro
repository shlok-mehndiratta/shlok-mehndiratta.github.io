---
interface SectionItem {
  id: string;
  label: string;
  caption?: string;
}

interface Props {
  sections: SectionItem[];
}

const { sections } = Astro.props;
---

{sections && sections.length > 0 && (
  <nav
    id="stream-nav"
    class="fixed left-[min(calc(100vw-3rem),calc(50vw+512px+2rem))] top-36 z-30 hidden lg:flex flex-col select-none pointer-events-auto transition-opacity duration-300"
    aria-label="Section stream progress"
  >
    <!-- Minimal Index Indicator -->
    <div class="flex items-center gap-1.5 text-[10px] font-mono tracking-widest uppercase mb-3 pl-0.5">
      <span class="w-1.5 h-1.5 rounded-full bg-zinc-950 dark:bg-zinc-100 dark:shadow-[0_0_6px_rgba(255,255,255,0.4)]"></span>
      <span class="hidden min-[1360px]:inline text-zinc-950 dark:text-zinc-100 font-bold">INDEX</span>
    </div>

    <!-- The Progress Spine & Waypoint Nodes -->
    <div class="relative flex flex-col gap-6 pl-0.5" id="stream-nodes-container">
      <!-- Background Track -->
      <div
        id="stream-bed-track"
        class="absolute w-[1.5px] bg-black/10 dark:bg-white/10 rounded-full pointer-events-none"
      ></div>

      <!-- Active Flow Current -->
      <div
        id="stream-flow-line"
        class="absolute w-[1.5px] bg-zinc-950 dark:bg-zinc-100 rounded-full pointer-events-none"
        style="height: 0px;"
      ></div>

      <!-- Flowing Indicator Bead -->
      <div
        id="stream-droplet"
        class="absolute w-2 h-2 rounded-full bg-zinc-950 dark:bg-zinc-100 pointer-events-none z-20"
        style="opacity: 0; transform: translateY(0px);"
      ></div>

      <!-- Confluence Waypoint Nodes -->
      {sections.map((section, idx) => (
        <a
          href={`#${section.id}`}
          data-stream-target={section.id}
          data-stream-index={idx}
          class="stream-node group relative flex items-center gap-3 text-left focus:outline-none"
        >
          <!-- Confluence Droplet Ring -->
          <div class="relative z-10 flex items-center justify-center w-3 h-3 rounded-full bg-surface-light dark:bg-surface-dark border border-black/20 dark:border-white/20 node-bullet">
            <span class="w-1 h-1 rounded-full bg-zinc-700 dark:bg-zinc-300 node-core"></span>
          </div>

          <!-- Section Label -->
          <div class="hidden min-[1360px]:flex flex-col">
            <span class="text-[11px] font-mono tracking-tight text-zinc-700 dark:text-zinc-300 font-medium node-label whitespace-nowrap">
              {section.label}
            </span>
            {section.caption && (
              <span class="text-[9px] font-mono text-zinc-500 dark:text-zinc-400 node-caption hidden">
                {section.caption}
              </span>
            )}
          </div>

          <!-- Compact Hover Tooltip (Inwardly positioned to avoid screen edge clipping) -->
          <div class="min-[1360px]:hidden absolute right-6 px-2 py-1 rounded-md bg-zinc-950 dark:bg-zinc-100 text-white dark:text-zinc-950 text-[10px] font-mono whitespace-nowrap shadow-md opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-30 font-medium">
            {section.label}
          </div>
        </a>
      ))}
    </div>
  </nav>
)}

<style>
  .stream-node {
    text-decoration: none;
    cursor: pointer;
  }
  .stream-node .node-bullet {
    transition: border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
  }
  .stream-node .node-core {
    transition: background-color 0.2s ease, transform 0.2s ease;
  }
  .stream-node .node-label {
    transition: color 0.2s ease, transform 0.2s ease;
  }

  /* Hover states */
  .stream-node:hover .node-bullet {
    border-color: rgb(2 6 23);
  }
  :global(.dark) .stream-node:hover .node-bullet {
    border-color: rgb(248 250 252);
  }
  .stream-node:hover .node-label {
    color: rgb(2 6 23);
  }
  :global(.dark) .stream-node:hover .node-label {
    color: rgb(248 250 252);
  }

  /* Active Waypoint Highlight */
  .stream-node.is-active .node-bullet {
    border-color: rgb(2 6 23) !important;
    background-color: rgb(2 6 23) !important;
    box-shadow: 0 0 0 3px rgba(2, 6, 23, 0.15) !important;
  }
  :global(.dark) .stream-node.is-active .node-bullet {
    border-color: rgb(255 255 255) !important;
    background-color: rgb(255 255 255) !important;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.4), 0 0 0 3px rgba(255, 255, 255, 0.15) !important;
  }

  .stream-node.is-active .node-core {
    background-color: rgb(255 255 255) !important;
    transform: scale(1.4) !important;
  }
  :global(.dark) .stream-node.is-active .node-core {
    background-color: rgb(0 0 0) !important;
  }

  .stream-node.is-active .node-label {
    color: rgb(2 6 23) !important;
    font-weight: 700 !important;
    transform: translateX(1px) !important;
  }
  :global(.dark) .stream-node.is-active .node-label {
    color: rgb(255 255 255) !important;
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.25);
  }

  /* Droplet Indicator */
  #stream-droplet {
    box-shadow: 0 0 4px rgba(0, 0, 0, 0.2);
    transition: transform 60ms cubic-bezier(0.1, 0.9, 0.2, 1), opacity 0.2s ease;
  }
  :global(.dark) #stream-droplet {
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.6);
  }

  #stream-flow-line {
    transition: height 60ms cubic-bezier(0.1, 0.9, 0.2, 1);
  }
</style>

<script is:inline>
  (function () {
    let cleanup = null;

    const setupStreamNav = () => {
      if (cleanup) {
        cleanup();
        cleanup = null;
      }

      const nav = document.getElementById('stream-nav');
      const container = document.getElementById('stream-nodes-container');
      const track = document.getElementById('stream-bed-track');
      const flowLine = document.getElementById('stream-flow-line');
      const droplet = document.getElementById('stream-droplet');

      if (!nav || !container) return;

      const nodeElements = Array.from(container.querySelectorAll('.stream-node'));
      if (!nodeElements.length) return;

      // Match nodes with their section elements in the document
      const sectionItems = [];
      nodeElements.forEach((node) => {
        const targetId = node.getAttribute('data-stream-target');
        const el = document.getElementById(targetId);
        if (el) {
          sectionItems.push({ id: targetId, el, node });
        }
      });

      if (!sectionItems.length) return;

      // Precise geometry calculation
      const measure = () => {
        const containerRect = container.getBoundingClientRect();
        const firstBullet = sectionItems[0].node.querySelector('.node-bullet');
        const lastBullet = sectionItems[sectionItems.length - 1].node.querySelector('.node-bullet');
        if (!firstBullet || !lastBullet) return null;

        const firstRect = firstBullet.getBoundingClientRect();
        const lastRect = lastBullet.getBoundingClientRect();

        const startX = (firstRect.left + firstRect.width / 2) - containerRect.left;
        const startY = (firstRect.top + firstRect.height / 2) - containerRect.top;
        const endY = (lastRect.top + lastRect.height / 2) - containerRect.top;
        const totalHeight = endY - startY;

        // Position background track precisely through bullet centers
        if (track) {
          track.style.left = `${startX - 0.75}px`;
          track.style.top = `${startY}px`;
          track.style.height = `${totalHeight}px`;
        }

        // Align flow line
        if (flowLine) {
          flowLine.style.left = `${startX - 0.75}px`;
          flowLine.style.top = `${startY}px`;
        }

        // Align droplet (8px diameter, offset by 4px to center)
        if (droplet) {
          droplet.style.left = `${startX - 4}px`;
          droplet.style.top = `${startY - 4}px`;
        }

        const waypointOffsets = sectionItems.map((item) => {
          const b = item.node.querySelector('.node-bullet');
          const r = b ? b.getBoundingClientRect() : item.node.getBoundingClientRect();
          return (r.top + r.height / 2) - containerRect.top - startY;
        });

        const headerOffset = 96;
        const sectionScrollPositions = sectionItems.map((item, idx) => {
          const rect = item.el.getBoundingClientRect();
          const docTop = rect.top + window.scrollY;
          return idx === 0 ? 0 : Math.max(0, docTop - headerOffset);
        });

        return { startY, endY, totalHeight, waypointOffsets, sectionScrollPositions };
      };

      let geo = measure();

      const onScroll = () => {
        if (!geo) {
          geo = measure();
          if (!geo) return;
        }

        const scrollY = window.scrollY || window.pageYOffset;
        const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const n = sectionItems.length;

        let activeIdx = 0;
        let flowHeight = 0;

        if (n === 1) {
          flowHeight = 0;
          activeIdx = 0;
        } else if (scrollY <= geo.sectionScrollPositions[0]) {
          flowHeight = 0;
          activeIdx = 0;
        } else if (scrollY >= maxScroll - 24 || scrollY >= geo.sectionScrollPositions[n - 1]) {
          flowHeight = geo.waypointOffsets[n - 1];
          activeIdx = n - 1;
        } else {
          for (let i = 0; i < n - 1; i++) {
            const sCur = geo.sectionScrollPositions[i];
            const sNext = geo.sectionScrollPositions[i + 1];
            if (scrollY >= sCur && scrollY < sNext) {
              const t = Math.max(0, Math.min(1, (scrollY - sCur) / (sNext - sCur || 1)));
              const wCur = geo.waypointOffsets[i];
              const wNext = geo.waypointOffsets[i + 1];
              flowHeight = wCur + t * (wNext - wCur);
              activeIdx = t >= 0.4 ? i + 1 : i;
              break;
            }
          }
        }

        if (flowLine) {
          flowLine.style.height = `${Math.max(0, Math.min(geo.totalHeight, flowHeight))}px`;
        }
        if (droplet) {
          droplet.style.transform = `translateY(${flowHeight}px)`;
          droplet.style.opacity = '1';
        }

        sectionItems.forEach((item, idx) => {
          item.node.classList.toggle('is-active', idx === activeIdx);
        });
      };

      // Click handling
      const clickHandlers = [];
      sectionItems.forEach((item, idx) => {
        const handler = (e) => {
          e.preventDefault();
          geo = measure();
          const targetY = geo ? geo.sectionScrollPositions[idx] : item.el.getBoundingClientRect().top + window.scrollY - 96;
          window.scrollTo({
            top: targetY,
            behavior: 'smooth',
          });
        };
        item.node.addEventListener('click', handler);
        clickHandlers.push({ node: item.node, handler });
      });

      const onResize = () => {
        geo = measure();
        onScroll();
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onResize);

      // Initial run
      onScroll();

      cleanup = () => {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onResize);
        clickHandlers.forEach(({ node, handler }) => node.removeEventListener('click', handler));
      };
    };

    const run = () => {
      setupStreamNav();
      setTimeout(setupStreamNav, 100);
      setTimeout(setupStreamNav, 500);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run);
    } else {
      run();
    }
    window.addEventListener('load', run);
    document.addEventListener('astro:page-load', run);
    document.addEventListener('astro:after-swap', run);
  })();
</script>

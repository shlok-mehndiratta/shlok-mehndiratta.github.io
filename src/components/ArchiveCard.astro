---
interface Props {
  item: {
    data: {
      title: string;
      date: Date;
      imageUrl: string;
      caption: string;
      location?: string;
      instrument?: string;
      category: 'lab' | 'geometry' | 'optics' | 'life';
      aspectRatio?: string;
    };
  };
}

const { item } = Astro.props;
const { title, date, imageUrl, caption, location, instrument, category, aspectRatio = '4/3' } = item.data;

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
}).format(date);
---

<div
  class="apple-card group relative overflow-hidden rounded-2xl border border-black/[0.06] dark:border-white/[0.08] bg-surface-light dark:bg-surface-dark p-2.5 sm:p-3 shadow-apple-card dark:shadow-apple-card-dark transition-all hover:border-black/15 dark:hover:border-white/20"
>
  <!-- Frame Header -->
  <div class="flex items-center justify-between text-[11px] font-mono text-zinc-400 dark:text-zinc-500 pb-2 px-1">
    <div class="flex items-center gap-1.5">
      <span class="tech-chip font-semibold uppercase tracking-wider text-[10px] px-2 py-0.5 rounded">{category}</span>
    </div>
    <div class="flex items-center gap-1.5 text-[10px]">
      {location && <span>{location}</span>}
      {location && <span>•</span>}
      <span>{formattedDate}</span>
    </div>
  </div>

  <!-- Image Container -->
  <div class="tactile-plate relative w-full overflow-hidden rounded-xl bg-zinc-100 dark:bg-zinc-800" style={`aspect-ratio: ${aspectRatio};`}>
    <img
      src={imageUrl}
      alt={title}
      loading="lazy"
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 filter grayscale contrast-105 group-hover:grayscale-0 group-hover:contrast-100"
    />
    <!-- Subtle hover overlay with caption -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-3.5 text-white">
      {instrument && (
        <span class="inline-block text-[10px] font-mono text-zinc-300 mb-1">
          {instrument}
        </span>
      )}
      <p class="text-xs line-clamp-3 text-zinc-200 leading-relaxed font-sans">{caption}</p>
    </div>
  </div>

  <!-- Bottom Details Bar -->
  <div class="pt-2 px-1 flex items-baseline justify-between text-xs">
    <h4 class="font-semibold text-zinc-950 dark:text-zinc-50 truncate text-xs">{title}</h4>
    {instrument && (
      <span class="text-[10px] font-mono text-zinc-400 dark:text-zinc-500 truncate ml-2">
        {instrument}
      </span>
    )}
  </div>
</div>

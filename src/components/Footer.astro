---
// Footer.astro
---

<footer class="mt-auto border-t border-black/[0.06] dark:border-white/[0.06] py-12 text-xs text-zinc-500 dark:text-zinc-400">
  <div class="max-w-5xl mx-auto px-4 sm:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
    <!-- Left: Identity & Affiliation -->
    <div class="space-y-1 text-center sm:text-left">
      <div class="flex items-center justify-center sm:justify-start gap-2 text-zinc-700 dark:text-zinc-300 font-medium">
        <span>Shlok Mehndiratta</span>
        <span>•</span>
        <span>IISER Bhopal</span>
      </div>
      <p class="text-zinc-500 dark:text-zinc-500 font-mono text-[11px]">
        Electrical Engineering & Computer Science
      </p>
    </div>

    <!-- Center: Live Local Time in Bhopal -->
    <div class="flex items-center gap-2 font-mono text-[11px] bg-zinc-100/70 dark:bg-zinc-800/40 px-2.5 py-1 rounded-full border border-zinc-200/60 dark:border-zinc-700/40">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
      <span>Bhopal, IN</span>
      <span class="text-zinc-400 dark:text-zinc-600">|</span>
      <span id="live-bhopal-time">--:--:-- IST</span>
    </div>

    <!-- Right: Academic & Contact Links -->
    <div class="flex flex-wrap items-center justify-center sm:justify-end gap-x-4 gap-y-1.5 text-xs font-mono">
      <a
        href="https://scholar.google.com"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-black dark:hover:text-white transition-colors"
      >
        Scholar
      </a>
      <a
        href="https://github.com/shlokmehndiratta"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-black dark:hover:text-white transition-colors"
      >
        GitHub
      </a>
      <a
        href="https://linkedin.com/in/shlokmehndiratta"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-black dark:hover:text-white transition-colors"
      >
        LinkedIn
      </a>
      <a
        href="mailto:shlok@iiserb.ac.in"
        class="hover:text-black dark:hover:text-white transition-colors"
        title="Institutional Email"
      >
        IISERB Mail
      </a>
      <a
        href="mailto:contact@shlokmehndiratta.me"
        class="hover:text-black dark:hover:text-white transition-colors"
        title="Personal Email"
      >
        Contact
      </a>
    </div>
  </div>

  <!-- Bottom Colophon -->
  <div class="max-w-5xl mx-auto px-4 sm:px-8 mt-8 pt-6 border-t border-black/[0.04] dark:border-white/[0.04] text-center text-[11px] font-mono text-zinc-400 dark:text-zinc-600">
    Typeset in Geist & JetBrains Mono • Designed for clarity & permanence • No cookies or third-party trackers
  </div>
</footer>

<script is:inline>
  const updateBhopalTime = () => {
    const el = document.getElementById('live-bhopal-time');
    if (!el) return;
    const now = new Date();
    const options = {
      timeZone: 'Asia/Kolkata',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    };
    el.textContent = `${new Intl.DateTimeFormat('en-GB', options).format(now)} IST`;
  };

  updateBhopalTime();
  setInterval(updateBhopalTime, 1000);
</script>

---
// Footer.astro
import ArchitecturalMonogram from './ArchitecturalMonogram.astro';
import SignatureMark from './SignatureMark.astro';
---

<footer class="mt-auto border-t border-black/[0.06] dark:border-white/[0.06] pt-8 pb-12 text-xs text-zinc-500 dark:text-zinc-400">
  <!-- Minimal Seamless Footer Contact Section (Unboxed, integrated) -->
  <div class="max-w-5xl mx-auto px-4 sm:px-8 pb-8 mb-8 border-b border-black/[0.06] dark:border-white/[0.06]">
    <form id="quick-contact-form" class="flex flex-col lg:flex-row lg:items-start justify-between gap-5 sm:gap-6">
      <!-- Left: Prompt / Identity -->
      <div class="space-y-1.5 shrink-0 max-w-xs">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-500 dark:shadow-[0_0_8px_rgba(16,185,129,0.7)] animate-pulse"></span>
          <span class="font-mono text-xs uppercase tracking-wider font-semibold text-zinc-900 dark:text-zinc-100">
            Get in touch
          </span>
        </div>
        <p class="text-xs text-zinc-600 dark:text-zinc-400 font-sans leading-relaxed">
          Open to research inquiries, lab collaborations, and technical discussions.
        </p>
      </div>

      <!-- Center / Right: Structured Responsive Inputs -->
      <div class="flex-1 max-w-xl w-full space-y-2.5">
        <div>
          <input
            type="email"
            id="contact-email"
            required
            placeholder="your.email@institution.edu"
            class="h-9 w-full sm:max-w-xs px-3 text-xs font-mono rounded-xl bg-black/[0.03] dark:bg-white/[0.05] border border-black/[0.08] dark:border-white/[0.08] text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 focus:outline-none focus:border-zinc-950 dark:focus:border-zinc-100 shadow-[inset_0_1px_2px_rgba(35,22,12,0.03)] dark:shadow-none transition-all"
          />
        </div>

        <div class="relative">
          <textarea
            id="contact-message"
            required
            rows="2"
            placeholder="Write a message, collaboration idea, or note..."
            class="w-full min-h-[58px] px-3.5 py-2 text-xs font-sans rounded-xl bg-black/[0.03] dark:bg-white/[0.05] border border-black/[0.08] dark:border-white/[0.08] text-zinc-900 dark:text-zinc-100 placeholder-zinc-400 dark:placeholder-zinc-500 focus:outline-none focus:border-zinc-950 dark:focus:border-zinc-100 shadow-[inset_0_1px_2px_rgba(35,22,12,0.03)] dark:shadow-none transition-all leading-relaxed resize-y"
          ></textarea>
        </div>

        <div class="flex flex-col-reverse sm:flex-row items-start sm:items-center justify-between gap-2 pt-0.5">
          <span class="text-[11px] font-mono text-zinc-400 dark:text-zinc-500">
            Opens pre-filled in your mail client or copies draft
          </span>
          <button
            type="submit"
            id="contact-submit-btn"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-4 py-2 rounded-xl bg-zinc-950 dark:bg-zinc-100 hover:bg-zinc-800 dark:hover:bg-zinc-200 text-zinc-50 dark:text-zinc-950 text-xs font-mono font-medium shadow-[0_2px_8px_rgba(31,22,15,0.18)] hover:shadow-[0_4px_12px_rgba(31,22,15,0.25)] dark:shadow-[0_0_12px_rgba(255,255,255,0.14)] transition-all shrink-0 cursor-pointer active:scale-[0.98]"
          >
            <span>Send Message</span>
            <span>&rarr;</span>
          </button>
        </div>
      </div>
    </form>
    <div id="contact-feedback" class="hidden text-[11px] font-mono text-emerald-600 dark:text-emerald-400 mt-2 text-right"></div>
  </div>

  <!-- Main Footer Content -->
  <div class="max-w-5xl mx-auto px-4 sm:px-8 flex flex-col md:flex-row items-center md:items-center justify-between gap-6">
    <!-- Left: Identity, Signature & Affiliation -->
    <div class="space-y-2 text-center md:text-left flex flex-col items-center md:items-start shrink-0">
      <SignatureMark class="h-7 w-auto text-zinc-700 dark:text-zinc-300 opacity-85 hover:opacity-100 transition-opacity" />
      <div class="space-y-0.5">
        <div class="flex items-center justify-center md:justify-start gap-2 text-zinc-800 dark:text-zinc-200 font-medium">
          <ArchitecturalMonogram size={15} class="text-zinc-400 dark:text-zinc-500" />
          <span>Shlok Mehndiratta</span>
          <span>•</span>
          <span>IISER Bhopal</span>
        </div>
        <p class="text-zinc-500 dark:text-zinc-400 font-mono text-[11px] whitespace-nowrap">
          Electrical Engineering & Computer Science
        </p>
      </div>
    </div>

    <!-- Center: Live Local Time in Bhopal (Stacked 2-line layout) -->
    <div class="flex flex-col items-center font-mono text-[11px] px-3.5 py-1.5 rounded-xl bg-black/[0.02] dark:bg-white/[0.03] border border-black/[0.05] dark:border-white/[0.06] shrink-0">
      <div class="flex items-center gap-1.5 whitespace-nowrap text-zinc-800 dark:text-zinc-200 font-medium">
        <span class="inline-block w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
        <span>Bhopal, India</span>
      </div>
      <span id="live-bhopal-time" class="whitespace-nowrap text-zinc-500 dark:text-zinc-400 text-[10px]">--:--:-- IST</span>
    </div>

    <!-- Right: Academic & Contact Links (Stacked on right side) -->
    <div class="flex flex-col items-center md:items-end gap-1.5 text-xs font-mono">
      <div class="flex flex-wrap items-center justify-center md:justify-end gap-x-4 gap-y-1">
        <a
          href="https://scholar.google.com/citations?hl=en&user=glDV-IAAAAAJ"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors"
        >
          Scholar
        </a>
        <a
          href="https://github.com/shlok-mehndiratta"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors"
        >
          GitHub
        </a>
        <a
          href="https://linkedin.com/in/shlok-mehndiratta"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors"
        >
          LinkedIn
        </a>
        <a
          href="https://x.com/ShlokMehndiratt"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors"
        >
          X (Twitter)
        </a>
      </div>
      <div class="flex items-center gap-2">
        <a
          href="mailto:shlokm23@iiserb.ac.in"
          class="text-zinc-600 dark:text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-50 transition-colors whitespace-nowrap"
          title="Institutional Email"
        >
          shlokm23@iiserb.ac.in
        </a>
        <button
          type="button"
          id="copy-email-btn"
          aria-label="Copy email address"
          class="p-1 rounded-md text-zinc-400 hover:text-zinc-950 dark:hover:text-zinc-50 hover:bg-black/[0.04] dark:hover:bg-white/[0.06] transition-colors cursor-pointer"
          title="Copy email to clipboard"
        >
          <svg class="w-3.5 h-3.5 copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg class="w-3.5 h-3.5 check-icon hidden text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Bottom Colophon / Copyright -->
  <div class="max-w-5xl mx-auto px-4 sm:px-8 mt-8 pt-5 border-t border-black/[0.06] dark:border-white/[0.06] flex flex-col sm:flex-row items-center justify-between gap-2 text-[11px] font-mono text-zinc-400 dark:text-zinc-500">
    <p>© {new Date().getFullYear()} Shlok Mehndiratta. All rights reserved.</p>
    <a href="#overview" class="hover:text-zinc-700 dark:hover:text-zinc-300 transition-colors flex items-center gap-1">
      <span>Back to top</span>
      <span>↑</span>
    </a>
  </div>
</footer>

<script is:inline>
  const updateBhopalTime = () => {
    const el = document.getElementById('live-bhopal-time');
    if (!el) return;
    const now = new Date();
    const options = {
      timeZone: 'Asia/Kolkata',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    };
    el.textContent = `${new Intl.DateTimeFormat('en-GB', options).format(now)} IST`;
  };

  updateBhopalTime();
  setInterval(updateBhopalTime, 1000);

  const setupQuickContact = () => {
    const form = document.getElementById('quick-contact-form');
    
    const handleCopy = (btn, text) => {
      if (!btn) return;
      navigator.clipboard.writeText(text).then(() => {
        const copySvg = btn.querySelector('.copy-icon');
        const checkSvg = btn.querySelector('.check-icon');
        if (copySvg && checkSvg) {
          copySvg.classList.add('hidden');
          checkSvg.classList.remove('hidden');
          setTimeout(() => {
            copySvg.classList.remove('hidden');
            checkSvg.classList.add('hidden');
          }, 2500);
        }
      });
    };

    const copyBtnFooter = document.getElementById('copy-email-btn');
    copyBtnFooter?.addEventListener('click', () => {
      handleCopy(copyBtnFooter, 'shlokm23@iiserb.ac.in');
    });

    if (!form) return;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = document.getElementById('contact-email')?.value.trim() || '';
      const message = document.getElementById('contact-message')?.value.trim() || '';
      const feedback = document.getElementById('contact-feedback');
      
      const subject = encodeURIComponent(`Inquiry from ${email} via shlokmehndiratta.me`);
      const body = encodeURIComponent(`From: ${email}\n\nMessage:\n${message}\n\n(Sent via portfolio quick-contact)`);
      window.location.href = `mailto:shlokm23@iiserb.ac.in?subject=${subject}&body=${body}`;
      
      if (feedback) {
        feedback.innerHTML = `
          <div class="flex items-center justify-end gap-2 flex-wrap text-emerald-600 dark:text-emerald-400">
            <span>✓ Opening email client...</span>
            <button type="button" id="copy-draft-btn" class="underline hover:text-emerald-700 dark:hover:text-emerald-300 font-medium cursor-pointer">
              Click to copy message draft
            </button>
          </div>
        `;
        feedback.classList.remove('hidden');
        
        const copyDraftBtn = document.getElementById('copy-draft-btn');
        copyDraftBtn?.addEventListener('click', () => {
          const draftText = `To: shlokm23@iiserb.ac.in\nSubject: Inquiry from ${email}\n\nMessage:\n${message}`;
          navigator.clipboard.writeText(draftText).then(() => {
            if (copyDraftBtn) copyDraftBtn.textContent = 'Draft copied to clipboard!';
          });
        });
      }
    });
  };

  setupQuickContact();
  document.addEventListener('astro:after-swap', () => {
    updateBhopalTime();
    setupQuickContact();
  });
</script>

---
// SignalVisualizer.astro - Subtle EECS ambient wave / Fourier harmonic canvas
---

<div class="relative w-full h-24 sm:h-28 overflow-hidden rounded-xl border border-black/[0.06] dark:border-white/[0.06] bg-zinc-50/50 dark:bg-zinc-900/30 my-6">
  <canvas id="signal-canvas" class="w-full h-full block"></canvas>
  <div class="absolute bottom-2 right-3 font-mono text-[10px] text-zinc-400 dark:text-zinc-600 select-none pointer-events-none flex items-center gap-1.5">
    <span class="inline-block w-1 h-1 rounded-full bg-sky-500 animate-pulse"></span>
    <span>f(t) = ∑ Aₖ sin(kωt + ϕ)</span>
  </div>
</div>

<script is:inline>
  const initSignalCanvas = () => {
    const canvas = document.getElementById('signal-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let animationFrameId = null;
    let mouse = { x: -1000, y: -1000, active: false };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
    };

    resize();
    window.addEventListener('resize', resize);

    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouse.x = e.clientX - rect.left;
      mouse.y = e.clientY - rect.top;
      mouse.active = true;
    });

    canvas.addEventListener('mouseleave', () => {
      mouse.active = false;
    });

    let phase = 0;

    const render = () => {
      if (!ctx || width === 0) return;
      ctx.clearRect(0, 0, width, height);

      const isDark = document.documentElement.classList.contains('dark');
      const baseColor = isDark ? '56, 189, 248' : '2, 132, 199'; // sky blue
      const secondaryColor = isDark ? '16, 185, 129' : '5, 150, 105'; // emerald

      phase += 0.015;

      // Draw subtle grid lines
      ctx.strokeStyle = isDark ? 'rgba(255, 255, 255, 0.03)' : 'rgba(0, 0, 0, 0.03)';
      ctx.lineWidth = 1;
      const step = 24;
      for (let x = 0; x < width; x += step) {
        ctx.beginPath();
        ctx.moveTo(x, 0);
        ctx.lineTo(x, height);
        ctx.stroke();
      }
      for (let y = 0; y < height; y += step) {
        ctx.beginPath();
        ctx.moveTo(0, y);
        ctx.lineTo(width, y);
        ctx.stroke();
      }

      // Draw 3 harmonics
      const harmonics = [
        { freq: 0.012, amp: height * 0.22, speed: 1.0, color: baseColor, alpha: 0.55 },
        { freq: 0.024, amp: height * 0.12, speed: -1.4, color: secondaryColor, alpha: 0.35 },
        { freq: 0.036, amp: height * 0.06, speed: 2.1, color: baseColor, alpha: 0.2 },
      ];

      harmonics.forEach((h) => {
        ctx.beginPath();
        ctx.strokeStyle = `rgba(${h.color}, ${h.alpha})`;
        ctx.lineWidth = 1.25;

        for (let x = 0; x <= width; x += 2) {
          // Calculate wave height
          let wave = Math.sin(x * h.freq + phase * h.speed) * h.amp;
          
          // Mouse proximity modulation
          if (mouse.active) {
            const dist = Math.abs(x - mouse.x);
            if (dist < 120) {
              const factor = (1 - dist / 120) * 16;
              wave += Math.cos(x * 0.08 + phase * 3) * factor;
            }
          }

          const y = height / 2 + wave;
          if (x === 0) {
            ctx.moveTo(x, y);
          } else {
            ctx.lineTo(x, y);
          }
        }
        ctx.stroke();
      });

      animationFrameId = requestAnimationFrame(render);
    };

    render();

    return () => {
      window.removeEventListener('resize', resize);
      if (animationFrameId) cancelAnimationFrame(animationFrameId);
    };
  };

  initSignalCanvas();
  document.addEventListener('astro:after-swap', initSignalCanvas);
</script>

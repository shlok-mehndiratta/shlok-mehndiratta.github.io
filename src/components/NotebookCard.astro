---
interface Props {
  entry: {
    slug: string;
    data: {
      title: string;
      publishedDate: Date;
      type: 'deep-dive' | 'heuristic' | 'paper-note' | 'bookshelf';
      readTime: string;
      summary: string;
      tags: string[];
    };
  };
}

const { entry } = Astro.props;
const { title, publishedDate, type, readTime, summary, tags } = entry.data;

const typeLabels = {
  'deep-dive': 'Deep Dive',
  'heuristic': 'Lab Heuristic',
  'paper-note': 'Paper Note',
  'bookshelf': 'Bookshelf',
};

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(publishedDate);
---

<a
  href={`/notebook/${entry.slug}`}
  class="dossier-panel reticle-corner group block pt-5 pb-6 px-4 -mx-4 rounded-xl hover:bg-black/[0.015] dark:hover:bg-white/[0.015] transition-all"
>
  <div class="flex flex-wrap items-center justify-between gap-2 mb-2 text-xs font-mono">
    <!-- Type Badge & Cadence -->
    <div class="flex items-center gap-1.5 text-zinc-400 dark:text-zinc-500">
      <span class="font-bold text-cyan-600 dark:text-cyan-400">
        [{typeLabels[type].toUpperCase()}]
      </span>
      <span class="tala-divider">|</span>
      <span>{readTime}</span>
    </div>

    <!-- Date -->
    <time class="text-zinc-400 dark:text-zinc-500 text-[11px]">
      {formattedDate}
    </time>
  </div>

  <!-- Title -->
  <h3 class="text-base sm:text-lg font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 group-hover:text-cyan-700 dark:group-hover:text-cyan-300 transition-colors mb-2 leading-snug">
    {title}
  </h3>

  <!-- Summary -->
  <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2 mb-3 leading-relaxed font-sans">
    {summary}
  </p>

  <!-- Tags -->
  {
    tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400">
            #{tag}
          </span>
        ))}
      </div>
    )
  }
</a>

---
interface Props {
  entry: {
    slug: string;
    data: {
      title: string;
      publishedDate: Date;
      type: 'workshop' | 'lab-story' | 'deep-dive' | 'experience' | 'reading' | 'essay' | 'thought' | 'book-summary' | 'paper-note' | 'bookshelf';
      readTime: string;
      summary: string;
      tags: string[];
      image?: string;
      imageAlt?: string;
    };
  };
}

const { entry } = Astro.props;
const { title, publishedDate, type, readTime, summary, tags, image, imageAlt } = entry.data;

const typeLabels: Record<string, string> = {
  'workshop': 'Workshop & Community',
  'lab-story': 'Hardware & Lab Story',
  'deep-dive': 'Engineering & Systems',
  'experience': 'Campus & Field Life',
  'reading': 'Reading & Reflection',
  'thought': 'Perspective & Note',
  'essay': 'Engineering & Systems',
  'book-summary': 'Reading & Reflection',
  'paper-note': 'Paper Reflection',
  'bookshelf': 'Bookshelf Note',
};

const categoryMap: Record<string, string> = {
  'workshop': 'workshops',
  'lab-story': 'lab-stories',
  'deep-dive': 'systems',
  'experience': 'experiences',
  'thought': 'experiences',
  'essay': 'systems',
  'reading': 'readings',
  'book-summary': 'readings',
  'paper-note': 'readings',
  'bookshelf': 'readings',
};

const filterCategory = categoryMap[type] || 'systems';

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(publishedDate);
---

<article
  data-notebook-item
  data-category={filterCategory}
  class="apple-card group relative p-5 sm:p-6 rounded-2xl bg-surface-light dark:bg-surface-dark border border-black/[0.07] dark:border-white/[0.08] shadow-apple-card dark:shadow-apple-card-dark hover:border-black/20 dark:hover:border-white/20 transition-all flex flex-col justify-between"
>
  <div class="space-y-3">
    <!-- Top Metadata Row -->
    <div class="flex items-center justify-between gap-2 text-xs font-mono border-b border-black/[0.05] dark:border-white/[0.06] pb-2">
      <span class="tech-chip inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono tracking-wide uppercase font-medium">
        {typeLabels[type]}
      </span>
      <div class="flex items-center gap-1.5 text-[11px] text-zinc-400 dark:text-zinc-500">
        <span>{readTime}</span>
        <span>•</span>
        <time>{formattedDate}</time>
      </div>
    </div>

    <!-- Optional Thumbnail Preview if image exists -->
    {image && (
      <a href={`/notebook/${entry.slug}`} class="tactile-plate block overflow-hidden rounded-xl bg-black/[0.02] dark:bg-white/[0.02] aspect-[16/9]">
        <img
          src={image}
          alt={imageAlt || title}
          class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-300"
          loading="lazy"
        />
      </a>
    )}

    <!-- Title (Primary Subject) -->
    <h3 class="text-base sm:text-lg font-bold tracking-tight text-zinc-950 dark:text-zinc-50 group-hover:text-zinc-700 dark:group-hover:text-zinc-300 transition-colors leading-snug">
      <a href={`/notebook/${entry.slug}`}>
        {title}
      </a>
    </h3>

    <!-- Conversational Summary -->
    <p class="text-xs sm:text-[13px] text-zinc-600 dark:text-zinc-400 line-clamp-2 leading-relaxed font-sans">
      {summary}
    </p>
  </div>

  <!-- Bottom Bar: Tags + Read Link -->
  <div class="pt-3 border-t border-black/[0.05] dark:border-white/[0.05] flex items-center justify-between gap-2 text-xs font-mono mt-3.5">
    <div class="flex flex-wrap gap-1">
      {tags && tags.slice(0, 3).map((tag) => (
        <span class="tech-chip text-[9px] sm:text-[10px] font-mono px-2 py-0.5 rounded-md">
          #{tag}
        </span>
      ))}
    </div>

    <a
      href={`/notebook/${entry.slug}`}
      class="tactile-btn inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-mono font-medium text-zinc-900 dark:text-zinc-100 shrink-0"
    >
      <span>Read &rarr;</span>
    </a>
  </div>
</article>

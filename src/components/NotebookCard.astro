---
interface Props {
  entry: {
    slug: string;
    data: {
      title: string;
      publishedDate: Date;
      type: 'deep-dive' | 'heuristic' | 'paper-note' | 'bookshelf';
      readTime: string;
      summary: string;
      tags: string[];
    };
  };
}

const { entry } = Astro.props;
const { title, publishedDate, type, readTime, summary, tags } = entry.data;

const typeLabels = {
  'deep-dive': 'Deep Dive',
  'heuristic': 'Heuristic',
  'paper-note': 'Paper Note',
  'bookshelf': 'Bookshelf',
};

const typeColors = {
  'deep-dive': 'text-sky-600 dark:text-sky-400 bg-sky-500/10 border-sky-500/20',
  'heuristic': 'text-amber-600 dark:text-amber-400 bg-amber-500/10 border-amber-500/20',
  'paper-note': 'text-purple-600 dark:text-purple-400 bg-purple-500/10 border-purple-500/20',
  'bookshelf': 'text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border-emerald-500/20',
};

const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
}).format(publishedDate);
---

<a
  href={`/notebook/${entry.slug}`}
  class="group block p-5 rounded-xl border border-black/[0.08] dark:border-white/[0.08] bg-surface-light dark:bg-surface-dark hover:border-black/[0.2] dark:hover:border-white/[0.2] transition-all duration-200"
>
  <div class="flex items-center justify-between gap-3 mb-2.5">
    <!-- Type Badge & Read Time -->
    <div class="flex items-center gap-2">
      <span class={`text-[11px] font-mono px-2 py-0.5 rounded-full border ${typeColors[type]}`}>
        {typeLabels[type]}
      </span>
      <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
        {readTime}
      </span>
    </div>

    <!-- Date -->
    <time class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
      {formattedDate}
    </time>
  </div>

  <!-- Title -->
  <h3 class="text-base sm:text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors mb-2">
    {title}
  </h3>

  <!-- Summary -->
  <p class="text-sm text-zinc-600 dark:text-zinc-400 line-clamp-2 mb-3 leading-relaxed">
    {summary}
  </p>

  <!-- Tags -->
  {
    tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-500 dark:text-zinc-400">
            #{tag}
          </span>
        ))}
      </div>
    )
  }
</a>

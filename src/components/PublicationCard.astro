---
interface Props {
  pub: {
    id: string;
    slug: string;
    data: {
      title: string;
      authors: string[];
      venue: string;
      year: number;
      status: 'published' | 'under-review' | 'preprint' | 'in-preparation';
      abstract: string;
      takeaway?: string;
      pdfUrl?: string;
      codeUrl?: string;
      projectUrl?: string;
      bibtex?: string;
      featured?: boolean;
      tags: string[];
    };
  };
}

const { pub } = Astro.props;
const { title, authors, venue, year, status, abstract, takeaway, pdfUrl, codeUrl, projectUrl, bibtex, tags } = pub.data;

const statusStyles = {
  'under-review': 'bg-zinc-100 dark:bg-zinc-800/70 text-zinc-700 dark:text-zinc-300 border-zinc-200/80 dark:border-zinc-700/60',
  'preprint': 'bg-zinc-100 dark:bg-zinc-800/70 text-zinc-700 dark:text-zinc-300 border-zinc-200/80 dark:border-zinc-700/60',
  'published': 'bg-zinc-100 dark:bg-zinc-800/90 text-zinc-900 dark:text-zinc-100 border-zinc-300 dark:border-zinc-600',
  'in-preparation': 'bg-zinc-100/60 dark:bg-zinc-800/40 text-zinc-500 dark:text-zinc-400 border-zinc-200/60 dark:border-zinc-800',
};

const statusDotColors = {
  'under-review': 'bg-amber-400/80',
  'preprint': 'bg-zinc-400',
  'published': 'bg-emerald-400/90',
  'in-preparation': 'bg-zinc-500',
};

const statusLabels = {
  'under-review': 'Under Review',
  'preprint': 'Preprint',
  'published': 'Published',
  'in-preparation': 'In Preparation',
};

const cardId = `pub-${pub.slug || Math.random().toString(36).substring(2, 9)}`;
---

<article
  class="apple-card apple-card-interactive group relative p-6 sm:p-7 rounded-2xl"
>
  <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-2.5">
    <!-- Status badge & Year -->
    <div class="flex items-center gap-2">
      <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 text-[11px] font-medium font-mono rounded-full border ${statusStyles[status]}`}>
        <span class={`w-1.5 h-1.5 rounded-full ${statusDotColors[status]}`}></span>
        <span>{statusLabels[status]}</span>
      </span>
      <span class="text-xs font-mono text-zinc-400 dark:text-zinc-500">
        {year}
      </span>
    </div>

    <!-- Tags -->
    {
      tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
              #{tag}
            </span>
          ))}
        </div>
      )
    }
  </div>

  <!-- Title -->
  <h3 class="text-base sm:text-lg font-semibold tracking-tight text-zinc-900 dark:text-zinc-100 mb-1.5 group-hover:text-black dark:group-hover:text-white transition-colors">
    {title}
  </h3>

  <!-- Authors -->
  <p class="text-sm text-zinc-600 dark:text-zinc-400 mb-1">
    {
      authors.map((author, index) => {
        const isSelf = author.toLowerCase().includes('shlok mehndiratta');
        return (
          <span>
            {isSelf ? (
              <span class="font-semibold text-zinc-900 dark:text-zinc-100 underline decoration-black/30 dark:decoration-white/40 underline-offset-2">
                {author}
              </span>
            ) : (
              author
            )}
            {index < authors.length - 1 && ', '}
          </span>
        );
      })
    }
  </p>

  <!-- Venue -->
  <p class="text-xs font-serif italic text-zinc-500 dark:text-zinc-400 mb-2.5">
    {venue}
  </p>

  <!-- Key Takeaway Pill -->
  {
    takeaway && (
      <div class="mb-3 px-3 py-1.5 rounded-lg bg-zinc-50 dark:bg-zinc-800/40 border border-black/[0.04] dark:border-white/[0.04] text-xs text-zinc-600 dark:text-zinc-300 flex items-start gap-2">
        <span class="text-zinc-400 font-mono text-[10px] uppercase tracking-wider font-semibold pt-0.5">Note:</span>
        <span class="italic">{takeaway}</span>
      </div>
    )
  }

  <!-- Actions & Toggles -->
  <div class="flex flex-wrap items-center gap-2 pt-2 border-t border-black/[0.04] dark:border-white/[0.04] text-xs font-mono">
    {
      pdfUrl && (
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 transition-colors"
        >
          <span>PDF</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
      )
    }

    {
      codeUrl && (
        <a
          href={codeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 transition-colors"
        >
          <span>Code</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
        </a>
      )
    }

    {
      projectUrl && (
        <a
          href={projectUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800/80 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 transition-colors"
        >
          <span>Project</span>
        </a>
      )
    }

    <!-- Abstract toggle -->
    {
      abstract && (
        <button
          type="button"
          data-abstract-toggle={cardId}
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded border border-zinc-200 dark:border-zinc-700/60 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 transition-colors"
        >
          <span>Abstract</span>
          <svg class="w-3 h-3 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
      )
    }

    <!-- BibTeX copy button -->
    {
      bibtex && (
        <button
          type="button"
          data-bibtex-copy={cardId}
          data-bibtex-content={bibtex}
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded border border-zinc-200 dark:border-zinc-700/60 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 transition-colors"
        >
          <span class="btn-label">BibTeX</span>
        </button>
      )
    }
  </div>

  <!-- Expandable Abstract Section -->
  {
    abstract && (
      <div id={`abstract-${cardId}`} class="hidden mt-3 pt-3 border-t border-black/[0.04] dark:border-white/[0.04] text-xs leading-relaxed text-zinc-600 dark:text-zinc-400">
        <p class="font-sans">{abstract}</p>
      </div>
    )
  }

  <!-- Expandable BibTeX Block -->
  {
    bibtex && (
      <div id={`bibtex-block-${cardId}`} class="hidden mt-3 pt-3 border-t border-black/[0.04] dark:border-white/[0.04]">
        <pre class="p-3 bg-zinc-900 text-zinc-200 rounded text-[11px] font-mono overflow-x-auto leading-normal">{bibtex}</pre>
      </div>
    )
  }
</article>

<script is:inline>
  const setupPubCards = () => {
    document.querySelectorAll('[data-abstract-toggle]').forEach((btn) => {
      btn.onclick = () => {
        const id = btn.getAttribute('data-abstract-toggle');
        const content = document.getElementById(`abstract-${id}`);
        const icon = btn.querySelector('svg');
        if (content) {
          content.classList.toggle('hidden');
          if (icon) icon.classList.toggle('rotate-180');
        }
      };
    });

    document.querySelectorAll('[data-bibtex-copy]').forEach((btn) => {
      btn.onclick = async () => {
        const id = btn.getAttribute('data-bibtex-copy');
        const content = btn.getAttribute('data-bibtex-content');
        const block = document.getElementById(`bibtex-block-${id}`);
        const label = btn.querySelector('.btn-label');

        if (block) {
          block.classList.toggle('hidden');
        }

        if (content) {
          try {
            await navigator.clipboard.writeText(content);
            if (label) {
              const original = label.textContent;
              label.textContent = 'Copied! ✓';
              setTimeout(() => {
                label.textContent = original;
              }, 2000);
            }
          } catch (e) {
            console.error('Failed to copy', e);
          }
        }
      };
    });
  };

  setupPubCards();
  document.addEventListener('astro:after-swap', setupPubCards);
</script>

---
interface Props {
  pub: {
    id: string;
    slug: string;
    data: {
      title: string;
      authors: string[];
      venue: string;
      year: number;
      status: 'published' | 'under-review' | 'preprint' | 'in-preparation';
      abstract: string;
      takeaway?: string;
      pdfUrl?: string;
      codeUrl?: string;
      projectUrl?: string;
      bibtex?: string;
      featured?: boolean;
      tags: string[];
    };
  };
}

const { pub } = Astro.props;
const { title, authors, venue, year, status, abstract, takeaway, pdfUrl, codeUrl, projectUrl, bibtex, tags } = pub.data;

const statusDotColors = {
  'under-review': 'bg-cyan-500 animate-pulse',
  'preprint': 'bg-zinc-400',
  'published': 'bg-emerald-500',
  'in-preparation': 'bg-zinc-500',
};

const statusLabels = {
  'under-review': 'Under Review // ICRA \'27',
  'preprint': 'Preprint Archive',
  'published': 'Published',
  'in-preparation': 'In Preparation',
};

// Subtle identifier tag based on title
const pubIndex = title.toLowerCase().includes('equi-partitioning') ? 'PUB.01' : 'PUB.02';
const targetVenue = title.toLowerCase().includes('equi-partitioning') ? 'ICRA 2027' : 'ACODS 2026';
const cardId = `pub-${pub.slug || Math.random().toString(36).substring(2, 9)}`;
---

<article
  class="dossier-panel reticle-corner group relative pt-6 pb-7 px-4 -mx-4 rounded-xl hover:bg-black/[0.015] dark:hover:bg-white/[0.015] transition-all"
>
  <!-- Dossier Meta Header -->
  <div class="flex flex-wrap items-center justify-between gap-y-2 gap-x-3 mb-2.5">
    <div class="flex items-center flex-wrap gap-1 text-[11px] font-mono">
      <span class="font-bold text-cyan-600 dark:text-cyan-400 tracking-wider">
        [{pubIndex}]
      </span>
      <span class="tala-divider">||</span>
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded text-[10px] font-medium bg-cyan-500/10 dark:bg-cyan-400/10 text-cyan-700 dark:text-cyan-300 border border-cyan-500/20 dark:border-cyan-400/20">
        <span class={`w-1.5 h-1.5 rounded-full ${statusDotColors[status]}`}></span>
        <span>{status === 'under-review' ? `Under Review • ${targetVenue}` : statusLabels[status]}</span>
      </span>
      <span class="tala-divider">|</span>
      <span class="text-zinc-400 dark:text-zinc-500">
        {year} • IISER BHOPAL
      </span>
    </div>

    <!-- Tags as clean monospace chips -->
    {
      tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-zinc-100 dark:bg-zinc-800/60 text-zinc-500 dark:text-zinc-400">
              #{tag}
            </span>
          ))}
        </div>
      )
    }
  </div>

  <!-- Manuscript Title -->
  <h3 class="text-base sm:text-lg font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 mb-1.5 group-hover:text-cyan-700 dark:group-hover:text-cyan-300 transition-colors leading-snug">
    {title}
  </h3>

  <!-- Authors list with clean editorial tone -->
  <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mb-1.5">
    {
      authors.map((author, index) => {
        const isSelf = author.toLowerCase().includes('shlok mehndiratta');
        return (
          <span>
            {isSelf ? (
              <span class="font-semibold text-zinc-950 dark:text-zinc-100 underline decoration-cyan-500/50 underline-offset-2">
                {author}
              </span>
            ) : (
              author
            )}
            {index < authors.length - 1 && ', '}
          </span>
        );
      })
    }
  </p>

  <!-- Venue & Testbed Telemetry -->
  <p class="text-xs font-serif italic text-zinc-500 dark:text-zinc-400 mb-3">
    {venue}
  </p>

  <!-- Key Technical Finding / Takeaway (Open editorial callout with vertical bar) -->
  {
    takeaway && (
      <div class="mb-4 pl-3.5 border-l-2 border-cyan-500/50 dark:border-cyan-400/50 py-0.5 text-xs text-zinc-700 dark:text-zinc-300 leading-relaxed font-sans">
        <span class="font-mono text-[10px] uppercase tracking-wider text-cyan-700 dark:text-cyan-300 font-semibold mr-1.5">Key Finding:</span>
        <span>{takeaway}</span>
      </div>
    )
  }

  <!-- Precision Action Triggers -->
  <div class="flex flex-wrap items-center gap-2 pt-2.5 border-t border-black/[0.05] dark:border-white/[0.05] text-xs font-mono">
    {
      pdfUrl && (
        <a
          href={pdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 transition-colors text-[11px]"
        >
          <span>PDF</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
      )
    }

    {
      codeUrl && (
        <a
          href={codeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 transition-colors text-[11px]"
        >
          <span>Code</span>
          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
        </a>
      )
    }

    {
      projectUrl && (
        <a
          href={projectUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-zinc-100 dark:bg-zinc-800 hover:bg-zinc-200 dark:hover:bg-zinc-700 text-zinc-800 dark:text-zinc-200 transition-colors text-[11px]"
        >
          <span>Dossier</span>
        </a>
      )
    }

    <!-- Abstract toggle -->
    {
      abstract && (
        <button
          type="button"
          data-abstract-toggle={cardId}
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded border border-zinc-200 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 transition-colors text-[11px]"
        >
          <span>Abstract</span>
          <svg class="w-3 h-3 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </button>
      )
    }

    <!-- BibTeX copy button -->
    {
      bibtex && (
        <button
          type="button"
          data-bibtex-copy={cardId}
          data-bibtex-content={bibtex}
          class="inline-flex items-center gap-1 px-2.5 py-1 rounded border border-zinc-200 dark:border-zinc-700 hover:bg-zinc-100 dark:hover:bg-zinc-800 text-zinc-700 dark:text-zinc-300 transition-colors text-[11px]"
        >
          <span class="btn-label">BibTeX</span>
        </button>
      )
    }
  </div>

  <!-- Expandable Abstract Section -->
  {
    abstract && (
      <div id={`abstract-${cardId}`} class="hidden mt-3.5 pt-3 border-t border-black/[0.05] dark:border-white/[0.05] text-xs leading-relaxed text-zinc-600 dark:text-zinc-400 bg-zinc-50/60 dark:bg-zinc-900/40 p-4 rounded-lg">
        <p class="font-sans">{abstract}</p>
      </div>
    )
  }

  <!-- Expandable BibTeX Block -->
  {
    bibtex && (
      <div id={`bibtex-block-${cardId}`} class="hidden mt-3.5 pt-3 border-t border-black/[0.05] dark:border-white/[0.05]">
        <pre class="p-3 bg-zinc-900 text-zinc-200 rounded text-[11px] font-mono overflow-x-auto leading-normal">{bibtex}</pre>
      </div>
    )
  }
</article>

<script is:inline>
  const setupPubCards = () => {
    document.querySelectorAll('[data-abstract-toggle]').forEach((btn) => {
      btn.onclick = () => {
        const id = btn.getAttribute('data-abstract-toggle');
        const content = document.getElementById(`abstract-${id}`);
        const icon = btn.querySelector('svg');
        if (content) {
          content.classList.toggle('hidden');
          if (icon) icon.classList.toggle('rotate-180');
        }
      };
    });

    document.querySelectorAll('[data-bibtex-copy]').forEach((btn) => {
      btn.onclick = async () => {
        const id = btn.getAttribute('data-bibtex-copy');
        const content = btn.getAttribute('data-bibtex-content');
        const block = document.getElementById(`bibtex-block-${id}`);
        const label = btn.querySelector('.btn-label');

        if (block) {
          block.classList.toggle('hidden');
        }

        if (content) {
          try {
            await navigator.clipboard.writeText(content);
            if (label) {
              const original = label.textContent;
              label.textContent = 'Copied! ✓';
              setTimeout(() => {
                label.textContent = original;
              }, 2000);
            }
          } catch (e) {
            console.error('Failed to copy', e);
          }
        }
      };
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPubCards);
  } else {
    setupPubCards();
  }
  document.addEventListener('astro:after-swap', setupPubCards);
</script>

---
interface Props {
  pub: {
    id: string;
    slug: string;
    data: {
      title: string;
      authors: string[];
      venue: string;
      year: number;
      status: 'accepted' | 'published' | 'under-review' | 'preprint' | 'in-preparation';
      abstract: string;
      takeaway?: string;
      pdfUrl?: string;
      codeUrl?: string;
      projectUrl?: string;
      bibtex?: string;
      featured?: boolean;
      tags: string[];
    };
  };
}

const { pub } = Astro.props;
const { title, authors, venue, year, status, abstract, takeaway, pdfUrl, codeUrl, projectUrl, bibtex, tags } = pub.data;

const statusDotColors = {
  'accepted': 'bg-emerald-500',
  'under-review': 'bg-sky-500',
  'preprint': 'bg-zinc-400',
  'published': 'bg-emerald-500',
  'in-preparation': 'bg-zinc-500',
};

const statusLabels = {
  'accepted': 'Accepted • ACODS 2026 (Presenting Dec 2026)',
  'under-review': 'Under Review • ICRA 2027',
  'preprint': 'Preprint Archive',
  'published': 'Published',
  'in-preparation': 'In Preparation',
};

const cardId = `pub-${pub.slug || Math.random().toString(36).substring(2, 9)}`;
---

<article
  class="apple-card group relative p-5 sm:p-6 rounded-2xl bg-surface-light dark:bg-surface-dark border border-black/[0.06] dark:border-white/[0.08] shadow-apple-card dark:shadow-apple-card-dark transition-all hover:border-black/15 dark:hover:border-white/20"
>
  <!-- Publication Status & Academic Metadata Header -->
  <div class="flex flex-wrap items-center justify-between gap-y-2 gap-x-3 mb-3">
    <div class="flex items-center flex-wrap gap-2 text-[11px]">
      <span
        class={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-[11px] font-medium border ${
          status === 'accepted' || status === 'published'
            ? 'bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 border-emerald-500/20'
            : 'bg-black/[0.03] dark:bg-white/[0.05] text-zinc-800 dark:text-zinc-200 border-black/[0.06] dark:border-white/[0.08]'
        }`}
      >
        <span class={`w-1.5 h-1.5 rounded-full ${statusDotColors[status]}`}></span>
        <span>{statusLabels[status]}</span>
      </span>
      <span class="text-zinc-400 dark:text-zinc-500 text-xs font-mono">
        • {year} • IISER Bhopal
      </span>
    </div>
  </div>

  <!-- Manuscript Title -->
  <h3 class="text-base sm:text-lg font-semibold tracking-tight text-zinc-950 dark:text-zinc-50 mb-1.5 group-hover:text-zinc-900 dark:group-hover:text-zinc-100 transition-colors leading-snug">
    {title}
  </h3>

  <!-- Authors list with clean editorial tone -->
  <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mb-1.5">
    {
      authors.map((author, index) => {
        const isSelf = author.toLowerCase().includes('shlok mehndiratta');
        return (
          <span>
            {isSelf ? (
              <span class="font-semibold text-zinc-950 dark:text-zinc-100 underline decoration-zinc-400 underline-offset-2">
                {author}
              </span>
            ) : (
              author
            )}
            {index < authors.length - 1 && ', '}
          </span>
        );
      })
    }
  </p>

  <!-- Venue Name -->
  <p class="text-xs font-serif italic text-zinc-500 dark:text-zinc-400 mb-3">
    {venue}
  </p>

  <!-- Key Finding / Takeaway -->
  {
    takeaway && (
      <div class="tactile-plate mb-4 pl-3.5 border-l-2 border-l-zinc-950 dark:border-l-zinc-100 py-1.5 px-3 text-xs sm:text-sm text-zinc-800 dark:text-zinc-200 leading-relaxed font-sans bg-surfaceSubtle-light/35 dark:bg-white/[0.04] rounded-r-lg">
        <span class="font-mono text-[10px] uppercase tracking-wider text-zinc-950 dark:text-zinc-50 font-bold mr-1.5">Key Finding:</span>
        <span>{takeaway}</span>
      </div>
    )
  }

  <!-- Footer Row: Action Triggers (Left) & Reordered Tags (Right) -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3.5 border-t border-black/[0.05] dark:border-white/[0.05] text-xs font-mono">
    <!-- Action Triggers -->
    <div class="flex flex-wrap items-center gap-2">
      {
        abstract && (
          <button
            type="button"
            data-abstract-toggle={cardId}
            class="tactile-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-zinc-800 dark:text-zinc-200 text-xs font-medium cursor-pointer"
          >
            <span>Abstract</span>
            <svg class="w-3.5 h-3.5 transform transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
        )
      }

      {
        pdfUrl && (
          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="tactile-btn inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-zinc-800 dark:text-zinc-200 text-[11px]"
          >
            <span>PDF</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        )
      }

      {
        codeUrl && (
          <a
            href={codeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="tactile-btn inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-zinc-800 dark:text-zinc-200 text-[11px]"
          >
            <span>Code</span>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path></svg>
          </a>
        )
      }

      {
        bibtex && bibtex.trim() !== '' && (
          <button
            type="button"
            data-bibtex-copy={cardId}
            data-bibtex-content={bibtex}
            class="tactile-btn inline-flex items-center gap-1 px-2.5 py-1.5 rounded-lg text-zinc-800 dark:text-zinc-200 text-[11px] cursor-pointer"
          >
            <span class="btn-label">BibTeX</span>
          </button>
        )
      }
    </div>

    <!-- Reordered Tags at bottom right -->
    {
      tags && tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {tags.map((tag) => (
            <span class="tech-chip text-[10px] font-mono px-2 py-0.5 rounded">
              {tag}
            </span>
          ))}
        </div>
      )
    }
  </div>

  <!-- Expandable Abstract Section -->
  {
    abstract && (
      <div id={`abstract-${cardId}`} class="hidden mt-3.5 pt-3 border-t border-black/[0.05] dark:border-white/[0.05] text-xs sm:text-sm leading-relaxed text-zinc-600 dark:text-zinc-300 bg-black/[0.02] dark:bg-white/[0.03] p-4 rounded-xl border border-black/[0.04] dark:border-white/[0.05]">
        <p class="font-sans leading-relaxed">{abstract}</p>
      </div>
    )
  }

  <!-- Expandable BibTeX Block -->
  {
    bibtex && bibtex.trim() !== '' && (
      <div id={`bibtex-block-${cardId}`} class="hidden mt-3.5 pt-3 border-t border-black/[0.05] dark:border-white/[0.05]">
        <pre class="p-3 bg-black/90 dark:bg-black/90 text-zinc-200 border border-black/10 dark:border-white/10 rounded-lg text-[11px] font-mono overflow-x-auto leading-normal">{bibtex}</pre>
      </div>
    )
  }
</article>

<script>
  import { sound } from '../utils/sound';

  (function () {
    if ((window as unknown as { __pubCardsListenerAttached?: boolean }).__pubCardsListenerAttached) return;
    (window as unknown as { __pubCardsListenerAttached?: boolean }).__pubCardsListenerAttached = true;

    document.addEventListener('click', function (e) {
      const target = e.target as HTMLElement | null;
      if (!target) return;

      // 1. Abstract Toggle: Fluid Pop + Specular Light Glint
      const abstractBtn = target.closest('[data-abstract-toggle]');
      if (abstractBtn) {
        sound.pop();
        const card = abstractBtn.closest('article');
        if (card) {
          card.classList.add('border-black/30', 'dark:border-white/35', 'shadow-specular');
          setTimeout(() => {
            card.classList.remove('border-black/30', 'dark:border-white/35');
          }, 220);
        }

        const id = abstractBtn.getAttribute('data-abstract-toggle');
        if (id) {
          const content = document.getElementById('abstract-' + id);
          const icon = abstractBtn.querySelector('svg');
          if (content) {
            content.classList.toggle('hidden');
            if (icon) {
              icon.classList.toggle('rotate-180');
            }
          }
        }
        return;
      }

      // 2. BibTeX Copy: Harmonic Chime
      const bibtexBtn = target.closest('[data-bibtex-copy]');
      if (bibtexBtn) {
        sound.chime();
        const content = bibtexBtn.getAttribute('data-bibtex-content');
        const label = bibtexBtn.querySelector('.btn-label');
        if (content && label) {
          navigator.clipboard.writeText(content).then(() => {
            const originalText = label.textContent;
            label.textContent = 'Copied! ✓';
            setTimeout(() => {
              label.textContent = originalText;
            }, 2000);
          }).catch((err) => {
            console.error('Failed to copy BibTeX:', err);
          });
        }
        return;
      }

      // 3. Tactile external links (PDF / Code)
      const extLink = target.closest('a[target="_blank"]');
      if (extLink && extLink.closest('.apple-card')) {
        sound.tap(e as MouseEvent);
      }
    });
  })();
</script>
